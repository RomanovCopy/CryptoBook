        <Setter Property="Background"
                Value="{DynamicResource CurrentInputBackground}"/>
        <Setter Property="CaretBrush"
                Value="{DynamicResource CurrentInputForeground}"/>
        <Setter Property="SelectionBrush"
                Value="{DynamicResource CurrentSelectionBackground}"/>
        <Setter Property="SelectionTextBrush"
                Value="{DynamicResource CurrentSelectionForeground}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource CurrentBorderColor}"/>
        <Setter Property="Padding" Value="5,3"/>
    </Style>

    <Style TargetType="{x:Type RichTextBox}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource CurrentWindowForeground}"/>
        <Setter Property="Background" Value="{DynamicResource CurrentDocumentBackground}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource CurrentWindowForeground}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource CurrentSelectionBackground}"/>
        <Setter Property="SelectionTextBrush" Value="{DynamicResource CurrentSelectionForeground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CurrentBorderColor}"/>
    </Style>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
