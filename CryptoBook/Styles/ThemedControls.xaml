<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type Window}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background"
                Value="{DynamicResource CurrentWindowBackground}"/>
        <Setter Property="Foreground"
                Value="{DynamicResource CurrentWindowForeground}"/>
        <!-- Все окна используют тот же канонический значок, что и EXE. -->
        <Setter Property="Icon"
                Value="{DynamicResource ApplicationWindowIcon}"/>
    </Style>

    <!-- Popup создаёт отдельное визуальное дерево, поэтому цвет текста
         задаётся и для текстовых элементов, а не только для Window. -->
    <Style TargetType="{x:Type Page}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="{DynamicResource CurrentWindowBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource CurrentWindowForeground}"/>
    </Style>

    <Style TargetType="{x:Type UserControl}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="{DynamicResource CurrentWindowBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource CurrentWindowForeground}"/>
    </Style>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground"
                Value="{DynamicResource CurrentWindowForeground}"/>
    </Style>

    <Style TargetType="{x:Type Label}">
        <Setter Property="Foreground"
                Value="{DynamicResource CurrentWindowForeground}"/>
    </Style>

    <Style TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground"
                Value="{DynamicResource CurrentInputForeground}"/>
        <Setter Property="Background"
                Value="{DynamicResource CurrentControlBackground}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource CurrentBorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource CurrentControlHoverBackground}"/>
                            <Setter TargetName="Root"
                                    Property="BorderBrush"
                                    Value="{DynamicResource CurrentAccent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource CurrentSelectionBackground}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource CurrentSelectionForeground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource CurrentDisabledForeground}"/>
                            <Setter Property="Opacity" Value="0.72"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground"
                Value="{DynamicResource CurrentInputForeground}"/>
        <Setter Property="Background"
                Value="{DynamicResource CurrentInputBackground}"/>
        <Setter Property="CaretBrush"
                Value="{DynamicResource CurrentInputForeground}"/>
        <Setter Property="SelectionBrush"
                Value="{DynamicResource CurrentSelectionBackground}"/>
        <Setter Property="SelectionTextBrush"
                Value="{DynamicResource CurrentSelectionForeground}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource CurrentBorderColor}"/>
        <Setter Property="Padding" Value="5,3"/>
    </Style>

    <Style TargetType="{x:Type PasswordBox}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground"
                Value="{DynamicResource CurrentInputForeground}"/>
        <Setter Property="Background"
                Value="{DynamicResource CurrentInputBackground}"/>
        <Setter Property="CaretBrush"
                Value="{DynamicResource CurrentInputForeground}"/>
        <Setter Property="SelectionBrush"
                Value="{DynamicResource CurrentSelectionBackground}"/>
        <Setter Property="SelectionTextBrush"
                Value="{DynamicResource CurrentSelectionForeground}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource CurrentBorderColor}"/>
        <Setter Property="Padding" Value="5,3"/>
    </Style>

    <Style TargetType="{x:Type RichTextBox}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource CurrentWindowForeground}"/>
        <Setter Property="Background" Value="{DynamicResource CurrentDocumentBackground}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource CurrentWindowForeground}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource CurrentSelectionBackground}"/>
        <Setter Property="SelectionTextBrush" Value="{DynamicResource CurrentSelectionForeground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CurrentBorderColor}"/>
    </Style>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground"
                Value="{DynamicResource CurrentInputForeground}"/>
        <Setter Property="Background"
                Value="{DynamicResource CurrentInputBackground}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource CurrentBorderColor}"/>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground"
                Value="{DynamicResource CurrentInputForeground}"/>
        <Setter Property="Background"
                Value="{DynamicResource CurrentInputBackground}"/>
        <Setter Property="Padding" Value="6,4"/>
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground"
                        Value="{DynamicResource CurrentSelectionForeground}"/>
                <Setter Property="Background"
                        Value="{DynamicResource CurrentSelectionBackground}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground"
                        Value="{DynamicResource CurrentSelectionForeground}"/>
                <Setter Property="Background"
                        Value="{DynamicResource CurrentSelectionBackground}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground"
                        Value="{DynamicResource CurrentDisabledForeground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ToggleButton}">
        <Setter Property="Foreground" Value="{DynamicResource CurrentInputForeground}"/>
        <Setter Property="Background" Value="{DynamicResource CurrentControlBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CurrentBorderColor}"/>
    </Style>

    <Style TargetType="{x:Type ListBox}">
        <Setter Property="Foreground"
                Value="{DynamicResource CurrentInputForeground}"/>
        <Setter Property="Background"
                Value="{DynamicResource CurrentInputBackground}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource CurrentBorderColor}"/>
    </Style>

    <Style TargetType="{x:Type ListView}">
        <Setter Property="Foreground"
                Value="{DynamicResource CurrentInputForeground}"/>
        <Setter Property="Background"
                Value="{DynamicResource CurrentInputBackground}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource CurrentBorderColor}"/>
    </Style>

    <Style TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource CurrentInputForeground}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CurrentControlHoverBackground}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource CurrentSelectionForeground}"/>
                <Setter Property="Background" Value="{DynamicResource CurrentSelectionBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CurrentBorderColor}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ListViewItem}">
        <Setter Property="Foreground" Value="{DynamicResource CurrentInputForeground}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CurrentControlHoverBackground}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource CurrentSelectionForeground}"/>
                <Setter Property="Background" Value="{DynamicResource CurrentSelectionBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CurrentBorderColor}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TreeView}">
        <Setter Property="Foreground"
                Value="{DynamicResource CurrentInputForeground}"/>
        <Setter Property="Background"
                Value="{DynamicResource CurrentInputBackground}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource CurrentBorderColor}"/>
    </Style>

    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground"
                Value="{DynamicResource CurrentWindowForeground}"/>
        <Setter Property="Background"
                Value="{DynamicResource CurrentInputBackground}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource CurrentBorderColor}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid MinHeight="20"
                          Background="Transparent"
                          SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Box"
                                Width="17"
                                Height="17"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"/>

                        <Path x:Name="CheckMark"
                              Grid.Column="0"
                              Width="10"
                              Height="8"
                              Margin="3,0,0,1"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Data="M 0,4 L 3.5,7.5 L 10,0"
                              Stroke="{DynamicResource CurrentWindowBackground}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Visibility="Collapsed"/>

                        <Rectangle x:Name="IndeterminateMark"
                                   Grid.Column="0"
                                   Width="9"
                                   Height="2"
                                   Margin="4,0,0,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Fill="{DynamicResource CurrentWindowBackground}"
                                   RadiusX="1"
                                   RadiusY="1"
                                   Visibility="Collapsed"/>

                        <ContentPresenter Grid.Column="1"
                                          Margin="7,0,0,0"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          Content="{TemplateBinding Content}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box"
                                    Property="BorderBrush"
                                    Value="{DynamicResource CurrentAccent}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box"
                                    Property="Background"
                                    Value="{DynamicResource CurrentAccent}"/>
                            <Setter TargetName="Box"
                                    Property="BorderBrush"
                                    Value="{DynamicResource CurrentAccent}"/>
                            <Setter TargetName="CheckMark"
                                    Property="Visibility"
                                    Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box"
                                    Property="Background"
                                    Value="{DynamicResource CurrentAccent}"/>
                            <Setter TargetName="Box"
                                    Property="BorderBrush"
                                    Value="{DynamicResource CurrentAccent}"/>
                            <Setter TargetName="IndeterminateMark"
                                    Property="Visibility"
                                    Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box"
                                    Property="Background"
                                    Value="{DynamicResource CurrentSelectionBackground}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box"
                                    Property="BorderBrush"
                                    Value="{DynamicResource CurrentAccent}"/>
                            <Setter TargetName="Box"
                                    Property="BorderThickness"
                                    Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource CurrentDisabledForeground}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                            <Setter TargetName="Box"
                                    Property="Background"
                                    Value="{DynamicResource CurrentControlBackground}"/>
                            <Setter TargetName="Box"
                                    Property="BorderBrush"
                                    Value="{DynamicResource CurrentBorderColor}"/>
                            <Setter TargetName="CheckMark"
                                    Property="Stroke"
                                    Value="{DynamicResource CurrentDisabledForeground}"/>
                            <Setter TargetName="IndeterminateMark"
                                    Property="Fill"
                                    Value="{DynamicResource CurrentDisabledForeground}"/>
                            <Setter Property="Opacity" Value="0.72"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground"
                Value="{DynamicResource CurrentWindowForeground}"/>
        <Setter Property="Background"
                Value="{DynamicResource CurrentWindowBackground}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource CurrentBorderColor}"/>
    </Style>

    <Style TargetType="{x:Type GroupBox}">
        <Setter Property="Foreground" Value="{DynamicResource CurrentWindowForeground}"/>
        <Setter Property="Background" Value="{DynamicResource CurrentWindowBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CurrentBorderColor}"/>
    </Style>

    <Style TargetType="{x:Type Expander}">
        <Setter Property="Foreground" Value="{DynamicResource CurrentWindowForeground}"/>
        <Setter Property="Background" Value="{DynamicResource CurrentWindowBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CurrentBorderColor}"/>
    </Style>

    <Style TargetType="{x:Type TabControl}">
        <Setter Property="Foreground" Value="{DynamicResource CurrentWindowForeground}"/>
        <Setter Property="Background" Value="{DynamicResource CurrentWindowBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CurrentBorderColor}"/>
    </Style>

    <Style TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{DynamicResource CurrentInputForeground}"/>
        <Setter Property="Background" Value="{DynamicResource CurrentControlBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CurrentBorderColor}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CurrentControlHoverBackground}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource CurrentSelectionForeground}"/>
                <Setter Property="Background" Value="{DynamicResource CurrentSelectionBackground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ToolBar}">
        <Setter Property="Foreground" Value="{DynamicResource CurrentWindowForeground}"/>
        <Setter Property="Background" Value="{DynamicResource CurrentWindowBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CurrentBorderColor}"/>
    </Style>

    <Style TargetType="{x:Type StatusBar}">
        <Setter Property="Foreground" Value="{DynamicResource CurrentWindowForeground}"/>
        <Setter Property="Background" Value="{DynamicResource CurrentWindowBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CurrentBorderColor}"/>
    </Style>

    <Style TargetType="{x:Type GridSplitter}">
        <Setter Property="Foreground" Value="{DynamicResource CurrentWindowForeground}"/>
        <Setter Property="Background" Value="{DynamicResource CurrentControlHoverBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CurrentBorderColor}"/>
    </Style>

    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="Foreground" Value="{DynamicResource CurrentAccent}"/>
        <Setter Property="Background" Value="{DynamicResource CurrentControlBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CurrentBorderColor}"/>
    </Style>

    <Style TargetType="{x:Type Slider}">
        <Setter Property="Foreground" Value="{DynamicResource CurrentAccent}"/>
        <Setter Property="Background" Value="{DynamicResource CurrentControlBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CurrentBorderColor}"/>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Foreground" Value="{DynamicResource CurrentAccent}"/>
        <Setter Property="Background" Value="{DynamicResource CurrentControlBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CurrentBorderColor}"/>
    </Style>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="Foreground"
                Value="{DynamicResource CurrentInputForeground}"/>
        <Setter Property="Background"
                Value="{DynamicResource CurrentControlBackground}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource CurrentBorderColor}"/>
    </Style>

    <Style x:Key="ThemedMenuItemStyle"
           TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground"
                Value="{DynamicResource CurrentInputForeground}"/>
        <Setter Property="Background"
                Value="{DynamicResource CurrentControlBackground}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground"
                        Value="{DynamicResource CurrentSelectionForeground}"/>
                <Setter Property="Background"
                        Value="{DynamicResource CurrentSelectionBackground}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground"
                        Value="{DynamicResource CurrentDisabledForeground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type MenuItem}"
           BasedOn="{StaticResource ThemedMenuItemStyle}"/>

    <ControlTemplate x:Key="RichTextMenuSeparatorTemplate"
                     TargetType="{x:Type MenuItem}">
        <Grid Height="9"
              Background="{DynamicResource CurrentControlBackground}">
            <Border Height="1"
                    Background="{DynamicResource CurrentBorderColor}"
                    Opacity="0.4"
                    VerticalAlignment="Center"/>
        </Grid>
    </ControlTemplate>

    <Style x:Key="RichTextContextMenuSeparatorStyle"
           TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="9"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Grid Height="9"
                          Background="{DynamicResource CurrentControlBackground}">
                        <Border Height="1"
                                Background="{DynamicResource CurrentBorderColor}"
                                Opacity="0.4"
                                VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemedMenuGlyphStyle"
           TargetType="{x:Type TextBlock}">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground"
                Value="{DynamicResource CurrentInputForeground}"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="RichTextContextMenuStyle"
           TargetType="{x:Type ContextMenu}">
        <Setter Property="Background"
                Value="{DynamicResource CurrentControlBackground}"/>
        <Setter Property="Foreground"
                Value="{DynamicResource CurrentInputForeground}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource CurrentBorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="MinWidth" Value="245"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer CanContentScroll="True"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RichTextContextMenuItemStyle"
           TargetType="{x:Type MenuItem}"
           BasedOn="{StaticResource ThemedMenuItemStyle}">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="4,3"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="CommandTarget"
                Value="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Border x:Name="ItemBackground"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                            </Grid.ColumnDefinitions>

                            <ContentPresenter x:Name="IconPresenter"
                                              ContentSource="Icon"
                                              Width="16"
                                              Height="16"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                            <Path x:Name="CheckMark"
                                  Data="M 1 5 L 4 8 L 10 1"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.5"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                            <ContentPresenter Grid.Column="1"
                                              Margin="8,0,12,0"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Margin="8,0"
                                       Text="{TemplateBinding InputGestureText}"
                                       Foreground="{TemplateBinding Foreground}"
                                       Opacity="0.72"
                                       VerticalAlignment="Center"/>
                            <Path x:Name="SubmenuArrow"
                                  Grid.Column="3"
                                  Data="M 0 0 L 4 4 L 0 8 Z"
                                  Fill="{TemplateBinding Foreground}"
                                  Width="4"
                                  Height="8"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>

                            <Popup x:Name="PART_Popup"
                                   Placement="Right"
                                   HorizontalOffset="-1"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border MinWidth="210"
                                        Padding="4"
                                        Background="{DynamicResource CurrentControlBackground}"
                                        BorderBrush="{DynamicResource CurrentBorderColor}"
                                        BorderThickness="1"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuItem">
                            <Setter TargetName="SubmenuArrow"
                                    Property="Visibility"
                                    Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="SubmenuArrow"
                                    Property="Visibility"
                                    Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="IconPresenter"
                                    Property="Visibility"
                                    Value="Collapsed"/>
                            <Setter TargetName="CheckMark"
                                    Property="Visibility"
                                    Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground"
                Value="{DynamicResource CurrentInputForeground}"/>
        <Setter Property="Background"
                Value="{DynamicResource CurrentControlBackground}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource CurrentBorderColor}"/>
        <Setter Property="Padding" Value="7,4"/>
    </Style>

    <Style TargetType="{x:Type GridViewColumnHeader}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground"
                Value="{DynamicResource CurrentInputForeground}"/>
        <Setter Property="Background"
                Value="{DynamicResource CurrentControlBackground}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource CurrentBorderColor}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                    <Grid x:Name="Root"
                          Background="{TemplateBinding Background}"
                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <Border x:Name="HeaderBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter x:Name="HeaderContent"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <!-- Имя части обязательно для штатного изменения ширины GridViewColumn. -->
                        <Thumb x:Name="PART_HeaderGripper"
                               Width="8"
                               Margin="0,0,-4,0"
                               HorizontalAlignment="Right"
                               Background="Transparent"
                               Cursor="SizeWE"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderBorder"
                                    Property="Background"
                                    Value="{DynamicResource CurrentControlHoverBackground}"/>
                            <Setter TargetName="HeaderBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource CurrentAccent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HeaderBorder"
                                    Property="Background"
                                    Value="{DynamicResource CurrentSelectionBackground}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource CurrentSelectionForeground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource CurrentDisabledForeground}"/>
                            <Setter Property="Opacity" Value="0.72"/>
                        </Trigger>
                        <Trigger Property="Role" Value="Padding">
                            <Setter TargetName="HeaderContent"
                                    Property="Visibility"
                                    Value="Collapsed"/>
                            <Setter TargetName="PART_HeaderGripper"
                                    Property="Visibility"
                                    Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Role" Value="Floating">
                            <Setter TargetName="PART_HeaderGripper"
                                    Property="Visibility"
                                    Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
