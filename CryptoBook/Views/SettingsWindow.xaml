<Window x:Class="CryptoBook.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:interfaces="clr-namespace:CryptoBook.Interfaces"
        xmlns:markup="clr-namespace:CryptoBook.Markup"
        mc:Ignorable="d"
        Title="{Binding [Settings.WindowTitle], Source={StaticResource Res}}"
        Width="760"
        Height="520"
        MinWidth="640"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CurrentWindowBackground}"
        Foreground="{DynamicResource CurrentWindowForeground}"
        BorderBrush="{DynamicResource CurrentBorderColor}"
        Icon="{DynamicResource ApplicationWindowIcon}"
        d:DataContext="{markup:ResolveViewModel ViewModelType={x:Type interfaces:ISettingsViewModel}}">

    <Window.DataContext>
        <markup:ResolveViewModel ViewModelType="{x:Type interfaces:ISettingsViewModel}"/>
    </Window.DataContext>

    <Window.Resources>
        <BitmapImage x:Key="AboutApplicationLogo"
                     UriSource="/CryptoBook;component/Resources/Images/AppIcon.BlueYellow.v1.png"
                     DecodePixelWidth="256"
                     CacheOption="OnLoad"/>

        <Style x:Key="SettingsNavigationItemStyle"
               TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource CurrentWindowForeground}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource CurrentControlHoverBackground}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ThemeCardStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="AutomationProperties.Name"
                    Value="{Binding DisplayName}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card"
                                Padding="14"
                                CornerRadius="8"
                                Background="{DynamicResource CurrentControlBackground}"
                                BorderBrush="{DynamicResource CurrentBorderColor}"
                                BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card"
                                        Property="Background"
                                        Value="{DynamicResource CurrentControlHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card"
                                        Property="BorderBrush"
                                        Value="{DynamicResource CurrentAccent}"/>
                                <Setter TargetName="Card"
                                        Property="BorderThickness"
                                        Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding NavigationPaneWidth,
                                              Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}"
                              MinWidth="150"
                              MaxWidth="340"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.RowSpan="2"
                Background="{DynamicResource CurrentTitleBarBackground}"
                BorderBrush="{DynamicResource CurrentBorderColor}"
                BorderThickness="0,0,1,0"
                Padding="14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="8,6,8,18">
                    <TextBlock Text="{Binding [Settings.Title], Source={StaticResource Res}}"
                               FontSize="21"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="CryptoBook"
                               Foreground="{DynamicResource CurrentMutedForeground}"
                               Margin="0,3,0,0"/>
                </StackPanel>
                <ListBox SelectedIndex="{Binding SelectedSectionIndex, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource SettingsNavigationItemStyle}">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE790;"
                                       FontSize="16"
                                       Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding [Settings.Appearance], Source={StaticResource Res}}"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE838;"
                                       FontSize="16"
                                       Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding [Settings.Workspace], Source={StaticResource Res}}"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE774;"
                                       FontSize="16"
                                       Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding [Settings.Language], Source={StaticResource Res}}"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE946;"
                                       FontSize="16"
                                       Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding [Settings.About], Source={StaticResource Res}}"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE943;"
                                       FontSize="16"
                                       Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding [Settings.Developers], Source={StaticResource Res}}"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter Grid.RowSpan="2"
                      Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="True"
                      Focusable="False"
                      Cursor="SizeWE"
                      Background="{DynamicResource CurrentControlHoverBackground}"/>

        <ScrollViewer Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedSectionIndex}"
                                     Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel Margin="28,24">
                <TextBlock Text="{Binding [Settings.Appearance], Source={StaticResource Res}}"
                           FontSize="24"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding [Settings.Appearance.Description], Source={StaticResource Res}}"
                           Foreground="{DynamicResource CurrentMutedForeground}"
                           Margin="0,5,0,22"/>

                <TextBlock Text="{Binding [Settings.ApplicationTheme], Source={StaticResource Res}}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>
                <ListBox ItemsSource="{Binding Themes}"
                         SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource ThemeCardStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Width="46" Height="34" Margin="0,0,14,0">
                                    <Border Background="{Binding BackgroundPreview}"
                                            BorderBrush="{DynamicResource CurrentBorderColor}"
                                            BorderThickness="1"
                                            CornerRadius="5"/>
                                    <Ellipse Width="13"
                                             Height="13"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Bottom"
                                             Margin="0,0,4,4"
                                             Fill="{Binding AccentPreview}"/>
                                </Grid>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}"
                                               Foreground="{DynamicResource CurrentMutedForeground}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE73E;"
                                           Foreground="{DynamicResource CurrentAccent}"
                                           FontSize="18"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected,
                                                    RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                             Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="Сбрасывать ключ после бездействия"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,24,0,8"/>
                <ComboBox ItemsSource="{Binding KeyResetIntervals}"
                          SelectedItem="{Binding SelectedKeyResetInterval, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          MinWidth="180"
                          HorizontalAlignment="Left"/>
                <Border Margin="0,12,0,0"
                        Padding="12"
                        CornerRadius="7"
                        Background="{DynamicResource CurrentControlBackground}"
                        BorderBrush="{DynamicResource CurrentBorderColor}"
                        BorderThickness="1">
                    <TextBlock Text="{Binding [Settings.Appearance.DocumentNote], Source={StaticResource Res}}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource CurrentMutedForeground}"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedSectionIndex}"
                                     Value="1">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <StackPanel Margin="28,24">
                <TextBlock Text="{Binding [Settings.Workspace], Source={StaticResource Res}}"
                           FontSize="24"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding [Settings.Workspace.Description], Source={StaticResource Res}}"
                           Foreground="{DynamicResource CurrentMutedForeground}"
                           TextWrapping="Wrap"
                           Margin="0,5,0,22"/>

                <TextBlock Text="{Binding [Settings.WorkspaceDirectory], Source={StaticResource Res}}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding WorkspaceDirectory, Mode=OneWay}"
                             IsReadOnly="True"
                             MinHeight="34"
                             Padding="9,6"
                             VerticalContentAlignment="Center"
                             ToolTip="{Binding WorkspaceDirectory}"/>
                    <Button Grid.Column="1"
                            Content="{Binding [Common.Browse], Source={StaticResource Res}}"
                            Command="{Binding ChooseWorkspace}"
                            MinWidth="105"
                            Height="34"
                            Margin="8,0,0,0"/>
                </Grid>

                <TextBlock Text="{Binding [Settings.SearchByFileName], Source={StaticResource Res}}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,24,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SearchQuery,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="34"
                             Padding="9,6"
                             VerticalContentAlignment="Center"
                             ToolTip="{Binding [Settings.Search.Hint], Source={StaticResource Res}}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter"
                                        Command="{Binding Search}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1"
                            Content="{Binding [Common.Search], Source={StaticResource Res}}"
                            Command="{Binding Search}"
                            MinWidth="90"
                            Height="34"
                            Margin="8,0,0,0"/>
                </Grid>

                <Grid Margin="0,12,0,8">
                    <TextBlock Text="{Binding SearchStatus}"
                               Foreground="{DynamicResource CurrentMutedForeground}"
                               TextWrapping="Wrap"/>
                    <ProgressBar IsIndeterminate="True"
                                 Height="3"
                                 VerticalAlignment="Bottom">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSearching}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </Grid>

                <ListBox ItemsSource="{Binding SearchResults}"
                         BorderBrush="{DynamicResource CurrentBorderColor}"
                         BorderThickness="1"
                         MinHeight="190"
                         MaxHeight="280"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding RelativePath}"
                                               Foreground="{DynamicResource CurrentMutedForeground}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding FullPath}"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="{Binding [Common.Open], Source={StaticResource Res}}"
                                        Command="{Binding DataContext.OpenSearchResult,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Margin="10,0,0,0"
                                        Padding="10,4"/>
                                <Button Grid.Column="2"
                                        Content="{Binding [Common.Show], Source={StaticResource Res}}"
                                        Command="{Binding DataContext.RevealSearchResult,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Margin="6,0,0,0"
                                        Padding="10,4"
                                        ToolTip="{Binding [Settings.RevealInExplorer], Source={StaticResource Res}}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedSectionIndex}"
                                     Value="2">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel Margin="28,24">
                <TextBlock Text="{Binding [Settings.Language], Source={StaticResource Res}}"
                           FontSize="24"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding [Settings.Language.Description], Source={StaticResource Res}}"
                           Foreground="{DynamicResource CurrentMutedForeground}"
                           TextWrapping="Wrap"
                           Margin="0,5,0,22"/>
                <TextBlock Text="{Binding [Settings.ApplicationLanguage], Source={StaticResource Res}}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <ComboBox Style="{StaticResource DropUpComboBoxStyle}"
                          ItemsSource="{Binding Languages}"
                          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          MinWidth="220"
                          Height="34"
                          Foreground="{DynamicResource CurrentInputForeground}"
                          Background="{DynamicResource CurrentInputBackground}"
                          HorizontalAlignment="Left">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource CurrentInputForeground}"/>
                            <Setter Property="Background"
                                    Value="{DynamicResource CurrentInputBackground}"/>
                            <Setter Property="Padding" Value="8,5"/>
                            <Style.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource CurrentSelectionForeground}"/>
                                    <Setter Property="Background"
                                            Value="{DynamicResource CurrentSelectionBackground}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource CurrentSelectionForeground}"/>
                                    <Setter Property="Background"
                                            Value="{DynamicResource CurrentSelectionBackground}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
                <TextBlock Text="{Binding [Settings.Language.AppliedImmediately], Source={StaticResource Res}}"
                           Foreground="{DynamicResource CurrentMutedForeground}"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedSectionIndex}"
                                     Value="3">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel Margin="28,24">
                <TextBlock Text="{Binding [Settings.About], Source={StaticResource Res}}"
                           FontSize="24"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding [Settings.About.Description], Source={StaticResource Res}}"
                           Foreground="{DynamicResource CurrentMutedForeground}"
                           TextWrapping="Wrap"
                           Margin="0,5,0,22"/>

                <Border Padding="20"
                        CornerRadius="9"
                        Background="{DynamicResource CurrentControlBackground}"
                        BorderBrush="{DynamicResource CurrentBorderColor}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="84"
                                Height="84"
                                Padding="10"
                                CornerRadius="16"
                                Background="{DynamicResource CurrentControlHoverBackground}"
                                VerticalAlignment="Top">
                            <Image Source="{StaticResource AboutApplicationLogo}"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="20,1,0,0">
                            <TextBlock Text="CryptoBook"
                                       FontSize="27"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding [Settings.About.ProductDescription], Source={StaticResource Res}}"
                                       Foreground="{DynamicResource CurrentMutedForeground}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,13"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding [Settings.About.Version], Source={StaticResource Res}}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding ApplicationVersion}"/>
                                <TextBlock Text="  ·  "
                                           Foreground="{DynamicResource CurrentMutedForeground}"/>
                                <TextBlock Text="Windows x64 · .NET 8"
                                           Foreground="{DynamicResource CurrentMutedForeground}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="{Binding [Settings.About.Highlights], Source={StaticResource Res}}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,22,0,10"/>
                <Border Padding="16,14"
                        CornerRadius="8"
                        Background="{DynamicResource CurrentControlBackground}"
                        BorderBrush="{DynamicResource CurrentBorderColor}"
                        BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,2,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE8A5;"
                                       Foreground="{DynamicResource CurrentAccent}"
                                       FontSize="15"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding [Settings.About.Feature.Documents], Source={StaticResource Res}}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                        <Grid Margin="0,2,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE8B7;"
                                       Foreground="{DynamicResource CurrentAccent}"
                                       FontSize="15"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding [Settings.About.Feature.Files], Source={StaticResource Res}}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                        <Grid Margin="0,2,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE840;"
                                       Foreground="{DynamicResource CurrentAccent}"
                                       FontSize="15"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding [Settings.About.Feature.QuickAccess], Source={StaticResource Res}}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                        <Grid Margin="0,2,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE721;"
                                       Foreground="{DynamicResource CurrentAccent}"
                                       FontSize="15"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding [Settings.About.Feature.Search], Source={StaticResource Res}}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE72E;"
                                       Foreground="{DynamicResource CurrentAccent}"
                                       FontSize="15"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding [Settings.About.Feature.Security], Source={StaticResource Res}}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding [Settings.About.Updates], Source={StaticResource Res}}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,22,0,10"/>
                <Border Padding="16,14"
                        CornerRadius="8"
                        Background="{DynamicResource CurrentControlBackground}"
                        BorderBrush="{DynamicResource CurrentBorderColor}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE895;"
                                   Foreground="{DynamicResource CurrentAccent}"
                                   FontSize="19"
                                   VerticalAlignment="Top"
                                   Margin="0,3,0,0"/>
                        <StackPanel Grid.Column="1">
                            <Button Content="{Binding [Settings.About.Updates.Check], Source={StaticResource Res}}"
                                    Command="{Binding CheckForUpdates}"
                                    HorizontalAlignment="Left"
                                    Padding="12,6"
                                    ToolTip="{Binding [Settings.About.Updates.ToolTip], Source={StaticResource Res}}"
                                    AutomationProperties.Name="{Binding [Settings.About.Updates.ToolTip], Source={StaticResource Res}}"/>
                            <TextBlock Text="{Binding UpdateCheckStatus}"
                                       Foreground="{DynamicResource CurrentMutedForeground}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="0,9,0,0"/>
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border DataContext="{Binding UpdateNotification}"
                                    Margin="0,10,0,0"
                                    Padding="12,10"
                                    CornerRadius="7"
                                    Background="{DynamicResource CurrentControlHoverBackground}"
                                    BorderBrush="{DynamicResource CurrentAccent}"
                                    BorderThickness="1"
                                    AutomationProperties.Name="{Binding Title}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVisible}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}"
                                               Foreground="{DynamicResource CurrentMutedForeground}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0"/>
                                    <WrapPanel Margin="-5,8,0,0">
                                        <Button Content="{Binding [Update.OpenRelease], Source={StaticResource Res}}"
                                                Command="{Binding OpenRelease}"
                                                Margin="5,0,0,5"
                                                Padding="12,6"/>
                                        <Button Content="{Binding [Update.Later], Source={StaticResource Res}}"
                                                Command="{Binding RemindLater}"
                                                Margin="5,0,0,5"
                                                Padding="12,6"/>
                                        <Button Content="{Binding [Update.Skip], Source={StaticResource Res}}"
                                                Command="{Binding SkipVersion}"
                                                Margin="5,0,0,5"
                                                Padding="12,6"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Margin="0,12,0,0"
                        Padding="13"
                        CornerRadius="7"
                        Background="{DynamicResource CurrentControlHoverBackground}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left"
                                   FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE946;"
                                   Foreground="{DynamicResource CurrentAccent}"
                                   FontSize="16"
                                   Margin="0,1,10,0"/>
                        <TextBlock Text="{Binding [Settings.About.DevelopmentStatus], Source={StaticResource Res}}"
                                   Foreground="{DynamicResource CurrentMutedForeground}"
                                   TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedSectionIndex}"
                                     Value="4">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel Margin="28,24">
                <TextBlock Text="{Binding [Settings.Developers], Source={StaticResource Res}}"
                           FontSize="24"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding [Settings.Developers.Description], Source={StaticResource Res}}"
                           Foreground="{DynamicResource CurrentMutedForeground}"
                           TextWrapping="Wrap"
                           Margin="0,5,0,22"/>

                <TextBlock Text="{Binding [Settings.Developers.Technology], Source={StaticResource Res}}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <Border Padding="16,14"
                        CornerRadius="8"
                        Background="{DynamicResource CurrentControlBackground}"
                        BorderBrush="{DynamicResource CurrentBorderColor}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE7F8;"
                                   Foreground="{DynamicResource CurrentAccent}"
                                   FontSize="19"
                                   Margin="0,2,0,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding [Settings.Developers.Platform.Title], Source={StaticResource Res}}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding [Settings.Developers.Platform.Description], Source={StaticResource Res}}"
                                       Foreground="{DynamicResource CurrentMutedForeground}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Margin="0,10,0,0"
                        Padding="16,14"
                        CornerRadius="8"
                        Background="{DynamicResource CurrentControlBackground}"
                        BorderBrush="{DynamicResource CurrentBorderColor}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE950;"
                                   Foreground="{DynamicResource CurrentAccent}"
                                   FontSize="19"
                                   Margin="0,2,0,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding [Settings.Developers.Architecture.Title], Source={StaticResource Res}}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding [Settings.Developers.Architecture.Description], Source={StaticResource Res}}"
                                       Foreground="{DynamicResource CurrentMutedForeground}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Margin="0,10,0,0"
                        Padding="16,14"
                        CornerRadius="8"
                        Background="{DynamicResource CurrentControlBackground}"
                        BorderBrush="{DynamicResource CurrentBorderColor}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE72E;"
                                   Foreground="{DynamicResource CurrentAccent}"
                                   FontSize="19"
                                   Margin="0,2,0,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding [Settings.Developers.Security.Title], Source={StaticResource Res}}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding [Settings.Developers.Security.Description], Source={StaticResource Res}}"
                                       Foreground="{DynamicResource CurrentMutedForeground}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Margin="0,10,0,0"
                        Padding="16,14"
                        CornerRadius="8"
                        Background="{DynamicResource CurrentControlBackground}"
                        BorderBrush="{DynamicResource CurrentBorderColor}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE9D9;"
                                   Foreground="{DynamicResource CurrentAccent}"
                                   FontSize="19"
                                   Margin="0,2,0,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding [Settings.Developers.Quality.Title], Source={StaticResource Res}}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding [Settings.Developers.Quality.Description], Source={StaticResource Res}}"
                                       Foreground="{DynamicResource CurrentMutedForeground}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Grid.Column="2"
                BorderBrush="{DynamicResource CurrentBorderColor}"
                BorderThickness="0,1,0,0"
                Padding="12">
            <Button Content="{Binding [Common.Close], Source={StaticResource Res}}"
                    Command="{Binding Close}"
                    Width="96"
                    Height="32"
                    HorizontalAlignment="Right"/>
        </Border>
    </Grid>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Loaded}"/>
        </i:EventTrigger>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding Closing}"/>
        </i:EventTrigger>
        <i:EventTrigger EventName="Closed">
            <i:InvokeCommandAction Command="{Binding Closed}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
</Window>
