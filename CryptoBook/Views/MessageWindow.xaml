<Window x:Class="CryptoBook.Views.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:converters="clr-namespace:CryptoBook.Converters"
        xmlns:markup="clr-namespace:CryptoBook.Markup"
        xmlns:interfaces="clr-namespace:CryptoBook.Interfaces"
        xmlns:local="clr-namespace:CryptoBook.Views"
        mc:Ignorable="d"
        Background="{DynamicResource CurrentWindowBackground}"
        Foreground="{DynamicResource CurrentWindowForeground}"
        WindowStartupLocation="CenterOwner"
        MinHeight="235"
        MinWidth="400">

    <Window.DataContext>
        <markup:ResolveViewModel ViewModelType="{x:Type interfaces:IMessageWindowViewModel}"/>
    </Window.DataContext>
    <Window.Title>
        <Binding Path="Title" UpdateSourceTrigger="PropertyChanged"/>
    </Window.Title>
    <Window.Width>
        <Binding Path="WindowWidth"  Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
    </Window.Width>
    <Window.Height>
        <Binding Path="WindowHeight"  Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
    </Window.Height>
    <Window.Top>
        <Binding Path="WindowTop"  Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
    </Window.Top>
    <Window.Left >
        <Binding Path="WindowLeft"  Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
    </Window.Left>
    <Window.WindowState>
        <Binding Path="WindowState" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
    </Window.WindowState>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Margin="20,20,20,0" Grid.Row="0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"
                       Foreground="{DynamicResource CurrentWindowForeground}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,20"/>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Margin="20,10,20,20" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding [Common.OK], Source={StaticResource Res}}"
                        Command="{Binding OkCommand,UpdateSourceTrigger=PropertyChanged}"
                        Width="80"/>

                <Button Content="{Binding [Common.Cancel], Source={StaticResource Res}}"
                        Visibility="{Binding IsCanceled, 
                    Converter={markup:ResolveConverter ConverterType={x:Type converters:VisibilityConverter}},UpdateSourceTrigger=PropertyChanged}"
                        Command="{Binding CancelCommand, UpdateSourceTrigger=PropertyChanged}"
                        Width="80"
                        Margin="10,0,0,0"/>
        </StackPanel>
   </Grid>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Loaded, UpdateSourceTrigger=PropertyChanged}"/>
        </i:EventTrigger>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding Closing, UpdateSourceTrigger=PropertyChanged}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
</Window>
