<Window x:Class="CryptoBook.Views.BatchRenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:markup="clr-namespace:CryptoBook.Markup"
        xmlns:infra="clr-namespace:CryptoBook.Infrastructure"
        xmlns:vm="clr-namespace:CryptoBook.ViewModels"
        xmlns:behaviors="clr-namespace:CryptoBook.Behaviors"
        Title="{Binding [BatchRename.Title], Source={StaticResource Res}}"
        Width="1040" Height="740" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CurrentWindowBackground}"
        Foreground="{DynamicResource CurrentWindowForeground}">
    <Window.DataContext>
        <markup:ResolveViewModel ViewModelType="{x:Type vm:BatchRenameViewModel}"/>
    </Window.DataContext>
    <Window.Resources>
        <infra:ResourceWrapper x:Key="Res"/>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style x:Key="MaskButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="42"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="behaviors:TextInsertionBehavior.Text" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,12,8"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource CurrentInputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource CurrentInputForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CurrentBorderColor}"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding [BatchRename.Hint], Source={StaticResource Res}}"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>
        <Grid Grid.Row="1" IsEnabled="{Binding CanEdit}">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding [BatchRename.NameMask], Source={StaticResource Res}}"/>
                <TextBox x:Name="NameMaskBox" Text="{Binding NameMask, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,4,12,4" Style="{StaticResource Field}" AutomationProperties.Name="{Binding [BatchRename.NameMask], Source={StaticResource Res}}"/>
                <WrapPanel x:Name="NameMaskTokens" Margin="0,0,12,0">
                    <Button Content="[N]" Style="{StaticResource MaskButton}" behaviors:TextInsertionBehavior.Target="{Binding ElementName=NameMaskBox}"
                            ToolTip="{Binding [BatchRename.TokenName], Source={StaticResource Res}}"/>
                    <Button Content="[E]" Style="{StaticResource MaskButton}" behaviors:TextInsertionBehavior.Target="{Binding ElementName=NameMaskBox}"
                            ToolTip="{Binding [BatchRename.TokenExtension], Source={StaticResource Res}}"/>
                    <Button Content="[C]" Style="{StaticResource MaskButton}" behaviors:TextInsertionBehavior.Target="{Binding ElementName=NameMaskBox}"
                            ToolTip="{Binding [BatchRename.TokenCounter], Source={StaticResource Res}}"/>
                    <Button Content="[DMY]" Style="{StaticResource MaskButton}" behaviors:TextInsertionBehavior.Target="{Binding ElementName=NameMaskBox}"
                            ToolTip="{Binding [BatchRename.TokenDate], Source={StaticResource Res}}"/>
                    <Button Content="[HMS]" Style="{StaticResource MaskButton}" behaviors:TextInsertionBehavior.Target="{Binding ElementName=NameMaskBox}"
                            ToolTip="{Binding [BatchRename.TokenTime], Source={StaticResource Res}}"/>
                </WrapPanel>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding [BatchRename.ExtensionMask], Source={StaticResource Res}}"/>
                <TextBox x:Name="ExtensionMaskBox" Text="{Binding ExtensionMask, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,4,12,4" Style="{StaticResource Field}"
                         AutomationProperties.Name="{Binding [BatchRename.ExtensionMask], Source={StaticResource Res}}"/>
                <WrapPanel x:Name="ExtensionMaskTokens" Margin="0,0,12,0">
                    <Button Content="[N]" Style="{StaticResource MaskButton}" behaviors:TextInsertionBehavior.Target="{Binding ElementName=ExtensionMaskBox}"
                            ToolTip="{Binding [BatchRename.TokenName], Source={StaticResource Res}}"/>
                    <Button Content="[E]" Style="{StaticResource MaskButton}" behaviors:TextInsertionBehavior.Target="{Binding ElementName=ExtensionMaskBox}"
                            ToolTip="{Binding [BatchRename.TokenExtension], Source={StaticResource Res}}"/>
                    <Button Content="[C]" Style="{StaticResource MaskButton}" behaviors:TextInsertionBehavior.Target="{Binding ElementName=ExtensionMaskBox}"
                            ToolTip="{Binding [BatchRename.TokenCounter], Source={StaticResource Res}}"/>
                    <Button Content="[DMY]" Style="{StaticResource MaskButton}" behaviors:TextInsertionBehavior.Target="{Binding ElementName=ExtensionMaskBox}"
                            ToolTip="{Binding [BatchRename.TokenDate], Source={StaticResource Res}}"/>
                    <Button Content="[HMS]" Style="{StaticResource MaskButton}" behaviors:TextInsertionBehavior.Target="{Binding ElementName=ExtensionMaskBox}"
                            ToolTip="{Binding [BatchRename.TokenTime], Source={StaticResource Res}}"/>
                </WrapPanel>
            </StackPanel>
            <StackPanel Grid.Row="1">
                <TextBlock Text="{Binding [BatchRename.Search], Source={StaticResource Res}}"/>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"
                         AutomationProperties.Name="{Binding [BatchRename.Search], Source={StaticResource Res}}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1">
                <TextBlock Text="{Binding [BatchRename.Replacement], Source={StaticResource Res}}"/>
                <TextBox Text="{Binding Replacement, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"
                         AutomationProperties.Name="{Binding [BatchRename.Replacement], Source={StaticResource Res}}"/>
            </StackPanel>
            <StackPanel Grid.Row="2">
                <WrapPanel Margin="0,2,0,10">
                    <CheckBox IsChecked="{Binding UseRegex}" Margin="0,0,18,0"
                              Content="{Binding [BatchRename.Regex], Source={StaticResource Res}}"/>
                    <CheckBox IsChecked="{Binding MatchCase}"
                              Content="{Binding [BatchRename.MatchCase], Source={StaticResource Res}}"/>
                </WrapPanel>
                <TextBlock Text="{Binding [BatchRename.Case], Source={StaticResource Res}}"/>
                <ComboBox x:Name="CaseCombo" SelectedIndex="{Binding CaseIndex}" Margin="0,4,12,10"
                          MinHeight="28" Style="{StaticResource DropUpComboBoxStyle}">
                    <ComboBoxItem Content="{Binding [BatchRename.CaseUnchanged], Source={StaticResource Res}}"/>
                    <ComboBoxItem Content="{Binding [BatchRename.CaseLower], Source={StaticResource Res}}"/>
                    <ComboBoxItem Content="{Binding [BatchRename.CaseUpper], Source={StaticResource Res}}"/>
                    <ComboBoxItem Content="{Binding [BatchRename.CaseTitle], Source={StaticResource Res}}"/>
                </ComboBox>
            </StackPanel>
            <UniformGrid Grid.Row="2" Grid.Column="1" Columns="3" VerticalAlignment="Bottom">
                <StackPanel><TextBlock Text="{Binding [BatchRename.CounterStart], Source={StaticResource Res}}"/>
                    <TextBox Text="{Binding CounterStart, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"
                             AutomationProperties.Name="{Binding [BatchRename.CounterStart], Source={StaticResource Res}}"/></StackPanel>
                <StackPanel><TextBlock Text="{Binding [BatchRename.CounterStep], Source={StaticResource Res}}"/>
                    <TextBox Text="{Binding CounterStep, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"
                             AutomationProperties.Name="{Binding [BatchRename.CounterStep], Source={StaticResource Res}}"/></StackPanel>
                <StackPanel><TextBlock Text="{Binding [BatchRename.CounterDigits], Source={StaticResource Res}}"/>
                    <TextBox Text="{Binding CounterDigits, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"
                             AutomationProperties.Name="{Binding [BatchRename.CounterDigits], Source={StaticResource Res}}"/></StackPanel>
            </UniformGrid>
        </Grid>
        <DataGrid x:Name="PreviewGrid" Grid.Row="2" ItemsSource="{Binding Entries}" IsReadOnly="True"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserSortColumns="False" HeadersVisibility="Column" EnableRowVirtualization="True"
                  Background="{DynamicResource CurrentInputBackground}" Foreground="{DynamicResource CurrentInputForeground}"
                  RowBackground="{DynamicResource CurrentInputBackground}" BorderBrush="{DynamicResource CurrentBorderColor}"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource CurrentBorderColor}">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource CurrentControlBackground}"/>
                    <Setter Property="Foreground" Value="{DynamicResource CurrentWindowForeground}"/>
                    <Setter Property="Padding" Value="8"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource CurrentInputForeground}"/>
                    <Setter Property="Padding" Value="5"/>
                </Style>
                <Style x:Key="CellText" TargetType="TextBlock">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    <Setter Property="ToolTip" Value="{Binding SourcePath}"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{Binding [BatchRename.OldName], Source={StaticResource Res}}"
                                    Binding="{Binding OldName}" Width="*" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="{Binding [BatchRename.NewName], Source={StaticResource Res}}"
                                    Binding="{Binding NewName}" Width="*" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="{Binding [BatchRename.Error], Source={StaticResource Res}}"
                                    Binding="{Binding Error}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Margin="0,10,0,10">
            <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                <TextBox Text="{Binding Status, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         BorderThickness="0" Background="Transparent" Foreground="{DynamicResource CurrentWindowForeground}"/>
            </ScrollViewer>
            <TextBlock Text="{Binding LinksWarning}" TextWrapping="Wrap"/>
            <ProgressBar Height="4" Margin="0,4,0,0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
        </StackPanel>
        <WrapPanel Grid.Row="4" HorizontalAlignment="Right">
            <Button Content="{Binding [Common.Refresh], Source={StaticResource Res}}" Command="{Binding RefreshPreviewCommand}" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="{Binding [BatchRename.Undo], Source={StaticResource Res}}" Command="{Binding UndoCommand}" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="{Binding [Common.Cancel], Source={StaticResource Res}}" Command="{Binding CancelCommand}" Padding="12,6" Margin="0,0,8,0"/>
            <Button x:Name="ApplyButton" Content="{Binding [BatchRename.Apply], Source={StaticResource Res}}"
                    Command="{Binding ApplyCommand}" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="{Binding [Common.Close], Source={StaticResource Res}}" Command="{Binding Close}" Padding="12,6"/>
        </WrapPanel>
    </Grid>
    <Window.InputBindings><KeyBinding Key="Escape" Command="{Binding Close}"/></Window.InputBindings>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded"><i:InvokeCommandAction Command="{Binding Loaded}"/></i:EventTrigger>
        <i:EventTrigger EventName="Closing"><i:InvokeCommandAction Command="{Binding Closing}" PassEventArgsToCommand="True"/></i:EventTrigger>
        <i:EventTrigger EventName="Closed"><i:InvokeCommandAction Command="{Binding Closed}"/></i:EventTrigger>
    </i:Interaction.Triggers>
</Window>
