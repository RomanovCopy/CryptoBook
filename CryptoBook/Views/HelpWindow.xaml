<Window x:Class="CryptoBook.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:help="clr-namespace:CryptoBook.Help"
        xmlns:markup="clr-namespace:CryptoBook.Markup"
        Title="{Binding Title}" Language="{Binding Culture, ConverterCulture=en-US}" FlowDirection="{Binding FlowDirection}"
        Width="1120" Height="780" MinWidth="720" MinHeight="480" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CurrentWindowBackground}" Foreground="{DynamicResource CurrentWindowForeground}"
        UseLayoutRounding="True">
    <Window.DataContext>
        <markup:ResolveViewModel ViewModelType="{x:Type help:HelpWindowViewModel}"/>
    </Window.DataContext>
    <i:Interaction.Behaviors><help:HelpWindowBehavior/></i:Interaction.Behaviors>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <HierarchicalDataTemplate DataType="{x:Type help:HelpTreeNode}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}">
                <TextBlock.Style><Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource CurrentWindowForeground}"/>
                    <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource CurrentSelectionBackground}"/>
                        <Setter Property="Foreground" Value="{DynamicResource CurrentSelectionForeground}"/>
                    </DataTrigger></Style.Triggers>
                </Style></TextBlock.Style>
            </TextBlock>
        </HierarchicalDataTemplate>
        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,10">
            <Button Content="{Binding [Help.Back], Source={StaticResource Res}}" Command="{Binding Back}" Margin="0,0,8,4" Padding="12,6" ToolTip="Alt+←"/>
            <Button Content="{Binding [Help.Forward], Source={StaticResource Res}}" Command="{Binding Forward}" Margin="0,0,8,4" Padding="12,6" ToolTip="Alt+→"/>
            <Button Content="{Binding [Help.Contents], Source={StaticResource Res}}" Command="{Binding ClearSearch}" Margin="0,0,8,4" Padding="12,6"/>
        </WrapPanel>
        <Grid x:Name="HelpColumns" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationColumn" Width="280" MinWidth="220" MaxWidth="420"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
            </Grid.ColumnDefinitions>
            <Grid Margin="0,0,8,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="{Binding [Help.Search], Source={StaticResource Res}}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="HelpSearch" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" MinHeight="32"
                             AutomationProperties.Name="{Binding [Help.Search], Source={StaticResource Res}}"/>
                    <Button Grid.Column="1" Content="×" Command="{Binding ClearSearch}" Padding="10,0" Margin="4,0,0,0"
                            ToolTip="{Binding [Help.ClearSearch], Source={StaticResource Res}}" AutomationProperties.Name="{Binding [Help.ClearSearch], Source={StaticResource Res}}"/>
                </Grid>
                <TreeView x:Name="ContentsTree" Grid.Row="2" ItemsSource="{Binding Sections}"
                          AutomationProperties.Name="{Binding [Help.Contents], Source={StaticResource Res}}">
                    <TreeView.Style><Style TargetType="TreeView" BasedOn="{StaticResource {x:Type TreeView}}">
                        <Style.Triggers><DataTrigger Binding="{Binding IsSearching}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                    </Style></TreeView.Style>
                </TreeView>
                <ListBox x:Name="SearchResults" Grid.Row="2" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                         Visibility="{Binding IsSearching, Converter={StaticResource BoolVisibility}}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="{Binding [Help.Results], Source={StaticResource Res}}">
                    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,6">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Snippet}" TextWrapping="Wrap" Margin="0,5,0,0" FontSize="12"/>
                    </StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="2" Text="{Binding [Help.NoResults], Source={StaticResource Res}}" TextWrapping="Wrap" Margin="12"
                           Visibility="{Binding HasNoResults, Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False"/>
            </Grid>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource CurrentBorderColor}"/>
            <FlowDocumentScrollViewer x:Name="ArticleViewer" Grid.Column="2" Document="{Binding Article}"
                                     IsToolBarVisible="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="{Binding [Help.Article], Source={StaticResource Res}}"/>
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <Border Grid.RowSpan="3" Background="{DynamicResource CurrentWindowBackground}" BorderBrush="{DynamicResource CurrentBorderColor}" BorderThickness="1" Padding="12"
                KeyboardNavigation.TabNavigation="Cycle" FocusManager.IsFocusScope="True"
                Visibility="{Binding IsImageOpen, Converter={StaticResource BoolVisibility}}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,10">
                    <Button x:Name="CloseImageButton" DockPanel.Dock="Right" Content="{Binding [Help.CloseImage], Source={StaticResource Res}}" Command="{Binding CloseImage}" Padding="12,6"/>
                    <TextBlock Text="{Binding Image.Caption}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                </DockPanel>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Image Source="{Binding Image.Source}" Stretch="None" AutomationProperties.Name="{Binding Image.Caption}"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
