<Window x:Class="CryptoBook.Views.AiChatAppearanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [AI.Appearance], Source={StaticResource Res}}"
        Width="480" Height="700" MinWidth="380" MinHeight="360" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CurrentWindowBackground}" Foreground="{DynamicResource CurrentWindowForeground}"
        Icon="{DynamicResource ApplicationWindowIcon}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{Binding [AI.Appearance], Source={StaticResource Res}}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <Label Content="{Binding [AI.ChatFont], Source={StaticResource Res}}" Target="{Binding ElementName=FontBox}"/>
                <ComboBox x:Name="FontBox" Style="{StaticResource DropUpComboBoxStyle}" ItemsSource="{Binding Fonts}" SelectedItem="{Binding FontFamily}" Height="32"/>
                <Label Content="{Binding [AI.ChatFontSize], Source={StaticResource Res}}" Target="{Binding ElementName=FontSizeBox}" Margin="0,10,0,0"/>
                <ComboBox x:Name="FontSizeBox" Style="{StaticResource DropUpComboBoxStyle}" ItemsSource="{Binding FontSizes}" SelectedItem="{Binding FontSize}" Height="32"/>
                <Label Content="{Binding [AI.UserColor], Source={StaticResource Res}}" Target="{Binding ElementName=UserColorBox}" Margin="0,10,0,0"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="…" Command="{Binding ChooseUserColor}" Width="36" Margin="8,0,0,0" AutomationProperties.Name="{Binding [AI.UserColor], Source={StaticResource Res}}"/>
                    <TextBox x:Name="UserColorBox" Text="{Binding UserColor, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"/>
                </DockPanel>
                <Label Content="{Binding [AI.AssistantColor], Source={StaticResource Res}}" Target="{Binding ElementName=AssistantColorBox}" Margin="0,10,0,0"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="…" Command="{Binding ChooseAssistantColor}" Width="36" Margin="8,0,0,0" AutomationProperties.Name="{Binding [AI.AssistantColor], Source={StaticResource Res}}"/>
                    <TextBox x:Name="AssistantColorBox" Text="{Binding AssistantColor, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"/>
                </DockPanel>
                <TextBlock Text="{Binding [AI.ColorHint], Source={StaticResource Res}}" TextWrapping="Wrap" Foreground="{DynamicResource CurrentMutedForeground}" FontSize="11" Margin="0,6,0,12"/>
                <Label Content="{Binding [AI.CodeFont], Source={StaticResource Res}}" Target="{Binding ElementName=CodeFontBox}"/>
                <ComboBox x:Name="CodeFontBox" Style="{StaticResource DropUpComboBoxStyle}" ItemsSource="{Binding CodeFonts}" SelectedItem="{Binding CodeFontFamily}" Height="32"/>
                <Label Content="{Binding [AI.CodeColor], Source={StaticResource Res}}" Target="{Binding ElementName=CodeColorBox}" Margin="0,10,0,0"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="…" Command="{Binding ChooseCodeColor}" Width="36" Margin="8,0,0,0"
                            AutomationProperties.Name="{Binding [AI.CodeColor], Source={StaticResource Res}}"/>
                    <TextBox x:Name="CodeColorBox" Text="{Binding CodeColor, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"/>
                </DockPanel>
                <TextBlock Text="{Binding [AI.CodeColorHint], Source={StaticResource Res}}" TextWrapping="Wrap" Foreground="{DynamicResource CurrentMutedForeground}" FontSize="11" Margin="0,6,0,12"/>
                <CheckBox Style="{StaticResource ThemedCheckBoxStyle}" Content="{Binding [AI.MessageBorders], Source={StaticResource Res}}" IsChecked="{Binding ShowMessageBorders}"/>
                <CheckBox x:Name="RenderMarkdownCheckBox" Style="{StaticResource ThemedCheckBoxStyle}" Content="{Binding [AI.RenderMarkdown], Source={StaticResource Res}}" IsChecked="{Binding RenderMarkdown}" Margin="0,12,0,0"/>
                <TextBlock Text="{Binding [AI.RenderMarkdownHint], Source={StaticResource Res}}" TextWrapping="Wrap" Foreground="{DynamicResource CurrentMutedForeground}" FontSize="11" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button DockPanel.Dock="Left" Content="{Binding [AI.AppearanceReset], Source={StaticResource Res}}" Command="{Binding Reset}" Padding="10,6"/>
            <Button x:Name="SaveAppearanceButton" Content="{Binding [Common.Save], Source={StaticResource Res}}" Command="{Binding Save}" HorizontalAlignment="Right" Padding="16,6"/>
        </DockPanel>
    </Grid>
</Window>
