<Window x:Class="CryptoBook.Views.KeyInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:markup="clr-namespace:CryptoBook.Markup"
        xmlns:vm="clr-namespace:CryptoBook.ViewModels"
        xmlns:security="clr-namespace:CryptoBook.Security"
        xmlns:interfaces="clr-namespace:CryptoBook.Interfaces"
        xmlns:behaviors="clr-namespace:CryptoBook.Behaviors"
        xmlns:local="clr-namespace:CryptoBook.Views"
        mc:Ignorable="d" d:DataContext="{markup:ResolveViewModel ViewModelType='{x:Type interfaces:IKeyInputViewModel}'}"
        WindowStartupLocation="CenterOwner"
        MinWidth="420"
        MinHeight="230">
    
    <Window.DataContext>
        <markup:ResolveViewModel ViewModelType="{x:Type interfaces:IKeyInputViewModel}" />
    </Window.DataContext>

    <Window.Title>
        <Binding Path="Title" UpdateSourceTrigger="PropertyChanged"/>
    </Window.Title>

    <Window.Width>
        <Binding Path="WindowWidth"  Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
    </Window.Width>
    <Window.Height>
        <Binding Path="WindowHeight"  Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
    </Window.Height>
    <Window.Top>
        <Binding Path="WindowTop"  Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
    </Window.Top>
    <Window.Left >
        <Binding Path="WindowLeft"  Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
    </Window.Left>
    <Window.WindowState>
        <Binding Path="WindowState" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
    </Window.WindowState>


    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Message,UpdateSourceTrigger=PropertyChanged}"
                   TextWrapping="Wrap"/>

        <PasswordBox x:Name="PasswordBox" 
                     Grid.Row="2"
                     MinHeight="28"/>

        <PasswordBox x:Name="RepeatPasswordBox"
                     Grid.Row="4"
                     MinHeight="28"/>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="5"
                   Foreground="Crimson"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"/>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            
            <Button x:Name="OkButton"
                    Content="OK"
                    Width="90"
                    IsDefault="True"
                    Margin="0,0,8,0"/>

            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Width="90"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
    <i:Interaction.Behaviors>
        <behaviors:KeyInputWindowBehavior
            MinLength="4"
            MaxLength="128"
            AllowWhiteSpace="False"
            KeyProvider="{markup:ResolveService ServiceType={x:Type security:IKeyProvider}}"
            Converter="{markup:ResolveService ServiceType={x:Type interfaces:ISecureStringConverter}}">
        </behaviors:KeyInputWindowBehavior>
    </i:Interaction.Behaviors>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Loaded, UpdateSourceTrigger=PropertyChanged}" />
        </i:EventTrigger>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding Closing, UpdateSourceTrigger=PropertyChanged}" />
        </i:EventTrigger>
        <i:EventTrigger EventName="Closed">
            <i:InvokeCommandAction Command="{Binding Closed, UpdateSourceTrigger=PropertyChanged}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
</Window>
