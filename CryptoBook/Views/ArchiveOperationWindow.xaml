<Window x:Class="CryptoBook.Views.ArchiveOperationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:infra="clr-namespace:CryptoBook.Infrastructure"
        xmlns:markup="clr-namespace:CryptoBook.Markup"
        xmlns:vm="clr-namespace:CryptoBook.ViewModels"
        xmlns:behaviors="clr-namespace:CryptoBook.Behaviors"
        Title="{Binding Title}" Width="660" Height="620" MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CurrentWindowBackground}"
        Foreground="{DynamicResource CurrentWindowForeground}">
    <Window.DataContext>
        <markup:ResolveViewModel ViewModelType="{x:Type vm:ArchiveOperationViewModel}"/>
    </Window.DataContext>
    <Window.Resources>
        <infra:ResourceWrapper x:Key="Res"/>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="Background" Value="{DynamicResource CurrentInputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource CurrentInputForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CurrentBorderColor}"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel IsEnabled="{Binding CanEdit}">
                <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <TextBox Text="{Binding SourceSummary, Mode=OneWay}" IsReadOnly="True" MaxHeight="90"
                         VerticalScrollBarVisibility="Auto" Style="{StaticResource Field}"
                         AutomationProperties.Name="{Binding [Archive.Sources], Source={StaticResource Res}}"/>
                <StackPanel Visibility="{Binding HasDestination, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="{Binding [Archive.Destination], Source={StaticResource Res}}"/>
                    <DockPanel>
                        <Button Content="…" Command="{Binding BrowseCommand}" DockPanel.Dock="Right"
                                Margin="8,4,0,10" Padding="12,4"
                                AutomationProperties.Name="{Binding [Archive.Browse], Source={StaticResource Res}}"/>
                        <TextBox Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"
                                 AutomationProperties.Name="{Binding [Archive.Destination], Source={StaticResource Res}}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding [Archive.OutputName], Source={StaticResource Res}}"/>
                    <TextBox x:Name="OutputNameBox" Text="{Binding OutputName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource Field}" AutomationProperties.Name="{Binding [Archive.OutputName], Source={StaticResource Res}}"/>
                </StackPanel>
                <StackPanel Visibility="{Binding IsCreate, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="{Binding [Archive.Format], Source={StaticResource Res}}"/>
                    <ComboBox SelectedIndex="{Binding FormatIndex}" Margin="0,4,0,10"
                              MinHeight="28" Style="{StaticResource DropUpComboBoxStyle}"
                              AutomationProperties.Name="{Binding [Archive.Format], Source={StaticResource Res}}">
                        <ComboBoxItem Content="ZIP"/><ComboBoxItem Content="7z"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Visibility="{Binding IsExtract, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="{Binding [Archive.MaximumSize], Source={StaticResource Res}}"/>
                    <TextBox Text="{Binding MaximumGigabytes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"
                             AutomationProperties.Name="{Binding [Archive.MaximumSize], Source={StaticResource Res}}"/>
                </StackPanel>
                <TextBlock Text="{Binding [Archive.Password], Source={StaticResource Res}}"/>
                <PasswordBox x:Name="ArchivePassword" Padding="6,5" Margin="0,4,0,10"
                             Background="{DynamicResource CurrentInputBackground}"
                             Foreground="{DynamicResource CurrentInputForeground}"
                             BorderBrush="{DynamicResource CurrentBorderColor}"
                             AutomationProperties.Name="{Binding [Archive.Password], Source={StaticResource Res}}">
                    <i:Interaction.Behaviors>
                        <behaviors:SecurePasswordValueBehavior Value="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </i:Interaction.Behaviors>
                </PasswordBox>
            </StackPanel>
        </ScrollViewer>
        <TextBox Grid.Row="1" Text="{Binding Status, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                 MaxHeight="140" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                 Foreground="{DynamicResource CurrentWindowForeground}" Margin="0,12,0,12"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RunButton" Content="{Binding Title}" Command="{Binding RunCommand}"
                    Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="{Binding [Common.Close], Source={StaticResource Res}}" Command="{Binding Close}" Padding="12,6"/>
        </StackPanel>
    </Grid>
    <Window.InputBindings><KeyBinding Key="Escape" Command="{Binding Close}"/></Window.InputBindings>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing"><i:InvokeCommandAction Command="{Binding Closing}" PassEventArgsToCommand="True"/></i:EventTrigger>
        <i:EventTrigger EventName="Closed"><i:InvokeCommandAction Command="{Binding Closed}"/></i:EventTrigger>
    </i:Interaction.Triggers>
</Window>
