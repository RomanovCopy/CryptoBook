<Window x:Class="CryptoBook.Views.FileExplorer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        
        xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:interfaces="clr-namespace:CryptoBook.Interfaces"
        xmlns:converters="clr-namespace:CryptoBook.Converters"
        xmlns:services="clr-namespace:CryptoBook.Services"
        xmlns:markup="clr-namespace:CryptoBook.Markup"
        xmlns:dto="clr-namespace:CryptoBook.DTO"
        xmlns:icons="System.Drawing.Icon.ExtractAssociatedIcon"
        xmlns:viewmodels="clr-namespace:CryptoBook.ViewModels"
        xmlns:behaviors="clr-namespace:CryptoBook.Behaviors"
        xmlns:local="clr-namespace:CryptoBook.Views"
        mc:Ignorable="d"
        d:DataContext="{x:Type viewmodels:FileExplorerViewModel}"
        MinHeight="400" MinWidth="600"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResizeWithGrip"
        Title="{Binding ExplorerTitle}">
    <Window.DataContext>
        <markup:ResolveViewModel ViewModelType="{x:Type interfaces:IFileExplorerViewModel}" />
    </Window.DataContext>
    <Window.Resources>

        <converters:SystemItemSelectionSnapshotConverter x:Key="SystemItemSelectionSnapshotConverter"/>

        <Style x:Key="FileExplorerToolBarButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="100"/>
            <Setter Property="ToolTipService.ShowDuration" Value="10000"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type dto:DriveItem}"
                                      ItemsSource="{Binding DirectoryChildren}">
            <StackPanel Orientation="Horizontal" Margin="2">
                <Image Width="{StaticResource Tv_IconSize}"
                       Height="{StaticResource Tv_IconSize}"
                       Margin="0,0,6,0"
                       Source="{Binding FullPath, Converter={markup:ResolveConverter ConverterType={x:Type converters:PathToIconConverter}}}"/>

                <StackPanel>
                    <TextBlock FontWeight="Bold">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} [{1}]">
                                <Binding Path="RootDirectory"/>
                                <Binding Path="VolumeLabel"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource CurrentMutedForeground}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} • Свободно: {1:F1} ГБ из {2:F1} ГБ">
                                <Binding Path="DriveFormat"/>
                                <Binding Path="AvailableFreeSpace" Converter="{markup:ResolveConverter ConverterType={x:Type converters:BytesToGbConverter}}"/>
                                <Binding Path="TotalSize" Converter="{markup:ResolveConverter ConverterType={x:Type converters:BytesToGbConverter}}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type dto:DirectoryItem}"
                                      ItemsSource="{Binding DirectoryChildren}">
            <DockPanel LastChildFill="True">
                <Image Width="{StaticResource Tv_IconSize}"
                       Height="{StaticResource Tv_IconSize}"
                       Margin="0,0,6,0"
                       Source="{Binding FullPath, Converter={markup:ResolveConverter ConverterType={x:Type converters:PathToIconConverter}}}"/>
                <TextBlock Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                           FontSize="14"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type dto:FileItem}">
            <DockPanel LastChildFill="True">
                <Image Width="{StaticResource Tv_IconSize}"
                       Height="{StaticResource Tv_IconSize}"
                       Margin="0,0,6,0"
                       Source="{Binding FullPath, Converter={markup:ResolveConverter ConverterType={x:Type converters:ExtensionToIconConverter}}}"/>
                <TextBlock Text="{Binding Name}" 
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </DataTemplate>


    </Window.Resources>

    <Window.Width>
        <Binding Path="WindowWidth"  Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
    </Window.Width>
    <Window.Height>
        <Binding Path="WindowHeight"  Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
    </Window.Height>
    <Window.Top>
        <Binding Path="WindowTop"  Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
    </Window.Top>
    <Window.Left >
        <Binding Path="WindowLeft"  Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
    </Window.Left>
    <Window.WindowState>
        <Binding Path="WindowState" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
    </Window.WindowState>


    <Grid Background="{DynamicResource CurrentWindowBackground}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Панель команд. -->
            <RowDefinition Height="Auto"/>
            <!-- Панель избранного. -->
            <RowDefinition Height="Auto"/>
            <!-- Адресная строка и вкладки. -->
            <RowDefinition Height="*"/>
            <!-- Основная область: навигация и список файлов. -->
            <RowDefinition Height="Auto"/>
            <!-- Выбранный файл. -->
            <RowDefinition Height="Auto"/>
            <!-- Строка состояния. -->
        </Grid.RowDefinitions>

        <!-- 1. Command Bar (упрощённая в Win11) -->
        <ToolBar Grid.Row="0"  Height="49"  Background="Transparent" BorderBrush="{DynamicResource CurrentBorderColor}" BorderThickness="0,0,0,1">
            <Button Content="&#xE72B;"
                    ToolTip="{Binding [Common.Back], Source={StaticResource Res}}"
                    AutomationProperties.Name="Назад"
                    Command="{Binding BackCommand, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource FileExplorerToolBarButtonStyle}"/>
            <Button Content="&#xE72A;"
                    ToolTip="{Binding [Common.Forward], Source={StaticResource Res}}"
                    AutomationProperties.Name="Вперёд"
                    Command="{Binding ForwardCommand}"
                    Style="{StaticResource FileExplorerToolBarButtonStyle}"/>
            <Button Content="&#xE74A;"
                    ToolTip="{Binding [Common.Up], Source={StaticResource Res}}"
                    AutomationProperties.Name="Вверх"
                    Command="{Binding UpCommand}"
                    Style="{StaticResource FileExplorerToolBarButtonStyle}"/>
            <Button Content="&#xE8A5;"
                    ToolTip="{Binding [Explorer.CurrentDocument], Source={StaticResource Res}}"
                    AutomationProperties.Name="Текущий документ"
                    Command="{Binding CurrentDocumentCommand}"
                    Style="{StaticResource FileExplorerToolBarButtonStyle}"/>
            <Separator/>

            <Button Content="&#xE7C3;"
                    ToolTip="{Binding [Explorer.CreateFile], Source={StaticResource Res}}"
                    AutomationProperties.Name="Создать файл"
                    Command="{Binding CreateFileCommand, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource FileExplorerToolBarButtonStyle}"/>
            <Button Content="&#xE8F4;"
                    ToolTip="{Binding [Explorer.CreateFolder], Source={StaticResource Res}}"
                    AutomationProperties.Name="Создать папку"
                    Command="{Binding CreateDirectoryCommand, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource FileExplorerToolBarButtonStyle}"/>
            <Button Content="&#xE734;"
                    ToolTip="{Binding [Explorer.AddCurrentToFavorites], Source={StaticResource Res}}"
                    AutomationProperties.Name="Добавить текущую директорию в избранное"
                    Command="{Binding Favorites.AddCurrentDirectoryCommand}"
                    CommandParameter="{Binding CurrentPath}"
                    Style="{StaticResource FileExplorerToolBarButtonStyle}"/>
            <Separator/>

            <Button Content="&#xE72C;"
                    ToolTip="{Binding [Common.Refresh], Source={StaticResource Res}}"
                    AutomationProperties.Name="Обновить содержимое"
                    Command="{Binding RefreshCommand, UpdateSourceTrigger=PropertyChanged}"
                    CommandParameter="{Binding SelectedItem}"
                    Style="{StaticResource FileExplorerToolBarButtonStyle}"/>
            <Separator/>

            <Button Content="&#xE8C6;"
                    ToolTip="{Binding [Common.Cut], Source={StaticResource Res}}"
                    AutomationProperties.Name="Вырезать"
                    Command="{Binding CutCommand, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource FileExplorerToolBarButtonStyle}"
                    CommandParameter="{Binding SelectedItemsSnapshot}"/>
            <Button Content="&#xE8C8;"
                    ToolTip="{Binding [Common.Copy], Source={StaticResource Res}}"
                    AutomationProperties.Name="Копировать"
                    Command="{Binding CopyCommand, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource FileExplorerToolBarButtonStyle}"
                    CommandParameter="{Binding SelectedItemsSnapshot}"/>
            <Button Content="&#xE77F;"
                    ToolTip="{Binding [Common.Paste], Source={StaticResource Res}}"
                    AutomationProperties.Name="Вставить"
                    Command="{Binding PasteCommand, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource FileExplorerToolBarButtonStyle}"
                    CommandParameter="{Binding ElementName=listview, Path=SelectedValue, UpdateSourceTrigger=PropertyChanged}"/>
            <Separator/>

            <Button Content="&#xE8AC;"
                    ToolTip="{Binding [Common.Rename], Source={StaticResource Res}}"
                    AutomationProperties.Name="Переименовать"
                    Command="{Binding RenameClickCommand, UpdateSourceTrigger=PropertyChanged}"
                    CommandParameter="{Binding SelectedItemsSnapshot}"
                    Style="{StaticResource FileExplorerToolBarButtonStyle}"/>
            <Button Content="&#xE74D;"
                    ToolTip="{Binding [Common.Delete], Source={StaticResource Res}}"
                    AutomationProperties.Name="Удалить"
                    Command="{Binding DeleteCommand, UpdateSourceTrigger=PropertyChanged}"
                    CommandParameter="{Binding SelectedItemsSnapshot}"
                    Style="{StaticResource FileExplorerToolBarButtonStyle}"/>
            <Separator/>

            <Button Content="&#xE8D7;"
                    ToolTip="{Binding [Explorer.SetEncryptionKey], Source={StaticResource Res}}"
                    AutomationProperties.Name="Задать ключ шифрования"
                    Command="{Binding EncryptingKeyCommand, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource FileExplorerToolBarButtonStyle}"/>
            <Button Content="&#xE72E;"
                    ToolTip="{Binding [Explorer.EncryptSelected], Source={StaticResource Res}}"
                    AutomationProperties.Name="Зашифровать выбранный элемент"
                    Command="{Binding EncryptCommand, UpdateSourceTrigger=PropertyChanged}"
                    CommandParameter="{Binding SelectedItemsSnapshot}"
                    Style="{StaticResource FileExplorerToolBarButtonStyle}"/>
            <Button Content="&#xE785;"
                    ToolTip="{Binding [Explorer.DecryptSelected], Source={StaticResource Res}}"
                    AutomationProperties.Name="Расшифровать выбранный элемент"
                    Command="{Binding DecryptCommand, UpdateSourceTrigger=PropertyChanged}"
                    CommandParameter="{Binding SelectedItemsSnapshot}"
                    Style="{StaticResource FileExplorerToolBarButtonStyle}"/>
        </ToolBar>

        <!-- 2. Favorites Bar -->
        <Grid Grid.Row="1"
              MinHeight="34"
              Background="{DynamicResource CurrentWindowBackground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="10,0,8,0"
                    BorderBrush="{DynamicResource CurrentBorderColor}"
                    BorderThickness="0,0,1,1">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Margin="0,0,5,0"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Text="&#xE734;"/>
                    <TextBlock VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="{Binding [Explorer.Favorites], Source={StaticResource Res}}"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <ToolBar ItemsSource="{Binding Favorites.Items}"
                         Background="Transparent"
                         BorderBrush="{DynamicResource CurrentBorderColor}"
                         BorderThickness="0,0,0,1"
                         ToolBarTray.IsLocked="True">
                    <ToolBar.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="1"
                                    Tag="{Binding DataContext.Favorites, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    ToolTip="{Binding AvailabilityText}">
                                <Border.ContextMenu>
                                    <ContextMenu Style="{StaticResource RichTextContextMenuStyle}">
                                        <ContextMenu.Resources>
                                            <Style TargetType="{x:Type MenuItem}"
                                                   BasedOn="{StaticResource RichTextContextMenuItemStyle}"/>
                                            <Style TargetType="{x:Type Separator}"
                                                   BasedOn="{StaticResource RichTextContextMenuSeparatorStyle}"/>
                                        </ContextMenu.Resources>
                                        <MenuItem Header="{Binding [Common.Open], Source={StaticResource Res}}"
                                                  Command="{Binding PlacementTarget.Tag.OpenCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                        <Separator/>
                                        <MenuItem Header="{Binding [Common.Rename], Source={StaticResource Res}}"
                                                  Command="{Binding PlacementTarget.Tag.RenameCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                        <MenuItem Header="{Binding [Explorer.RemoveFromFavorites], Source={StaticResource Res}}"
                                                  Command="{Binding PlacementTarget.Tag.RemoveCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                <Setter Property="Opacity" Value="0.48"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Button Padding="8,3"
                                        MinWidth="72"
                                        MaxWidth="190"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding DataContext.Favorites.OpenCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,6,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   Text="&#xE8B7;"/>
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </Border>
                        </DataTemplate>
                    </ToolBar.ItemTemplate>
                </ToolBar>

                <TextBlock Margin="9,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource CurrentMutedForeground}"
                           FontSize="11"
                           IsHitTestVisible="False"
                           Text="{Binding [Explorer.Favorites.Empty], Source={StaticResource Res}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Favorites.Items.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>

        <!-- 3. Address Bar -->
        <Grid Grid.Row="2" Margin="10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <TextBox Text="{Binding AddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Height="26"
                     VerticalContentAlignment="Center"
                     Padding="10,0"
                     FontSize="14"
                     Background="Transparent">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding ApplyAddressCommand}"/>
                    <KeyBinding Key="Escape" Command="{Binding CancelAddressCommand}"/>
                </TextBox.InputBindings>
            </TextBox>

            <TextBlock Grid.Column="1"
                       Margin="12,0,6,0"
                       VerticalAlignment="Center"
                       Text="{Binding [Explorer.Filter], Source={StaticResource Res}}"/>
            <TextBox Grid.Column="2"
                     Height="26"
                     Padding="8,0"
                     VerticalContentAlignment="Center"
                     Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{Binding [Explorer.FilterHint], Source={StaticResource Res}}"/>
        </Grid>

        <!-- 4. Основная область: Navigation Pane слева + File View справа -->
        <Grid Grid.Row="3">

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="leftcolumn"  Width="{Binding LeftColumnPercent, Converter={markup:ResolveConverter ConverterType={x:Type converters:PercentToGridLengthConverter}},ConverterParameter={markup:ResolveViewModel ViewModelType={x:Type interfaces:IFileExplorerViewModel}},Mode=TwoWay, UpdateSourceTrigger= PropertyChanged}"/>

                <ColumnDefinition Width="3"/>
                <!-- Разделитель. -->

                <ColumnDefinition Width="*"/>
                <!-- Список файлов. -->

                <ColumnDefinition Width="3"/>
                <!-- Разделитель. -->

                <ColumnDefinition  Width="{Binding RightColumnPercent, Converter={markup:ResolveConverter ConverterType={x:Type converters:PercentToGridLengthConverter}},ConverterParameter={markup:ResolveViewModel ViewModelType={x:Type interfaces:IFileExplorerViewModel}},Mode=TwoWay, UpdateSourceTrigger= PropertyChanged}"/>
                <!-- Необязательная панель сведений. -->

            </Grid.ColumnDefinitions>

            <!-- Navigation Pane (левая панель) -->
            <TreeView x:Name="treeView" Grid.Column="0"
                      ItemsSource="{Binding GetDrives}"
                      VirtualizingPanel.IsContainerVirtualizable="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      HorizontalAlignment="Stretch">

                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem"
                           BasedOn="{StaticResource DiskTree_TreeViewItemStyle}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded,UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}}"/>
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu Style="{StaticResource RichTextContextMenuStyle}">
                                    <ContextMenu.Resources>
                                        <Style TargetType="{x:Type MenuItem}"
                                               BasedOn="{StaticResource RichTextContextMenuItemStyle}"/>
                                        <Style TargetType="{x:Type Separator}"
                                               BasedOn="{StaticResource RichTextContextMenuSeparatorStyle}"/>
                                    </ContextMenu.Resources>
                                    <MenuItem Header="{Binding [Common.Open], Source={StaticResource Res}}"
                                              Command="{Binding PlacementTarget.Tag.OpenCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}, Converter={StaticResource SystemItemSelectionSnapshotConverter}}"/>
                                    <MenuItem Header="{Binding [Explorer.RevealInExplorer], Source={StaticResource Res}}"
                                              Command="{Binding PlacementTarget.Tag.RevealInExplorerCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}, Converter={StaticResource SystemItemSelectionSnapshotConverter}}"/>
                                    <MenuItem Header="{Binding [Explorer.CopyPath], Source={StaticResource Res}}"
                                              Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}, Converter={StaticResource SystemItemSelectionSnapshotConverter}}"/>
                                    <Separator/>
                                    <MenuItem Header="{Binding [Common.Cut], Source={StaticResource Res}}"
                                              Command="{Binding PlacementTarget.Tag.CutCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}, Converter={StaticResource SystemItemSelectionSnapshotConverter}}"/>
                                    <MenuItem Header="{Binding [Common.Copy], Source={StaticResource Res}}"
                                              Command="{Binding PlacementTarget.Tag.CopyCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}, Converter={StaticResource SystemItemSelectionSnapshotConverter}}"/>
                                    <MenuItem Header="{Binding [Explorer.Move], Source={StaticResource Res}}"
                                              Command="{Binding PlacementTarget.Tag.MoveCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}, Converter={StaticResource SystemItemSelectionSnapshotConverter}}"/>
                                    <MenuItem Header="{Binding [Common.Rename], Source={StaticResource Res}}"
                                              Command="{Binding PlacementTarget.Tag.RenameClickCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}, Converter={StaticResource SystemItemSelectionSnapshotConverter}}"/>
                                    <MenuItem Header="{Binding [Common.Delete], Source={StaticResource Res}}"
                                              Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}, Converter={StaticResource SystemItemSelectionSnapshotConverter}}"/>
                                    <Separator/>
                                    <MenuItem Header="{Binding [Explorer.EncryptSelected], Source={StaticResource Res}}"
                                              Command="{Binding PlacementTarget.Tag.EncryptCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}, Converter={StaticResource SystemItemSelectionSnapshotConverter}}"/>
                                    <MenuItem Header="{Binding [Explorer.DecryptSelected], Source={StaticResource Res}}"
                                              Command="{Binding PlacementTarget.Tag.DecryptCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}, Converter={StaticResource SystemItemSelectionSnapshotConverter}}"/>
                                    <Separator/>
                                    <MenuItem Header="{Binding [Common.Refresh], Source={StaticResource Res}}"
                                              Command="{Binding PlacementTarget.Tag.RefreshCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Kind}" Value="File" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TreeView.ItemContainerStyle>
                <i:Interaction.Behaviors>
                    <behaviors:FileExplorerDragDropBehavior
                        DropCommand="{Binding DropCommand}"
                        DefaultDestinationPath="{Binding CurrentPath}"/>
                </i:Interaction.Behaviors>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectedItemChanged">
                        <i:InvokeCommandAction Command="{Binding TreeViewItemSelectedCommand, UpdateSourceTrigger=PropertyChanged}"
                                               CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeView}},Path=SelectedValue}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </TreeView>

            <GridSplitter Grid.Column="1"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Stretch"
                  Width="3"
                  ResizeBehavior="PreviousAndNext"
                  ResizeDirection="Columns"/>

            <!-- File List View (основная область файлов) -->
            <ListView x:Name="listview"
                      Grid.Column="2"
                      SelectionMode="Extended"
                      Background="{DynamicResource CurrentInputBackground}"
                      Foreground="{DynamicResource CurrentInputForeground}"
                      SelectedItem="{Binding SelectedListItem, Mode=TwoWay}"
                      ItemsSource="{Binding ChildrenView}"
                      VirtualizingPanel.IsContainerVirtualizable="True">
                <ListView.ContextMenu>
                    <ContextMenu Style="{StaticResource RichTextContextMenuStyle}">
                        <ContextMenu.Resources>
                            <Style TargetType="{x:Type MenuItem}"
                                   BasedOn="{StaticResource RichTextContextMenuItemStyle}"/>
                            <Style TargetType="{x:Type Separator}"
                                   BasedOn="{StaticResource RichTextContextMenuSeparatorStyle}"/>
                        </ContextMenu.Resources>
                        <MenuItem Header="{Binding [Explorer.CreateFile], Source={StaticResource Res}}"
                                  Command="{Binding PlacementTarget.DataContext.CreateFileCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                        <MenuItem Header="{Binding [Explorer.CreateFolder], Source={StaticResource Res}}"
                                  Command="{Binding PlacementTarget.DataContext.CreateDirectoryCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                        <Separator/>
                        <MenuItem Header="{Binding [Common.Paste], Source={StaticResource Res}}"
                                  Command="{Binding PlacementTarget.DataContext.PasteCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                        <MenuItem Header="{Binding [Explorer.CopyPath], Source={StaticResource Res}}"
                                  Command="{Binding PlacementTarget.DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}, Converter={StaticResource SystemItemSelectionSnapshotConverter}}"/>
                        <MenuItem Header="{Binding [Explorer.RevealInExplorer], Source={StaticResource Res}}"
                                  Command="{Binding PlacementTarget.DataContext.RevealInExplorerCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}, Converter={StaticResource SystemItemSelectionSnapshotConverter}}"/>
                        <Separator/>
                        <MenuItem Header="{Binding [Common.Refresh], Source={StaticResource Res}}"
                                  Command="{Binding PlacementTarget.DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView>
                        <GridViewColumn >
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Name" Content="{Binding [Explorer.Column.Name], Source={StaticResource Res}}" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True">
                                        <Image Width="16" Height="16" Margin="0,0,6,0"
                                               Source="{Binding FullPath, Converter={markup:ResolveConverter ConverterType={x:Type converters:PathToIconConverter}}}"/>
                                        <TextBlock Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Setter Property="TextWrapping" Value="NoWrap"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </DockPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn >
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="LastWriteTimeUtc" Content="{Binding [Explorer.Column.DateModified], Source={StaticResource Res}}" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="{Binding LastWriteTimeUtc,StringFormat={}{0:dd.MM.yyyy HH:mm:ss}, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn >
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Extension" Content="{Binding [Explorer.Column.Type], Source={StaticResource Res}}" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="{Binding Extension, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn>
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Size" Content="{Binding [Explorer.Column.Size], Source={StaticResource Res}}" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="{Binding Size, UpdateSourceTrigger=PropertyChanged, 
                                            Converter={markup:ResolveConverter ConverterType={x:Type converters:BytesToGbConverter}}}" >
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ., Converter={markup:ResolveConverter 
                                                            ConverterType={x:Type converters:TypeCheckConverter}},ConverterParameter={x:Type interfaces:IDirectoryItem}, UpdateSourceTrigger=PropertyChanged}"
                                                                     Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem"
                           BasedOn="{StaticResource FileExplorerListViewItemStyle}">
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                         <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                         <Setter Property="FontWeight" Value="Medium"/>
                         <Setter Property="FontSize" Value="16"/>
                         <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"/>
                         <Setter Property="ContextMenu">
                             <Setter.Value>
                                 <ContextMenu Style="{StaticResource RichTextContextMenuStyle}">
                                     <ContextMenu.Resources>
                                         <Style TargetType="{x:Type MenuItem}"
                                                BasedOn="{StaticResource RichTextContextMenuItemStyle}"/>
                                         <Style TargetType="{x:Type Separator}"
                                                BasedOn="{StaticResource RichTextContextMenuSeparatorStyle}"/>
                                     </ContextMenu.Resources>
                                     <MenuItem Header="{Binding [Common.Open], Source={StaticResource Res}}"
                                               Command="{Binding PlacementTarget.Tag.OpenCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                               CommandParameter="{Binding PlacementTarget.Tag.SelectedItemsSnapshot, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                     <MenuItem Header="{Binding [Explorer.OpenWith], Source={StaticResource Res}}"
                                               Command="{Binding PlacementTarget.Tag.OpenWithCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                               CommandParameter="{Binding PlacementTarget.Tag.SelectedItemsSnapshot, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                     <MenuItem Header="{Binding [Explorer.RevealInExplorer], Source={StaticResource Res}}"
                                               Command="{Binding PlacementTarget.Tag.RevealInExplorerCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                               CommandParameter="{Binding PlacementTarget.Tag.SelectedItemsSnapshot, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                     <MenuItem Header="{Binding [Explorer.CopyPath], Source={StaticResource Res}}"
                                               Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                               CommandParameter="{Binding PlacementTarget.Tag.SelectedItemsSnapshot, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                     <Separator/>
                                     <MenuItem Header="{Binding [Common.Cut], Source={StaticResource Res}}"
                                               Command="{Binding PlacementTarget.Tag.CutCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                               CommandParameter="{Binding PlacementTarget.Tag.SelectedItemsSnapshot, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                     <MenuItem Header="{Binding [Common.Copy], Source={StaticResource Res}}"
                                               Command="{Binding PlacementTarget.Tag.CopyCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                               CommandParameter="{Binding PlacementTarget.Tag.SelectedItemsSnapshot, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                     <MenuItem Header="{Binding [Explorer.Move], Source={StaticResource Res}}"
                                               Command="{Binding PlacementTarget.Tag.MoveCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                               CommandParameter="{Binding PlacementTarget.Tag.SelectedItemsSnapshot, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                     <MenuItem Header="{Binding [Common.Rename], Source={StaticResource Res}}"
                                               Command="{Binding PlacementTarget.Tag.RenameClickCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                               CommandParameter="{Binding PlacementTarget.Tag.SelectedItemsSnapshot, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                     <MenuItem Header="{Binding [Common.Delete], Source={StaticResource Res}}"
                                               Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                               CommandParameter="{Binding PlacementTarget.Tag.SelectedItemsSnapshot, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                     <Separator/>
                                     <MenuItem Header="{Binding [Explorer.EncryptSelected], Source={StaticResource Res}}"
                                               Command="{Binding PlacementTarget.Tag.EncryptCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                               CommandParameter="{Binding PlacementTarget.Tag.SelectedItemsSnapshot, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                     <MenuItem Header="{Binding [Explorer.DecryptSelected], Source={StaticResource Res}}"
                                               Command="{Binding PlacementTarget.Tag.DecryptCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                               CommandParameter="{Binding PlacementTarget.Tag.SelectedItemsSnapshot, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                 </ContextMenu>
                             </Setter.Value>
                         </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding RenameCommand}" CommandParameter="{Binding SelectedItem,
                        RelativeSource={RelativeSource AncestorType=ListView}}"/>
                    <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}" CommandParameter="{Binding SelectedItem,
                        RelativeSource={RelativeSource AncestorType=ListView}}" />
                </ListView.InputBindings>
                <i:Interaction.Behaviors>
                    <behaviors:GridViewColumnRatioBehavior
                        ViewId="FileExplorer.MainGrid"
                        MinColumnWidth="60"
                        ReflowOnSizeChanged="True"
                        ReflowOnScrollViewerChanged="True"
                        SaveDebounceMs="400"
                        Store="{markup:ResolveService ServiceType={x:Type interfaces:IColumnLayoutStore}}" />
                    <behaviors:ListViewSortedBehavior/>
                    <behaviors:ListViewSelectionSnapshotBehavior
                        SelectionSnapshot="{Binding SelectedItemsSnapshot, Mode=TwoWay}"/>
                    <behaviors:FileExplorerDragDropBehavior
                        DropCommand="{Binding DropCommand}"
                        DefaultDestinationPath="{Binding CurrentPath}"/>
                </i:Interaction.Behaviors>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <i:InvokeCommandAction Command="{Binding ListViewItemDoubleClickCommand, UpdateSourceTrigger=PropertyChanged}"
                                               CommandParameter="{Binding SelectedItemsSnapshot}"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding ListViewSelectionChangedCommand, UpdateSourceTrigger=PropertyChanged}" CommandParameter="{Binding SelectedValue, ElementName=listview}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ListView>

            <Border Grid.Column="2"
                    Panel.ZIndex="10"
                    Background="{DynamicResource CurrentInputBackground}"
                    BorderBrush="{DynamicResource CurrentBorderColor}"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrentDirectoryUnavailable}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="420"
                            Margin="24">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Text="{Binding [Explorer.Navigation.Unavailable], Source={StaticResource Res}}"/>
                    <TextBlock Margin="0,8,0,16"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource CurrentMutedForeground}"
                               Text="{Binding NavigationErrorMessage}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button Margin="0,0,8,0"
                                Command="{Binding RetryNavigationCommand}"
                                Content="{Binding [Explorer.Navigation.Retry], Source={StaticResource Res}}"
                                Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button Command="{Binding UpCommand}"
                                Content="{Binding [Common.Up], Source={StaticResource Res}}"
                                Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <GridSplitter Grid.Column="3"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Stretch"
                  Width="3"
                  ResizeBehavior="PreviousAndNext"
                  ResizeDirection="Columns"/>

            <!-- Details Pane: сведения и предварительный просмотр -->
            <Border Grid.Column="4"
                    Background="{DynamicResource CurrentControlBackground}"
                    BorderBrush="{DynamicResource CurrentBorderColor}"
                    BorderThickness="1,0,0,0"
                    HorizontalAlignment="Stretch">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock FontWeight="SemiBold"
                               FontSize="16"
                               Text="{Binding Preview.FileName}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Preview.FileName}"/>
                    <TextBlock Grid.Row="1"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource CurrentMutedForeground}"
                               FontSize="11"
                               Text="{Binding Preview.FileDetails}"
                               TextWrapping="Wrap"/>

                    <Grid Grid.Row="3">
                        <ProgressBar Height="3"
                                     VerticalAlignment="Top"
                                     IsIndeterminate="True">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Preview.PreviewKind}"
                                                     Value="{x:Static dto:FilePreviewKind.Loading}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>

                        <Image Source="{Binding Preview.Image}"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Preview.PreviewKind}"
                                                     Value="{x:Static dto:FilePreviewKind.Image}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>

                        <TextBox Text="{Binding Preview.Text, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="NoWrap"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource CurrentInputForeground}"
                                 CaretBrush="{DynamicResource CurrentInputForeground}"
                                 SelectionBrush="{DynamicResource CurrentSelectionBackground}"
                                 SelectionTextBrush="{DynamicResource CurrentSelectionForeground}"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Preview.PreviewKind}"
                                                     Value="{x:Static dto:FilePreviewKind.Text}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource CurrentMutedForeground}"
                                   Text="{Binding Preview.Message}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Preview.PreviewKind}"
                                                     Value="{x:Static dto:FilePreviewKind.Text}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Preview.PreviewKind}"
                                                     Value="{x:Static dto:FilePreviewKind.Image}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

        </Grid>
        <Border Grid.Row="4"
                BorderBrush="{DynamicResource CurrentBorderColor}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding [Explorer.Selected], Source={StaticResource Res}}"
                           Foreground="{DynamicResource CurrentWindowForeground}"
                           FontSize="16"
                           Margin="0,0,4,0"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding SelectedItem.FullPath, ElementName=listview}"
                           Foreground="{DynamicResource CurrentWindowForeground}"
                           FontSize="16"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <Border Grid.Row="5"
                Margin="0,8,0,0"
                Padding="10"
                Background="{DynamicResource CurrentControlBackground}"
                BorderBrush="{DynamicResource CurrentBorderColor}"
                BorderThickness="1"
                CornerRadius="5">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPickerMode}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Margin="4,0,12,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource CurrentWindowForeground}"
                           Text="{Binding PickerSelectionPath}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding PickerSelectionPath}"/>
                <Button Grid.Column="1"
                        MinWidth="110"
                        Margin="0,0,8,0"
                        Command="{Binding ConfirmSelectionCommand}"
                        Content="{Binding PickerActionText}"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}"/>
                <Button Grid.Column="2"
                        MinWidth="90"
                        Command="{Binding CancelSelectionCommand}"
                        Content="{Binding [Common.Cancel], Source={StaticResource Res}}"/>
            </Grid>
        </Border>

    </Grid>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Loaded, UpdateSourceTrigger=PropertyChanged}"/>
        </i:EventTrigger>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding Closing, UpdateSourceTrigger=PropertyChanged}"/>
        </i:EventTrigger>
        <i:EventTrigger EventName="SizeChanged">
            <i:InvokeCommandAction Command="{Binding WindowSizeChangedCommand, UpdateSourceTrigger=PropertyChanged}"/>
        </i:EventTrigger>
        <i:EventTrigger EventName="Closed">
            <i:InvokeCommandAction Command="{Binding Closed, UpdateSourceTrigger=PropertyChanged}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
</Window>
