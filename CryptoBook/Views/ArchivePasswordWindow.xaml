<Window x:Class="CryptoBook.Views.ArchivePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:markup="clr-namespace:CryptoBook.Markup"
        xmlns:vm="clr-namespace:CryptoBook.ViewModels"
        xmlns:behaviors="clr-namespace:CryptoBook.Behaviors"
        Title="{Binding [Archive.Open], Source={StaticResource Res}}"
        Width="480" SizeToContent="Height" MinWidth="400" MaxHeight="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" FocusManager.FocusedElement="{Binding ElementName=ArchivePassword}"
        Background="{DynamicResource CurrentWindowBackground}" Foreground="{DynamicResource CurrentWindowForeground}">
    <Window.DataContext><markup:ResolveViewModel ViewModelType="{x:Type vm:ArchivePasswordViewModel}"/></Window.DataContext>
    <StackPanel Margin="20">
        <TextBlock Text="{Binding Source}" TextWrapping="Wrap" MaxHeight="70" Margin="0,0,0,12"/>
        <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <PasswordBox x:Name="ArchivePassword" Padding="6,5" MinHeight="28"
                     Background="{DynamicResource CurrentInputBackground}" Foreground="{DynamicResource CurrentInputForeground}"
                     BorderBrush="{DynamicResource CurrentBorderColor}"
                     AutomationProperties.Name="{Binding [Archive.Password], Source={StaticResource Res}}">
            <i:Interaction.Behaviors>
                <behaviors:SecurePasswordValueBehavior Value="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </i:Interaction.Behaviors>
        </PasswordBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{Binding [Archive.Open], Source={StaticResource Res}}" Command="{Binding AcceptCommand}"
                    IsDefault="True" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="{Binding [Common.Cancel], Source={StaticResource Res}}" Command="{Binding CancelCommand}"
                    IsCancel="True" Padding="12,6"/>
        </StackPanel>
    </StackPanel>
    <Window.InputBindings><KeyBinding Key="Escape" Command="{Binding CancelCommand}"/></Window.InputBindings>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closed"><i:InvokeCommandAction Command="{Binding Closed}"/></i:EventTrigger>
    </i:Interaction.Triggers>
</Window>
