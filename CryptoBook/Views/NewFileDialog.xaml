<Window x:Class="CryptoBook.Views.NewFileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:interfaces="clr-namespace:CryptoBook.Interfaces"
        xmlns:markup="clr-namespace:CryptoBook.Markup"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding [File.NewTitle], Source={StaticResource Res}}"
        Width="640"
        Height="540"
        MinWidth="560"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource CurrentWindowBackground}"
        Foreground="{DynamicResource CurrentWindowForeground}"
        d:DataContext="{x:Type interfaces:INewFileDialogViewModel}">
    <Window.DataContext>
        <markup:ResolveViewModel ViewModelType="{x:Type interfaces:INewFileDialogViewModel}"/>
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource CurrentWindowForeground}"/>
        </Style>
        <Style x:Key="NewFileDialogComboBoxItemStyle"
               TargetType="ComboBoxItem"
               BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="Padding" Value="10,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24" FocusManager.FocusedElement="{Binding ElementName=FileNameTextBox}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="48"
                    Height="48"
                    CornerRadius="10"
                    Background="{DynamicResource CurrentSelectionBackground}">
                <Viewbox Width="25" Height="25">
                    <Path Data="M3,1 L11,1 L15,5 L15,19 L3,19 Z M11,1 L11,5 L15,5 M9,9 L9,15 M6,12 L12,12"
                          Stroke="{DynamicResource CurrentSelectionForeground}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Fill="Transparent"/>
                </Viewbox>
            </Border>

            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding [File.NewTitle], Source={StaticResource Res}}"
                           FontSize="22"
                           FontWeight="SemiBold"/>
                <TextBlock Margin="0,4,0,0"
                           Text="{Binding [File.NewDescription], Source={StaticResource Res}}"
                           Foreground="{DynamicResource CurrentDisabledForeground}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Padding="18"
                CornerRadius="10"
                Background="{DynamicResource CurrentControlBackground}"
                BorderBrush="{DynamicResource CurrentBorderColor}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="34"/>
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource FieldLabelStyle}"
                           Text="{Binding [File.Folder], Source={StaticResource Res}}"/>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Padding="10,0"
                            CornerRadius="5"
                            Background="{DynamicResource CurrentInputBackground}"
                            BorderBrush="{DynamicResource CurrentBorderColor}"
                            BorderThickness="1">
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding TargetDirectory}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding TargetDirectory}"/>
                    </Border>
                    <Button Grid.Column="2"
                            Width="112"
                            Content="{Binding [Common.Browse], Source={StaticResource Res}}"
                            Command="{Binding Browse}"/>
                </Grid>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                               Text="{Binding [File.Type], Source={StaticResource Res}}"/>
                    <TextBlock Grid.Column="2"
                               Style="{StaticResource FieldLabelStyle}"
                               Text="{Binding [File.Extension], Source={StaticResource Res}}"/>
                </Grid>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Height="34"
                              Style="{StaticResource DropUpComboBoxStyle}"
                              ItemContainerStyle="{StaticResource NewFileDialogComboBoxItemStyle}"
                              ItemsSource="{Binding Templates}"
                              DisplayMemberPath="DisplayName"
                              MaxDropDownHeight="360"
                              SelectedItem="{Binding SelectedTemplate, UpdateSourceTrigger=PropertyChanged}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding SelectedNewTemplate}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>
                    <ComboBox Grid.Column="2"
                              Height="34"
                              Style="{StaticResource DropUpComboBoxStyle}"
                              ItemContainerStyle="{StaticResource NewFileDialogComboBoxItemStyle}"
                              ItemsSource="{Binding SelectedTemplate.Extensions, Mode=OneWay}"
                              SelectedItem="{Binding SelectedTemplate.DefaultExtension, Mode=OneWay}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding SelectedNewExtension}"
                                                       CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}, Path=SelectedItem}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>
                </Grid>

                <TextBlock Grid.Row="8"
                           Style="{StaticResource FieldLabelStyle}"
                           Text="{Binding [File.Name], Source={StaticResource Res}}"/>
                <TextBox x:Name="FileNameTextBox"
                         Grid.Row="10"
                         MinHeight="34"
                         Padding="9,5"
                         VerticalContentAlignment="Center"
                         Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Padding="18,14"
                CornerRadius="10"
                Background="{DynamicResource CurrentControlBackground}"
                BorderBrush="{DynamicResource CurrentBorderColor}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource FieldLabelStyle}"
                           Text="{Binding [File.Attributes], Source={StaticResource Res}}"/>
                <CheckBox Grid.Column="2"
                          VerticalAlignment="Center"
                          Content="{Binding [File.ReadOnlyAttribute], Source={StaticResource Res}}"
                          IsChecked="{Binding IsReadOnly, UpdateSourceTrigger=PropertyChanged}"/>
                <CheckBox Grid.Column="4"
                          VerticalAlignment="Center"
                          Content="{Binding [File.HiddenAttribute], Source={StaticResource Res}}"
                          IsChecked="{Binding IsHidden, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="5" Margin="0,10,0,10">
            <TextBlock VerticalAlignment="Center"
                       Foreground="{DynamicResource CurrentErrorForeground}"
                       Text="{Binding ErrorMessage, Mode=OneWay}"
                       TextWrapping="Wrap"/>
        </Grid>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="112"
                    Margin="0,0,10,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="{Binding [SideMenu.Create], Source={StaticResource Res}}"
                    IsDefault="True"
                    Command="{Binding Create}"/>
            <Button Width="100"
                    Content="{Binding [Common.Cancel], Source={StaticResource Res}}"
                    IsCancel="True"
                    Command="{Binding Cancel}"/>
        </StackPanel>
    </Grid>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding Closing}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
</Window>
