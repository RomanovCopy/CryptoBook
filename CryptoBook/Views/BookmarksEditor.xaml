<Window x:Class="CryptoBook.Views.BookmarksEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:markup="clr-namespace:CryptoBook.Markup"
        xmlns:interfaces="clr-namespace:CryptoBook.Interfaces"
        mc:Ignorable="d"
        MinHeight="360"
        MinWidth="560"
        Background="{DynamicResource CurrentWindowBackground}"
        Foreground="{DynamicResource CurrentWindowForeground}"
        BorderBrush="{DynamicResource CurrentBorderColor}"
        BorderThickness="1"
        d:DataContext="{markup:ResolveViewModel ViewModelType={x:Type interfaces:IBookmarksEditorViewModel}}"
        Icon="/CryptoBook;component/Resources/Icons/icon002.ico"
        Title="{Binding [Bookmarks.Title], Source={StaticResource Res}}">

    <Window.DataContext>
        <markup:ResolveViewModel ViewModelType="{x:Type interfaces:IBookmarksEditorViewModel}"/>
    </Window.DataContext>

    <Window.Width>
        <Binding Path="Width" Mode="TwoWay"/>
    </Window.Width>
    <Window.Height>
        <Binding Path="Height" Mode="TwoWay"/>
    </Window.Height>
    <Window.Top>
        <Binding Path="WindowTop" Mode="TwoWay"/>
    </Window.Top>
    <Window.Left>
        <Binding Path="WindowLeft" Mode="TwoWay"/>
    </Window.Left>
    <Window.WindowState>
        <Binding Path="WindowState" Mode="TwoWay"/>
    </Window.WindowState>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                BorderBrush="{DynamicResource CurrentBorderColor}"
                BorderThickness="1"
                CornerRadius="7"
                Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Margin="4,2,4,7">
                    <TextBlock Text="{Binding [Bookmarks.Title], Source={StaticResource Res}}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Bookmarks.Count, StringFormat= ({0})}"
                               Margin="4,0,0,0"
                               VerticalAlignment="Center"
                               Opacity="0.65"/>
                </DockPanel>

                <ListBox x:Name="BookmarksList"
                         Grid.Row="1"
                         ItemsSource="{Binding Bookmarks}"
                         SelectedItem="{Binding SelectedBookmark, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="3">
                                <Path Data="{StaticResource Icon.Bookmark}"
                                      Style="{StaticResource EditorToolbarSmallIconStyle}"/>
                                <TextBlock Text="{Binding Name}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem"
                               BasedOn="{StaticResource bokmarksEditorNames}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseDoubleClick">
                            <i:InvokeCommandAction Command="{Binding NavigateTo}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </ListBox>

                <Button Grid.Row="2"
                        Style="{StaticResource EditorToolButtonStyle}"
                        Width="Auto"
                        Height="32"
                        HorizontalAlignment="Stretch"
                        Command="{Binding RebuildIndexFromDocument}"
                        ToolTip="{Binding [Bookmarks.RefreshIndex], Source={StaticResource Res}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Refresh}"
                              Style="{StaticResource EditorToolbarSmallIconStyle}"/>
                        <TextBlock Text="{Binding [Bookmarks.Refresh], Source={StaticResource Res}}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1"
                      Width="4"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource CurrentControlHoverBackground}"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"/>

        <Border Grid.Column="2"
                BorderBrush="{DynamicResource CurrentBorderColor}"
                BorderThickness="1"
                CornerRadius="7"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding [Bookmarks.Properties], Source={StaticResource Res}}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <TextBlock Grid.Row="1"
                           Text="{Binding [Bookmarks.Name], Source={StaticResource Res}}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <DockPanel Grid.Row="2" LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource EditorToolButtonStyle}"
                            Command="{Binding Remove}"
                            ToolTip="{Binding [Bookmarks.DeleteSelected], Source={StaticResource Res}}">
                        <Path Data="{StaticResource Icon.BookmarkRemove}"
                              Style="{StaticResource EditorToolbarIconStyle}"/>
                    </Button>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource EditorToolButtonStyle}"
                            Command="{Binding Rename}"
                            ToolTip="{Binding [Bookmarks.RenameSelected], Source={StaticResource Res}}">
                        <Path Data="{StaticResource Icon.BookmarkRename}"
                              Style="{StaticResource EditorToolbarIconStyle}"/>
                    </Button>
                    <TextBox Text="{Binding RenameTo, UpdateSourceTrigger=PropertyChanged}"
                             Padding="7,5"
                             Margin="0,3,3,3"
                             VerticalContentAlignment="Center"/>
                </DockPanel>

                <Grid Grid.Row="3" Margin="0,8,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding [Bookmarks.Note], Source={StaticResource Res}}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4"/>
                    <TextBox Grid.Row="1"
                             Text="{Binding SelectedBookmark.Note, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Padding="7"
                             MinHeight="90"/>
                </Grid>

                <TextBlock Grid.Row="4"
                           TextTrimming="CharacterEllipsis"
                           Opacity="0.65"
                           Margin="0,0,0,7">
                    <Run Text="{Binding [Bookmarks.Anchor], Source={StaticResource Res}}"/>
                    <Run Text="{Binding SelectedBookmark.BookmarkUriString}"/>
                </TextBlock>

                <DockPanel Grid.Row="5" LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource EditorToolButtonStyle}"
                            Command="{Binding InsertHyperlinkTo}"
                            ToolTip="{Binding [Bookmarks.InsertSelectedLink], Source={StaticResource Res}}">
                        <Path Data="{StaticResource Icon.Link}"
                              Style="{StaticResource EditorToolbarIconStyle}"/>
                    </Button>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource EditorToolButtonStyle}"
                            Command="{Binding NavigateTo}"
                            ToolTip="{Binding [Bookmarks.GoToSelected], Source={StaticResource Res}}">
                        <Path Data="{StaticResource Icon.Bookmark}"
                              Style="{StaticResource EditorToolbarIconStyle}"/>
                    </Button>
                    <TextBox Text="{Binding LinkText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="7,5"
                             Margin="0,3,3,3"
                             ToolTip="{Binding [Bookmarks.LinkTextHint], Source={StaticResource Res}}"/>
                </DockPanel>

                <TextBlock Grid.Row="6"
                           Text="{Binding StatusMessage}"
                           Margin="2,7,2,0"
                           TextWrapping="Wrap"
                           Opacity="0.8"/>
            </Grid>
        </Border>

        <Button Grid.Row="1"
                Grid.Column="2"
                Style="{StaticResource EditorToolButtonStyle}"
                Width="90"
                Height="32"
                Margin="0,10,0,0"
                HorizontalAlignment="Right"
                Command="{Binding Close}"
                Content="{Binding [Common.Close], Source={StaticResource Res}}"/>
    </Grid>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Loaded}"/>
        </i:EventTrigger>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding Closing}"/>
        </i:EventTrigger>
        <i:EventTrigger EventName="Closed">
            <i:InvokeCommandAction Command="{Binding Closed}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
</Window>
