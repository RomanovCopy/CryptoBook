<Window x:Class="CryptoBook.Views.EncryptionModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:markup="clr-namespace:CryptoBook.Markup"
        xmlns:vm="clr-namespace:CryptoBook.ViewModels"
        xmlns:interfaces="clr-namespace:CryptoBook.Interfaces"
        xmlns:converters="clr-namespace:CryptoBook.Converters"
        xmlns:security="clr-namespace:CryptoBook.Security"
        xmlns:local="clr-namespace:CryptoBook.Views"
        mc:Ignorable="d"
        d:DataContext="{x:Type interfaces:IEncryptionMode_ViewModel}"
        Background="{DynamicResource CurrentWindowBackground}"
        Foreground="{DynamicResource CurrentWindowForeground}"
        WindowStartupLocation="CenterOwner"
        MinHeight="280" MinWidth="450">
    <Window.DataContext>
        <markup:ResolveViewModel ViewModelType="{x:Type interfaces:IEncryptionMode_ViewModel}" />
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="EncryptionModeRadioButtonStyle"
               TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground"
                    Value="{DynamicResource CurrentWindowForeground}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Grid Background="{TemplateBinding Background}"
                              SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Width="18"
                                  Height="18"
                                  VerticalAlignment="Center">
                                <Ellipse x:Name="OuterCircle"
                                         Fill="{DynamicResource CurrentInputBackground}"
                                         Stroke="{DynamicResource CurrentBorderColor}"
                                         StrokeThickness="2"/>
                                <Ellipse x:Name="InnerCircle"
                                         Width="8"
                                         Height="8"
                                         Fill="{DynamicResource CurrentAccent}"
                                         Visibility="Collapsed"/>
                            </Grid>

                            <ContentPresenter Grid.Column="1"
                                              Margin="8,0,0,0"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="InnerCircle"
                                        Property="Visibility"
                                        Value="Visible"/>
                                <Setter TargetName="OuterCircle"
                                        Property="Stroke"
                                        Value="{DynamicResource CurrentAccent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterCircle"
                                        Property="Stroke"
                                        Value="{DynamicResource CurrentAccent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="OuterCircle"
                                        Property="StrokeThickness"
                                        Value="3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource CurrentDisabledForeground}"/>
                                <Setter Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>


    <Window.Title>
        <Binding Path="[EncryptionMode.Title]" Source="{StaticResource Res}"/>
    </Window.Title>

    <Window.Width>
        <Binding Path="WindowWidth"  Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
    </Window.Width>
    <Window.Height>
        <Binding Path="WindowHeight"  Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
    </Window.Height>
    <Window.Top>
        <Binding Path="WindowTop"  Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
    </Window.Top>
    <Window.Left >
        <Binding Path="WindowLeft"  Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
    </Window.Left>
    <Window.WindowState>
        <Binding Path="WindowState" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
    </Window.WindowState>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Text="{Binding [EncryptionMode.Prompt], Source={StaticResource Res}}"
                   Foreground="{DynamicResource CurrentWindowForeground}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   FontSize="16"
                   FontWeight="DemiBold"/>
        <StackPanel Margin="10" Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <!-- Свойство GroupName объединяет кнопки в один переключатель -->
            <RadioButton x:Name="SaveAsRadioButton"
                         Content="{Binding [EncryptionMode.SaveAs], Source={StaticResource Res}}"
                         Style="{StaticResource EncryptionModeRadioButtonStyle}"
                         GroupName="EncriptedMode" Margin="10,10,10,5" FontSize="16" FontWeight="DemiBold" FontStyle="Italic"
                         VerticalContentAlignment="Center"
                         IsChecked="{Binding SelectedMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,
                Converter={markup:ResolveConverter ConverterType={x:Type converters:EnumToBoolConverter}}, 
                ConverterParameter={x:Static security:EncryptionTargetMode.SaveAs}}" />

            <RadioButton x:Name="ReplaceSourceRadioButton"
                         Content="{Binding [EncryptionMode.ReplaceSource], Source={StaticResource Res}}"
                         Style="{StaticResource EncryptionModeRadioButtonStyle}"
                         GroupName="EncriptedMode" Margin="10,5,10,20" FontSize="16" FontWeight="DemiBold" FontStyle="Italic"
                         VerticalContentAlignment="Center"
                         IsChecked="{Binding SelectedMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,
                Converter={markup:ResolveConverter ConverterType={x:Type converters:EnumToBoolConverter}}, 
                ConverterParameter={x:Static security:EncryptionTargetMode.ReplaceSource}}" />

        </StackPanel>
        <TextBlock Grid.Row="2" HorizontalAlignment="Stretch" TextWrapping="NoWrap" 
                   Text="{Binding ProcessedItem.FullPath, UpdateSourceTrigger=PropertyChanged,Mode=OneWay}" 
                   Foreground="{DynamicResource CurrentMutedForeground}"
                   FontSize="16" FontWeight="DemiBold" FontStyle="Italic" Margin="20,10,20,10"/>
        
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                
        <Button x:Name="btnOk" Content="{Binding [Common.OK], Source={StaticResource Res}}"
                        Grid.Column="0" HorizontalAlignment="Center" Margin="20"
                        Command="{Binding ButtonOk,UpdateSourceTrigger=PropertyChanged}" />
        <Button x:Name="btnCancel" Content="{Binding [Common.Cancel], Source={StaticResource Res}}"
                        Grid.Column="1" HorizontalAlignment="Center" Margin="20"
                        Command="{Binding ButtonCancel, UpdateSourceTrigger=PropertyChanged}"/>

        </StackPanel>
    </Grid>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Loaded, UpdateSourceTrigger=PropertyChanged}" />
        </i:EventTrigger>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding Closing, UpdateSourceTrigger=PropertyChanged}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
</Window>
