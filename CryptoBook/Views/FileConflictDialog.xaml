<Window x:Class="CryptoBook.Views.FileConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560"
        Height="260"
        MinWidth="480"
        MinHeight="230"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CurrentWindowBackground}"
        Foreground="{DynamicResource CurrentWindowForeground}"
        ResizeMode="NoResize"
        Title="{Binding Title}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock FontSize="16"
                   FontWeight="SemiBold"
                   Text="{Binding Message}"
                   TextWrapping="Wrap"/>
        <StackPanel Grid.Row="2">
            <TextBlock Foreground="{DynamicResource CurrentMutedForeground}"
                       Text="{Binding SourcePath}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding SourcePath}"/>
            <TextBlock Margin="0,4,0,0"
                       Foreground="{DynamicResource CurrentMutedForeground}"
                       Text="{Binding DestinationPath}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding DestinationPath}"/>
        </StackPanel>

        <CheckBox Grid.Row="3"
                  Margin="0,14,0,0"
                  VerticalAlignment="Top"
                  Content="{Binding [Explorer.Conflict.ApplyToAll], Source={StaticResource Res}}"
                  IsChecked="{Binding ApplyToAll}"/>

        <WrapPanel Grid.Row="4" HorizontalAlignment="Right">
            <Button MinWidth="105"
                    Margin="0,0,8,0"
                    Content="{Binding [Explorer.Conflict.Replace], Source={StaticResource Res}}"
                    Command="{Binding ReplaceCommand}"/>
            <Button MinWidth="105"
                    Margin="0,0,8,0"
                    Content="{Binding [Explorer.Conflict.Skip], Source={StaticResource Res}}"
                    Command="{Binding SkipCommand}"/>
            <Button MinWidth="105"
                    Margin="0,0,8,0"
                    Content="{Binding [Explorer.Conflict.KeepBoth], Source={StaticResource Res}}"
                    Command="{Binding KeepBothCommand}"/>
            <Button MinWidth="90"
                    IsCancel="True"
                    Content="{Binding [Common.Cancel], Source={StaticResource Res}}"
                    Command="{Binding CancelCommand}"/>
        </WrapPanel>
    </Grid>
</Window>
