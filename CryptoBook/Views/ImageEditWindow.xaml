<Window x:Class="CryptoBook.Views.ImageEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:markup="clr-namespace:CryptoBook.Markup"
        xmlns:infra="clr-namespace:CryptoBook.Infrastructure"
        xmlns:vm="clr-namespace:CryptoBook.ViewModels"
        Title="{Binding [ImageEdit.Title], Source={StaticResource Res}}"
        Width="980" Height="680" MinWidth="740" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CurrentWindowBackground}"
        Foreground="{DynamicResource CurrentWindowForeground}">
    <Window.DataContext>
        <markup:ResolveViewModel ViewModelType="{x:Type vm:ImageEditViewModel}"/>
    </Window.DataContext>
    <Window.Resources>
        <infra:ResourceWrapper x:Key="Res"/>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style x:Key="SizeField" TargetType="TextBox">
            <Setter Property="Margin" Value="0,5,0,12"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="{DynamicResource CurrentInputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource CurrentInputForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CurrentBorderColor}"/>
        </Style>
    </Window.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded"><i:InvokeCommandAction Command="{Binding Loaded}"/></i:EventTrigger>
        <i:EventTrigger EventName="Closing"><i:InvokeCommandAction Command="{Binding Closing}" PassEventArgsToCommand="True"/></i:EventTrigger>
        <i:EventTrigger EventName="Closed"><i:InvokeCommandAction Command="{Binding Closed}"/></i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding SourceName}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
            <Border Background="#202020" Margin="0,0,18,0" ClipToBounds="True">
                <Grid>
                    <Image x:Name="PreviewImage" Source="{Binding Preview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <ProgressBar IsIndeterminate="True" Width="140" Height="6" VerticalAlignment="Bottom" Margin="12"
                                 Visibility="{Binding IsPreviewBusy, Converter={StaticResource BoolVisibility}}"/>
                </Grid>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0" IsEnabled="{Binding CanEdit}">
                    <DockPanel><TextBlock Text="{Binding [ImageEdit.Contrast], Source={StaticResource Res}}"/>
                        <TextBlock Text="{Binding Contrast, StringFormat={}{0:0}}" HorizontalAlignment="Right"/></DockPanel>
                    <Slider x:Name="ContrastSlider" Minimum="-100" Maximum="100" Value="{Binding Contrast}" Margin="0,6,0,16"/>
                    <DockPanel><TextBlock Text="{Binding [ImageEdit.Brightness], Source={StaticResource Res}}"/>
                        <TextBlock Text="{Binding Brightness, StringFormat={}{0:0}}" HorizontalAlignment="Right"/></DockPanel>
                    <Slider x:Name="BrightnessSlider" Minimum="-100" Maximum="100" Value="{Binding Brightness}" Margin="0,6,0,16"/>
                    <DockPanel><TextBlock Text="{Binding [ImageEdit.Saturation], Source={StaticResource Res}}"/>
                        <TextBlock Text="{Binding Saturation, StringFormat={}{0:0}}" HorizontalAlignment="Right"/></DockPanel>
                    <Slider x:Name="SaturationSlider" Minimum="-100" Maximum="100" Value="{Binding Saturation}" Margin="0,6,0,20"/>
                    <TextBlock Text="{Binding [ImageEdit.Width], Source={StaticResource Res}}"/>
                    <TextBox x:Name="WidthBox" Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SizeField}"/>
                    <TextBlock Text="{Binding [ImageEdit.Height], Source={StaticResource Res}}"/>
                    <TextBox x:Name="HeightBox" Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SizeField}"/>
                    <CheckBox x:Name="KeepAspectRatioBox" IsChecked="{Binding KeepAspectRatio}" Margin="0,0,0,12">
                        <TextBlock Text="{Binding [ImageEdit.KeepAspectRatio], Source={StaticResource Res}}" TextWrapping="Wrap"/>
                    </CheckBox>
                    <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding [ImageEdit.FormatHint], Source={StaticResource Res}}" TextWrapping="Wrap" Opacity="0.8"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="EncryptedHint" Text="{Binding [ImageEdit.EncryptedHint], Source={StaticResource Res}}"
                       TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding IsEncrypted, Converter={StaticResource BoolVisibility}}"/>
            <ProgressBar IsIndeterminate="True" Height="6" Margin="0,0,0,6"
                         Visibility="{Binding IsSaving, Converter={StaticResource BoolVisibility}}"/>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Button x:Name="ResetButton" Content="{Binding [ImageEdit.Reset], Source={StaticResource Res}}" Command="{Binding ResetCommand}"
                    HorizontalAlignment="Left" Padding="14,7"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SaveButton" Content="{Binding [Common.SaveAs], Source={StaticResource Res}}"
                        Command="{Binding SaveCommand}" Padding="14,7" Margin="0,0,10,0"/>
                <Button x:Name="CancelButton" Content="{Binding [Common.Cancel], Source={StaticResource Res}}" Command="{Binding Close}"
                        IsCancel="True" Padding="14,7"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
