<Window x:Class="CryptoBook.Views.DirectoryNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новая директория"
        Width="420"
        Height="170"
        MinWidth="360"
        MinHeight="150"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Введите имя новой директории:"/>
        <TextBox x:Name="DirectoryNameTextBox"
                 Grid.Row="2"
                 MinHeight="28"
                 VerticalContentAlignment="Center"
                 Text="{Binding DirectoryName, UpdateSourceTrigger=PropertyChanged}"/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Создать"
                    Width="90"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="CreateButton_Click"/>
            <Button Content="Отмена"
                    Width="90"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
