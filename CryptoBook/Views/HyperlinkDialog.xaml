<Window x:Class="CryptoBook.Views.HyperlinkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [Hyperlink.Title], Source={StaticResource Res}}"
        Width="460"
        Height="245"
        MinWidth="400"
        MinHeight="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding [Hyperlink.Address], Source={StaticResource Res}}"/>
        <TextBox x:Name="UrlTextBox"
                 Grid.Row="1"
                 MinHeight="28"
                 Margin="0,5,0,0"
                 VerticalContentAlignment="Center"
                 Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="3" Text="{Binding [Hyperlink.DisplayText], Source={StaticResource Res}}"/>
        <TextBox Grid.Row="4"
                 MinHeight="28"
                 Margin="0,5,0,0"
                 VerticalContentAlignment="Center"
                 Text="{Binding DisplayText, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock x:Name="ValidationMessage"
                   Grid.Row="5"
                   Margin="0,7,0,0"
                   Foreground="{DynamicResource CurrentErrorForeground}"
                   TextWrapping="Wrap"/>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="{Binding [Common.Insert], Source={StaticResource Res}}"
                    Width="90"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="InsertButton_Click"/>
            <Button Content="{Binding [Common.Cancel], Source={StaticResource Res}}"
                    Width="90"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
