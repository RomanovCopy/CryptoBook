<Window x:Class="CryptoBook.Views.DecryptionOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:markup="clr-namespace:CryptoBook.Markup"
        xmlns:vm="clr-namespace:CryptoBook.ViewModels"
        xmlns:converters="clr-namespace:CryptoBook.Converters"
        xmlns:security="clr-namespace:CryptoBook.Security"
        Background="{DynamicResource CurrentWindowBackground}"
        Foreground="{DynamicResource CurrentWindowForeground}"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="720"
        MinWidth="600"
        MaxHeight="760">
    <Window.DataContext>
        <markup:ResolveViewModel ViewModelType="{x:Type vm:DecryptionOptionsViewModel}" />
    </Window.DataContext>
    <Window.Resources>
        <Style x:Key="DecryptionOptionRadioButtonStyle"
               TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground"
                    Value="{DynamicResource CurrentWindowForeground}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="SelectionBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Width="18"
                                      Height="18"
                                      VerticalAlignment="Center">
                                    <Ellipse x:Name="OuterCircle"
                                             Fill="{DynamicResource CurrentInputBackground}"
                                             Stroke="{DynamicResource CurrentBorderColor}"
                                             StrokeThickness="2"/>
                                    <Ellipse x:Name="InnerCircle"
                                             Width="9"
                                             Height="9"
                                             Fill="{DynamicResource CurrentAccent}"
                                             Visibility="Collapsed"/>
                                </Grid>

                                <ContentPresenter Grid.Column="1"
                                                  Margin="8,0,0,0"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="FontWeight" Value="DemiBold"/>
                                <Setter TargetName="SelectionBorder"
                                        Property="Background"
                                        Value="{DynamicResource CurrentControlHoverBackground}"/>
                                <Setter TargetName="SelectionBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource CurrentAccent}"/>
                                <Setter TargetName="InnerCircle"
                                        Property="Visibility"
                                        Value="Visible"/>
                                <Setter TargetName="OuterCircle"
                                        Property="Stroke"
                                        Value="{DynamicResource CurrentAccent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectionBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource CurrentAccent}"/>
                                <Setter TargetName="OuterCircle"
                                        Property="Stroke"
                                        Value="{DynamicResource CurrentAccent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SelectionBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource CurrentAccent}"/>
                                <Setter TargetName="SelectionBorder"
                                        Property="BorderThickness"
                                        Value="3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource CurrentDisabledForeground}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                                <Setter Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.Title>
        <Binding Path="Title"/>
    </Window.Title>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="{Binding FormatSectionTitle}"
                           FontSize="17"
                           FontWeight="DemiBold"
                           Margin="0,0,0,10"/>

                <StackPanel Visibility="{Binding HasConvertibleFormats, Converter={markup:ResolveConverter ConverterType={x:Type converters:VisibilityConverter}}}">
                    <RadioButton GroupName="OutputFormat"
                                 Style="{StaticResource DecryptionOptionRadioButtonStyle}"
                                 Margin="0,5"
                                 IsChecked="{Binding SelectedOutputFormat, Mode=TwoWay,
                            Converter={markup:ResolveConverter ConverterType={x:Type converters:EnumToBoolConverter}},
                            ConverterParameter={x:Static security:DecryptionOutputFormat.Rtf}}">
                        <TextBlock Text="{Binding RtfLabel}" TextWrapping="Wrap"/>
                    </RadioButton>
                    <RadioButton GroupName="OutputFormat"
                                 Style="{StaticResource DecryptionOptionRadioButtonStyle}"
                                 Margin="0,5"
                                 IsChecked="{Binding SelectedOutputFormat, Mode=TwoWay,
                            Converter={markup:ResolveConverter ConverterType={x:Type converters:EnumToBoolConverter}},
                            ConverterParameter={x:Static security:DecryptionOutputFormat.PlainText}}">
                        <TextBlock Text="{Binding PlainTextLabel}" TextWrapping="Wrap"/>
                    </RadioButton>
                </StackPanel>

                <RadioButton GroupName="OutputFormat"
                             Style="{StaticResource DecryptionOptionRadioButtonStyle}"
                             Margin="0,5"
                             IsChecked="{Binding SelectedOutputFormat, Mode=TwoWay,
                        Converter={markup:ResolveConverter ConverterType={x:Type converters:EnumToBoolConverter}},
                        ConverterParameter={x:Static security:DecryptionOutputFormat.Original}}">
                    <TextBlock Text="{Binding OriginalLabel}" TextWrapping="Wrap"/>
                </RadioButton>
            </StackPanel>

            <Separator Grid.Row="1" Margin="0,16"/>

            <StackPanel Grid.Row="2">
                <TextBlock Text="{Binding TargetSectionTitle}"
                           FontSize="17"
                           FontWeight="DemiBold"
                           Margin="0,0,0,10"/>
                <RadioButton GroupName="TargetMode"
                             Style="{StaticResource DecryptionOptionRadioButtonStyle}"
                             Margin="0,5"
                             IsChecked="{Binding SelectedTargetMode, Mode=TwoWay,
                        Converter={markup:ResolveConverter ConverterType={x:Type converters:EnumToBoolConverter}},
                        ConverterParameter={x:Static security:EncryptionTargetMode.SaveAs}}">
                    <TextBlock Text="{Binding SaveCopyLabel}" TextWrapping="Wrap"/>
                </RadioButton>
                <RadioButton GroupName="TargetMode"
                             Style="{StaticResource DecryptionOptionRadioButtonStyle}"
                             Margin="0,5"
                             IsChecked="{Binding SelectedTargetMode, Mode=TwoWay,
                        Converter={markup:ResolveConverter ConverterType={x:Type converters:EnumToBoolConverter}},
                        ConverterParameter={x:Static security:EncryptionTargetMode.ReplaceSource}}">
                    <TextBlock Text="{Binding ReplaceSourceLabel}" TextWrapping="Wrap"/>
                </RadioButton>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,18,0,0">
                <TextBlock Text="{Binding ProcessedPath}"
                           Foreground="{DynamicResource CurrentMutedForeground}"
                           FontStyle="Italic"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding WarningMessage}"
                           Foreground="{DynamicResource CurrentErrorForeground}"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button Content="{Binding [Common.OK], Source={StaticResource Res}}"
                        Command="{Binding ButtonOk}"
                        MinWidth="100"
                        Margin="0,0,12,0"/>
                <Button Content="{Binding [Common.Cancel], Source={StaticResource Res}}"
                        Command="{Binding ButtonCancel}"
                        MinWidth="100"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Loaded}" />
        </i:EventTrigger>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding Closing}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
</Window>
