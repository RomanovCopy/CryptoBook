<Page x:Class="CryptoBook.MyPages.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:interfaces="clr-namespace:CryptoBook.Interfaces"
      xmlns:viewmodels="clr-namespace:CryptoBook.ViewModels"
      xmlns:controls="clr-namespace:CryptoBook.MyControls"
      xmlns:markup="clr-namespace:CryptoBook.Markup"
      xmlns:local="clr-namespace:CryptoBook.MyPages"
      mc:Ignorable="d" 
      d:DataContext="{markup:ResolveViewModel ViewModelType={x:Type interfaces:IHomeViewModel}}"
      Title="Home"
      Background="{DynamicResource CurrentWindowBackground}">
    <Page.DataContext>
        <markup:ResolveViewModel ViewModelType="{x:Type interfaces:IHomeViewModel}"/>
    </Page.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="fortitlebarrb" Height="Auto"/>
            <RowDefinition x:Name="forrichtextbox" Height="*"/>
            <RowDefinition x:Name="forstatusbar" Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ContentControl Content="{markup:ResolveUserControl UserControlType={x:Type controls:FontFormatBar}}"  HorizontalAlignment="Stretch" Grid.Column="0"  Margin="{StaticResource CurrentMargin}"/>
            <ContentControl Content="{markup:ResolveUserControl UserControlType={x:Type controls:TextFormatBar}}"  HorizontalAlignment="Stretch" Grid.Column="1"  Margin="{StaticResource CurrentMargin}"/>
            <ContentControl Content="{markup:ResolveUserControl UserControlType={x:Type controls:ListFormatBar}}" HorizontalAlignment="Stretch" Grid.Column="2" Margin="{StaticResource CurrentMargin}"/>
            <ContentControl Content="{markup:ResolveUserControl UserControlType={x:Type controls:BookmarksBar}}" HorizontalAlignment="Stretch" Grid.Column="3" Margin="{StaticResource CurrentMargin}"/>

            <ToggleButton Grid.Column="4"
                          Margin="{StaticResource CurrentMargin}"
                          Style="{StaticResource EditorPanelToggleStyle}"
                          IsChecked="{Binding DocumentView.IsPreviewMode, Mode=OneWay}"
                          Command="{Binding DocumentView.ToggleView}"
                          ToolTip="Переключить режим документа">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="16" Height="16" Margin="0,0,6,0">
                        <Path Data="{StaticResource Icon.ViewMode}"
                              Width="16"
                              Height="16">
                            <Path.Style>
                                <Style TargetType="{x:Type Path}"
                                       BasedOn="{StaticResource EditorToolbarIconStyle}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DocumentView.IsPreviewMode}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <Path Data="{StaticResource Icon.EditMode}"
                              Width="16"
                              Height="16">
                            <Path.Style>
                                <Style TargetType="{x:Type Path}"
                                       BasedOn="{StaticResource EditorToolbarIconStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DocumentView.IsPreviewMode}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                    <TextBlock Text="{Binding DocumentView.ToggleViewText}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </ToggleButton>
        </Grid>
        <ContentControl Content="{markup:ResolveUserControl UserControlType={x:Type controls:Richtextbox}}"
                            Grid.Row="1" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Margin="{StaticResource CurrentMargin}"/>
    </Grid>
</Page>
