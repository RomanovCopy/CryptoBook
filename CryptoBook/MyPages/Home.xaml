<Page x:Class="CryptoBook.MyPages.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:interfaces="clr-namespace:CryptoBook.Interfaces"
      xmlns:controls="clr-namespace:CryptoBook.MyControls"
      xmlns:markup="clr-namespace:CryptoBook.Markup"
      mc:Ignorable="d"
      d:DataContext="{markup:ResolveViewModel ViewModelType={x:Type interfaces:IHomeViewModel}}"
      Title="{Binding [Home.Title], Source={StaticResource Res}}"
      Background="{DynamicResource CurrentWindowBackground}">
    <Page.DataContext>
        <markup:ResolveViewModel ViewModelType="{x:Type interfaces:IHomeViewModel}"/>
    </Page.DataContext>

    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Grid MinWidth="660" Margin="32,26,32,32">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDocument}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding [Home.StartTitle], Source={StaticResource Res}}"
                               Foreground="{DynamicResource CurrentWindowForeground}"
                               FontSize="30"
                               FontWeight="SemiBold"/>
                    <TextBlock Margin="0,6,0,0"
                               Text="{Binding [Home.StartDescription], Source={StaticResource Res}}"
                               Foreground="{DynamicResource CurrentWindowForeground}"
                               FontSize="14"
                               Opacity="0.65"/>
                </StackPanel>

                <WrapPanel Grid.Row="1" Margin="0,24,0,26">
                    <Button MinWidth="164" MinHeight="42" Margin="0,0,10,10"
                            Command="{Binding NewDocument}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="16" Margin="0,0,9,0"/>
                            <TextBlock Text="{Binding [Home.CreateDocument], Source={StaticResource Res}}"/>
                        </StackPanel>
                    </Button>
                    <Button MinWidth="150" MinHeight="42" Margin="0,0,10,10"
                            Command="{Binding OpenDocument}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="16" Margin="0,0,9,0"/>
                            <TextBlock Text="{Binding [Home.OpenDocument], Source={StaticResource Res}}"/>
                        </StackPanel>
                    </Button>
                    <Button MinWidth="170" MinHeight="42" Margin="0,0,10,10"
                            Command="{Binding OpenMediaPlayer}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="16" Margin="0,0,9,0"/>
                            <TextBlock Text="{Binding [Home.OpenMediaPlayer], Source={StaticResource Res}}"/>
                        </StackPanel>
                    </Button>
                    <Button MinWidth="190" MinHeight="42" Margin="0,0,10,10"
                            Command="{Binding ChooseWorkspace}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="16" Margin="0,0,9,0"/>
                            <TextBlock Text="{Binding [Home.ChooseWorkspace], Source={StaticResource Res}}"/>
                        </StackPanel>
                    </Button>
                    <Border MinHeight="42" MaxWidth="440" Margin="0,0,0,10"
                            Padding="12,7" VerticalAlignment="Top"
                            Background="{DynamicResource CurrentTitleBarBackground}"
                            BorderBrush="{DynamicResource CurrentBorderColor}"
                            BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="{Binding [Home.Workspace], Source={StaticResource Res}}"
                                       Foreground="{DynamicResource CurrentWindowForeground}"
                                       FontSize="10" Opacity="0.55"/>
                            <TextBlock Text="{Binding WorkspaceDirectoryDisplay}"
                                       Foreground="{DynamicResource CurrentWindowForeground}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding WorkspaceDirectoryDisplay}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="280"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*" MinWidth="330"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding [PinnedDocuments.Title], Source={StaticResource Res}}"
                                   Foreground="{DynamicResource CurrentWindowForeground}"
                                   FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,16,0,0"
                                   Text="{Binding [Home.NoPinnedDocuments], Source={StaticResource Res}}"
                                   Foreground="{DynamicResource CurrentWindowForeground}"
                                   Opacity="0.55">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PinnedDocuments.HasItems}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl Margin="0,12,0,0"
                                      ItemsSource="{Binding PinnedDocuments.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,9" Padding="12"
                                            Background="{DynamicResource CurrentTitleBarBackground}"
                                            BorderBrush="{DynamicResource CurrentBorderColor}"
                                            BorderThickness="1" CornerRadius="7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Glyph}"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="18"
                                                       Foreground="{DynamicResource CurrentWindowForeground}"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Margin="11,0,10,0">
                                                <TextBlock Text="{Binding FileName}"
                                                           Foreground="{DynamicResource CurrentWindowForeground}"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Path}"/>
                                                <TextBlock Text="{Binding ParentDirectory}"
                                                           Foreground="{DynamicResource CurrentWindowForeground}"
                                                           FontSize="11" Opacity="0.55"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding [Home.FileUnavailable], Source={StaticResource Res}}"
                                                           Foreground="#D96B5F" FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button MinWidth="70"
                                                        Command="{Binding DataContext.PinnedDocuments.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="{Binding [Common.Open], Source={StaticResource Res}}"/>
                                                <Button Margin="6,0,0,0"
                                                        Command="{Binding DataContext.PinnedDocuments.RelocateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="{Binding [RecentDocuments.RelocateShort], Source={StaticResource Res}}">
                                                    <Button.Style>
                                                        <Style TargetType="Button"
                                                               BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding [RecentDocuments.Title], Source={StaticResource Res}}"
                                   Foreground="{DynamicResource CurrentWindowForeground}"
                                   FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,16,0,0"
                                   Text="{Binding [RecentDocuments.Empty], Source={StaticResource Res}}"
                                   Foreground="{DynamicResource CurrentWindowForeground}"
                                   Opacity="0.55">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RecentDocuments.HasItems}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl Margin="0,12,0,0"
                                      ItemsSource="{Binding RecentDocuments.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,9" Padding="12"
                                            Background="{DynamicResource CurrentTitleBarBackground}"
                                            BorderBrush="{DynamicResource CurrentBorderColor}"
                                            BorderThickness="1" CornerRadius="7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Glyph}"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="18"
                                                       Foreground="{DynamicResource CurrentWindowForeground}"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Margin="11,0,10,0">
                                                <TextBlock Text="{Binding FileName}"
                                                           Foreground="{DynamicResource CurrentWindowForeground}"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Path}"/>
                                                <TextBlock Text="{Binding ParentDirectory}"
                                                           Foreground="{DynamicResource CurrentWindowForeground}"
                                                           FontSize="11" Opacity="0.55"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding LastAccessedDisplay}"
                                                           Foreground="{DynamicResource CurrentWindowForeground}"
                                                           FontSize="11" Opacity="0.55"/>
                                                <TextBlock Text="{Binding [Home.FileUnavailable], Source={StaticResource Res}}"
                                                           Foreground="#D96B5F" FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button MinWidth="70"
                                                        Command="{Binding DataContext.RecentDocuments.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="{Binding [Common.Open], Source={StaticResource Res}}"/>
                                                <Button Margin="6,0,0,0"
                                                        Command="{Binding DataContext.RecentDocuments.RelocateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="{Binding [RecentDocuments.RelocateShort], Source={StaticResource Res}}">
                                                    <Button.Style>
                                                        <Style TargetType="Button"
                                                               BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Width="34" Margin="6,0,0,0"
                                                        Command="{Binding DataContext.RecentDocuments.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="{Binding [RecentDocuments.Remove], Source={StaticResource Res}}">
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasDocument}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ContentControl Content="{markup:ResolveUserControl UserControlType={x:Type controls:FontFormatBar}}"
                                Grid.Column="0" Margin="{StaticResource CurrentMargin}"/>
                <ContentControl Content="{markup:ResolveUserControl UserControlType={x:Type controls:TextFormatBar}}"
                                Grid.Column="1" Margin="{StaticResource CurrentMargin}"/>
                <ContentControl Content="{markup:ResolveUserControl UserControlType={x:Type controls:ListFormatBar}}"
                                Grid.Column="2" Margin="{StaticResource CurrentMargin}"/>
                <ContentControl Content="{markup:ResolveUserControl UserControlType={x:Type controls:BookmarksBar}}"
                                Grid.Column="3" Margin="{StaticResource CurrentMargin}"/>
                <ToggleButton Grid.Column="4" Margin="{StaticResource CurrentMargin}"
                              Style="{StaticResource EditorPanelToggleStyle}"
                              IsChecked="{Binding DocumentView.IsPreviewMode, Mode=OneWay}"
                              Command="{Binding DocumentView.ToggleView}"
                              ToolTip="{Binding [Editor.ToggleDocumentMode], Source={StaticResource Res}}">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="16" Height="16" Margin="0,0,6,0">
                            <Path Data="{StaticResource Icon.ViewMode}" Width="16" Height="16">
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource EditorToolbarIconStyle}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DocumentView.IsPreviewMode}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <Path Data="{StaticResource Icon.EditMode}" Width="16" Height="16">
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource EditorToolbarIconStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DocumentView.IsPreviewMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                        <TextBlock Text="{Binding DocumentView.ToggleViewText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
            </Grid>
            <ContentControl Grid.Row="1"
                            Content="{markup:ResolveUserControl UserControlType={x:Type controls:Richtextbox}}"
                            Margin="{StaticResource CurrentMargin}"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"/>
        </Grid>
    </Grid>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding PageLoaded}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
</Page>
