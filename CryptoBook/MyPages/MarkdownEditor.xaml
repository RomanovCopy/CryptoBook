<Page x:Class="CryptoBook.MyPages.MarkdownEditor"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:behaviors="clr-namespace:CryptoBook.Behaviors"
      xmlns:interfaces="clr-namespace:CryptoBook.Interfaces"
      xmlns:markup="clr-namespace:CryptoBook.Markup"
      mc:Ignorable="d"
      d:DataContext="{x:Type interfaces:IMarkdownEditorViewModel}"
      Title="Markdown"
      Background="{DynamicResource CurrentWindowBackground}">
    <Page.DataContext>
        <markup:ResolveViewModel ViewModelType="{x:Type interfaces:IMarkdownEditorViewModel}"/>
    </Page.DataContext>
    <Page.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveDocument}"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveDocumentAs}"/>
    </Page.InputBindings>

    <Grid Margin="4,4,4,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Padding="8"
                Background="{DynamicResource CurrentTitleBarBackground}"
                BorderBrush="{DynamicResource CurrentBorderColor}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource CurrentTitleBarForeground}"
                           Text="Markdown"/>
                <TextBlock Grid.Column="1"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource CurrentMutedForeground}"
                           Text="{Binding ModeLabel}"/>
                <Button Grid.Column="2"
                        Width="34"
                        Height="32"
                        Margin="4,0"
                        Command="{Binding OpenSyntaxHelp}"
                        AutomationProperties.Name="{Binding [MarkdownHelp.OpenHint], Source={StaticResource Res}}"
                        ToolTip="{Binding [MarkdownHelp.OpenHint], Source={StaticResource Res}}">
                    <TextBlock VerticalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Text="&#xE897;"/>
                </Button>
                <Button Grid.Column="3"
                        Margin="4,0"
                        Padding="12,6"
                        Command="{Binding SaveDocument}"
                        Content="{Binding [Common.Save], Source={StaticResource Res}}"/>
                <Button Grid.Column="4"
                        Margin="4,0"
                        Padding="12,6"
                        Command="{Binding SaveDocumentAs}"
                        Content="{Binding [Common.SaveAs], Source={StaticResource Res}}"/>
                <ToggleButton Grid.Column="5"
                              Margin="4,0"
                              MinWidth="104"
                              Style="{StaticResource EditorPanelToggleStyle}"
                              IsChecked="{Binding IsPreviewMode, Mode=OneWay}"
                              Command="{Binding ToggleView}"
                              ToolTip="{Binding [Editor.ToggleDocumentMode], Source={StaticResource Res}}">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="16" Height="16" Margin="0,0,6,0">
                            <Path Data="{StaticResource Icon.ViewMode}"
                                  Width="16"
                                  Height="16">
                                <Path.Style>
                                    <Style TargetType="Path"
                                           BasedOn="{StaticResource EditorToolbarIconStyle}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPreviewMode}"
                                                         Value="True">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <Path Data="{StaticResource Icon.EditMode}"
                                  Width="16"
                                  Height="16">
                                <Path.Style>
                                    <Style TargetType="Path"
                                           BasedOn="{StaticResource EditorToolbarIconStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPreviewMode}"
                                                         Value="True">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding ToggleViewText}"/>
                    </StackPanel>
                </ToggleButton>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <TextBox x:Name="SourceEditor"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="14"
                     Padding="16"
                     Background="{DynamicResource CurrentInputBackground}"
                     Foreground="{DynamicResource CurrentInputForeground}"
                     CaretBrush="{DynamicResource CurrentInputForeground}"
                     SelectionBrush="{DynamicResource CurrentSelectionBackground}"
                     SelectionTextBrush="{DynamicResource CurrentSelectionForeground}"
                     BorderBrush="{DynamicResource CurrentBorderColor}"
                     SpellCheck.IsEnabled="False"
                     Text="{Binding MarkdownText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Style>
                    <Style TargetType="TextBox"
                           BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPreviewMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <RichTextBox IsReadOnly="True"
                         IsDocumentEnabled="True"
                         IsUndoEnabled="False"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         BorderThickness="1"
                         Padding="0"
                         Background="{DynamicResource CurrentDocumentBackground}"
                         Foreground="{DynamicResource CurrentWindowForeground}"
                         CaretBrush="{DynamicResource CurrentWindowForeground}"
                         SelectionBrush="{DynamicResource CurrentSelectionBackground}"
                         SelectionTextBrush="{DynamicResource CurrentSelectionForeground}"
                         BorderBrush="{DynamicResource CurrentBorderColor}"
                         behaviors:RichTextBoxDocumentBinding.Document="{Binding PreviewDocument}"
                         behaviors:HyperlinkCommandBehavior.Command="{Binding OpenHyperlink}">
                <RichTextBox.Style>
                    <Style TargetType="RichTextBox"
                           BasedOn="{StaticResource {x:Type RichTextBox}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPreviewMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RichTextBox.Style>
            </RichTextBox>
        </Grid>
    </Grid>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding PageLoaded}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
</Page>
