<Page x:Class="CryptoBook.MyPages.MarkdownSyntaxHelp"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:interfaces="clr-namespace:CryptoBook.Interfaces"
      xmlns:markup="clr-namespace:CryptoBook.Markup"
      mc:Ignorable="d"
      d:DataContext="{x:Type interfaces:IMarkdownSyntaxHelpViewModel}"
      Title="{Binding [MarkdownHelp.Title], Source={StaticResource Res}}"
      Background="{DynamicResource CurrentWindowBackground}">
    <Page.DataContext>
        <markup:ResolveViewModel ViewModelType="{x:Type interfaces:IMarkdownSyntaxHelpViewModel}"/>
    </Page.DataContext>
    <Page.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding BackToEditor}"/>
    </Page.InputBindings>

    <Grid Margin="28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding [MarkdownHelp.Title], Source={StaticResource Res}}"
                           Foreground="{DynamicResource CurrentWindowForeground}"
                           FontSize="26"
                           FontWeight="SemiBold"/>
                <TextBlock Margin="0,5,0,0"
                           MaxWidth="760"
                           HorizontalAlignment="Left"
                           Text="{Binding [MarkdownHelp.Description], Source={StaticResource Res}}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource CurrentMutedForeground}"/>
            </StackPanel>
            <Button Grid.Column="1"
                    MinWidth="132"
                    Height="36"
                    Margin="18,0,0,0"
                    Padding="12,0"
                    Command="{Binding BackToEditor}"
                    ToolTip="{Binding [MarkdownHelp.BackHint], Source={StaticResource Res}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,7,0"
                               VerticalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Text="&#xE72B;"/>
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding [MarkdownHelp.Back], Source={StaticResource Res}}"/>
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      Margin="0,20,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,22">
                                <TextBlock Margin="2,0,0,9"
                                           Text="{Binding Title}"
                                           Foreground="{DynamicResource CurrentWindowForeground}"
                                           FontSize="18"
                                           FontWeight="SemiBold"/>
                                <Grid Margin="14,0,14,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="8,0"
                                               Text="{Binding [MarkdownHelp.Syntax], Source={StaticResource Res}}"
                                               Foreground="{DynamicResource CurrentMutedForeground}"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1"
                                               Margin="18,0,4,0"
                                               Text="{Binding [MarkdownHelp.Result], Source={StaticResource Res}}"
                                               Foreground="{DynamicResource CurrentMutedForeground}"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>
                                </Grid>
                                <Border Background="{DynamicResource CurrentTitleBarBackground}"
                                        BorderBrush="{DynamicResource CurrentBorderColor}"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <ItemsControl ItemsSource="{Binding Entries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="14,11"
                                                        BorderBrush="{DynamicResource CurrentBorderColor}"
                                                        BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="260"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Padding="8,6"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding Syntax}"
                                                                   TextWrapping="Wrap"
                                                                   FontFamily="Cascadia Mono, Consolas"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource CurrentInputForeground}"
                                                                   Background="{DynamicResource CurrentInputBackground}"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Margin="18,0,4,0"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding Result}"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource CurrentWindowForeground}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Margin="0,0,0,20"
                        Padding="16,13"
                        Background="{DynamicResource CurrentControlBackground}"
                        BorderBrush="{DynamicResource CurrentBorderColor}"
                        BorderThickness="1"
                        CornerRadius="7">
                    <StackPanel>
                        <TextBlock Text="{Binding [MarkdownHelp.Safety.Title], Source={StaticResource Res}}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource CurrentWindowForeground}"/>
                        <TextBlock Margin="0,5,0,0"
                                   Text="{Binding [MarkdownHelp.Safety.Description], Source={StaticResource Res}}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource CurrentMutedForeground}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding PageLoaded}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
</Page>
