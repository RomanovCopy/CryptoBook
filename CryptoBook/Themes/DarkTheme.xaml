                 UriSource="/CryptoBook;component/Resources/Images/AppIcon.DarkTheme.png"/>
    <SolidColorBrush x:Key="CurrentWindowBackground" Color="#FF202124"/>
    <SolidColorBrush x:Key="CurrentWindowForeground" Color="#FFF1F3F5"/>
    <SolidColorBrush x:Key="CurrentTitleBarBackground" Color="#FF17181A"/>
    <SolidColorBrush x:Key="CurrentTitleBarForeground" Color="#FFF7F8FA"/>
