    <SolidColorBrush x:Key="CurrentAccent" Color="#FF93C5FD"/>
    <SolidColorBrush x:Key="CurrentControlBackground" Color="#FF2B2D31"/>
    <SolidColorBrush x:Key="CurrentControlHoverBackground" Color="#FF363A40"/>
    <SolidColorBrush x:Key="CurrentMutedForeground" Color="#FFC5CBD3"/>
    <SolidColorBrush x:Key="CurrentDocumentBackground" Color="#FF202124"/>
    <SolidColorBrush x:Key="CurrentInputBackground" Color="#FF2B2D31"/>
    <SolidColorBrush x:Key="CurrentInputForeground" Color="#FFF1F3F5"/>
    <SolidColorBrush x:Key="CurrentDisabledForeground" Color="#FFB5BDC7"/>
