<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <BitmapImage x:Key="ApplicationWindowIcon"
                 UriSource="/CryptoBook;component/Resources/Icons/AppIcon.ico"/>
    <SolidColorBrush x:Key="CurrentWindowBackground" Color="#FFF2E8D5"/>
    <SolidColorBrush x:Key="CurrentWindowForeground" Color="#FF3F3226"/>
    <SolidColorBrush x:Key="CurrentTitleBarBackground" Color="#FFE1CFB0"/>
    <SolidColorBrush x:Key="CurrentTitleBarForeground" Color="#FF362A20"/>
    <SolidColorBrush x:Key="CurrentBorderColor" Color="#FF6B5237"/>
    <SolidColorBrush x:Key="CurrentAccent" Color="#FF7A3E18"/>
    <SolidColorBrush x:Key="CurrentControlBackground" Color="#FFF9F1E3"/>
    <SolidColorBrush x:Key="CurrentControlHoverBackground" Color="#FFEAD9BC"/>
    <SolidColorBrush x:Key="CurrentMutedForeground" Color="#FF75634F"/>
    <SolidColorBrush x:Key="CurrentDocumentBackground" Color="#FFFFFBF2"/>
    <SolidColorBrush x:Key="CurrentInputBackground" Color="#FFF9F1E3"/>
    <SolidColorBrush x:Key="CurrentInputForeground" Color="#FF3F3226"/>
    <SolidColorBrush x:Key="CurrentDisabledForeground" Color="#FF74624F"/>
    <SolidColorBrush x:Key="CurrentSelectionBackground" Color="#FFE3CDAA"/>
    <SolidColorBrush x:Key="CurrentSelectionForeground" Color="#FF362A20"/>
    <SolidColorBrush x:Key="CurrentErrorForeground" Color="#FF9E2A2B"/>
</ResourceDictionary>
