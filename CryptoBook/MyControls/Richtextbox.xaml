<UserControl x:Class="CryptoBook.MyControls.Richtextbox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:markup="clr-namespace:CryptoBook.Markup"
             xmlns:interfaces="clr-namespace:CryptoBook.Interfaces"
             xmlns:services="clr-namespace:CryptoBook.Services"
             xmlns:behaviors="clr-namespace:CryptoBook.Behaviors"
             xmlns:local="clr-namespace:CryptoBook.MyControls"
             mc:Ignorable="d"
             d:DataContext="{x:Type interfaces:IRichtextboxViewModel}">
    <UserControl.DataContext>
        <markup:ResolveViewModel ViewModelType="{x:Type interfaces:IRichtextboxViewModel}"/>
    </UserControl.DataContext>
    <UserControl.InputBindings>
        <KeyBinding Key="S"
                    Modifiers="Control"
                    Command="{Binding SaveDocument}"/>
        <KeyBinding Key="S"
                    Modifiers="Control+Shift"
                    Command="{Binding SaveDocumentAs}"/>
    </UserControl.InputBindings>
    <Border BorderBrush="{DynamicResource CurrentBorderColor}" BorderThickness="1,1,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <AdornerDecorator>
            <ContentControl x:Name="EditorHost"
                            Content="{markup:ResolveUserControl UserControlType={x:Type interfaces:IRichTextBoxService}}">
                <ContentControl.Style>
                    <Style TargetType="{x:Type ContentControl}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPreviewMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <ContentControl.Resources>
                    <Style TargetType="{x:Type services:RichTextBoxService}">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Margin" Value="24,24,24,0"/>
                        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
                        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                        <Setter Property="behaviors:DocumentPageBorderBehavior.IsEnabled" Value="True"/>
                        <Setter Property="Cursor"
                                Value="{x:Static markup:HighContrastTextCursor.Instance}"/>
                        <Setter Property="ContextMenu"
                                Value="{markup:ResolveService ServiceType={x:Type local:RichTextEditorContextMenu}}"/>
                        <Setter Property="behaviors:DocumentImageResizeBehavior.ImageEditor"
                                Value="{markup:ResolveService ServiceType={x:Type interfaces:IEmbeddedImageEditor}}"/>
                        <Setter Property="behaviors:DocumentImageResizeBehavior.ImageLayoutService"
                                Value="{markup:ResolveService ServiceType={x:Type interfaces:IEmbeddedImageLayoutService}}"/>
                        <Setter Property="behaviors:DocumentImageResizeBehavior.IsEnabled"
                                Value="True"/>
                    </Style>
                </ContentControl.Resources>
            </ContentControl>
            </AdornerDecorator>

            <Grid>
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPreviewMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <FlowDocumentPageViewer x:Name="PageViewer"
                                        Document="{Binding PreviewDocument}"
                                        behaviors:HyperlinkCommandBehavior.Command="{Binding OpenHyperlink}"
                                        behaviors:DocumentPageKeyboardNavigationBehavior.IsEnabled="True"
                                        behaviors:DocumentPageFitBehavior.IsEnabled="{Binding IsFitToWindow}"
                                        Zoom="100"/>
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="12,56,12,12"
                        Width="36"
                        Height="36"
                        Panel.ZIndex="10"
                        Command="{Binding ToggleFitToWindow}"
                        ToolTip="{Binding FitToWindowText}"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent"
                                    Padding="8">
                                <TextBlock x:Name="Icon"
                                           Text="{Binding FitToWindowGlyph}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Foreground="{DynamicResource CurrentWindowForeground}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="False">
                                    <Setter TargetName="Icon"
                                            Property="Opacity"
                                            Value="0.68"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Icon"
                                            Property="Opacity"
                                            Value="0.42"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Icon"
                                            Property="Opacity"
                                            Value="0.28"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="24,4,24,4">
                <TextBlock Text="{Binding [Editor.Zoom], Source={StaticResource Res}}"
                           Foreground="{DynamicResource CurrentMutedForeground}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBlock x:Name="ZoomIndicator"
                           Foreground="{DynamicResource CurrentWindowForeground}"
                           VerticalAlignment="Center"
                           MinWidth="44"
                           TextAlignment="Right">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text"
                                    Value="{Binding Content.LayoutTransform.ScaleX, ElementName=EditorHost, StringFormat={}{0:P0}, FallbackValue='100%'}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPreviewMode}" Value="True">
                                    <Setter Property="Text"
                                            Value="{Binding Zoom, ElementName=PageViewer, StringFormat={}{0:0}%}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button x:Name="ResetZoomButton"
                        Content="100%"
                        ToolTip="{Binding [Editor.Zoom100], Source={StaticResource Res}}"
                        Command="{x:Static behaviors:DocumentPageBorderBehavior.ResetZoomCommand}"
                        CommandTarget="{Binding Content, ElementName=EditorHost}"
                        Margin="12,0,0,0"
                        Padding="8,2"
                        VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPreviewMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Loaded, UpdateSourceTrigger=PropertyChanged}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
</UserControl>
