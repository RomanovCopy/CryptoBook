<UserControl x:Class="CryptoBook.MyControls.SideMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:interfaces="clr-namespace:CryptoBook.Interfaces"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DataContext="{x:Type interfaces:ISideMenuViewModel}">
    <UserControl.Resources>
        <Style x:Key="QuickActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CurrentTitleBarBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource CurrentWindowForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CurrentBorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="{DynamicResource CurrentControlHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="{DynamicResource CurrentSelectionBackground}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource CurrentSelectionForeground}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="{DynamicResource CurrentControlBackground}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource CurrentDisabledForeground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavigationButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource QuickActionButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,9"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border x:Name="sidemenu"
                Width="0"
                Opacity="0"
                HorizontalAlignment="Left"
                ClipToBounds="True"
                Background="{DynamicResource CurrentWindowBackground}"
                BorderBrush="{DynamicResource CurrentBorderColor}"
                BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsMenuOpen,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                     Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width"
                                                         To="280"
                                                         Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width"
                                                         To="0"
                                                         Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseIn"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid Width="280">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="18,18,18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding BookTitle}"
                                   Foreground="{DynamicResource CurrentWindowForeground}"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   ToolTip="{Binding BookTitle}"/>
                        <Button Grid.Column="1"
                                Width="34"
                                Height="32"
                                Margin="8,0,0,0"
                                Padding="0"
                                Style="{StaticResource QuickActionButtonStyle}"
                                Command="{Binding PinnedDocuments.ToggleCurrentCommand}"
                                ToolTip="{Binding PinnedDocuments.CurrentPinToolTip}">
                            <TextBlock Text="{Binding PinnedDocuments.CurrentPinGlyph}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                    <TextBlock Margin="0,3,0,0"
                               Text="{Binding [SideMenu.Subtitle], Source={StaticResource Res}}"
                               Foreground="{DynamicResource CurrentWindowForeground}"
                               FontSize="12"
                               Opacity="0.62"/>
                </StackPanel>

                <ItemsControl Grid.Row="1"
                              Margin="12,0,12,15"
                              ItemsSource="{Binding QuickActions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource QuickActionButtonStyle}"
                                    Command="{Binding Command}"
                                    IsEnabled="{Binding IsEnabled}"
                                    ToolTip="{Binding Description}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel Margin="12,0,12,14">
                            <TextBlock Margin="9,0,9,5"
                                       Text="{Binding [PinnedDocuments.Title], Source={StaticResource Res}}"
                                       Foreground="{DynamicResource CurrentWindowForeground}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Opacity="0.58"/>
                            <TextBlock Margin="9,5,9,7"
                                       Text="{Binding [PinnedDocuments.Empty], Source={StaticResource Res}}"
                                       Foreground="{DynamicResource CurrentWindowForeground}"
                                       FontSize="11"
                                       Opacity="0.58"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PinnedDocuments.HasItems}"
                                                         Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding PinnedDocuments.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid x:Name="PinnedItemRoot"
                                              Margin="0,1"
                                              Background="Transparent"
                                              Tag="{Binding DataContext.PinnedDocuments,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="Opened">
                                                            <i:InvokeCommandAction
                                                                Command="{Binding PlacementTarget.Tag.RefreshAvailabilityCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                CommandParameter="{Binding PlacementTarget.DataContext,
                                                                                           RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        </i:EventTrigger>
                                                    </i:Interaction.Triggers>
                                                    <MenuItem Header="{Binding [Common.Open], Source={StaticResource Res}}"
                                                              Command="{Binding PlacementTarget.Tag.OpenCommand,
                                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext,
                                                                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="{Binding [PinnedDocuments.RevealInExplorer], Source={StaticResource Res}}"
                                                              Command="{Binding PlacementTarget.Tag.RevealCommand,
                                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext,
                                                                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="{Binding [PinnedDocuments.Relocate], Source={StaticResource Res}}"
                                                              Command="{Binding PlacementTarget.Tag.RelocateCommand,
                                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext,
                                                                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <Separator/>
                                                    <MenuItem Header="{Binding [PinnedDocuments.MoveUp], Source={StaticResource Res}}"
                                                              Command="{Binding PlacementTarget.Tag.MoveUpCommand,
                                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext,
                                                                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="{Binding [PinnedDocuments.MoveDown], Source={StaticResource Res}}"
                                                              Command="{Binding PlacementTarget.Tag.MoveDownCommand,
                                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext,
                                                                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <Separator/>
                                                    <MenuItem Header="{Binding [PinnedDocuments.Unpin], Source={StaticResource Res}}"
                                                              Command="{Binding PlacementTarget.Tag.UnpinCommand,
                                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext,
                                                                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="32"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="CurrentMarker"
                                                    Background="Transparent"
                                                    CornerRadius="2"/>
                                            <Button x:Name="OpenPinnedButton"
                                                    Grid.Column="1"
                                                    Style="{StaticResource NavigationButtonStyle}"
                                                    Command="{Binding DataContext.PinnedDocuments.OpenCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding Path}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Glyph}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="16"
                                                               VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding FileName}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding FileName}"/>
                                                            <TextBlock Text="{Binding ParentDirectory}"
                                                                       Margin="0,2,0,0"
                                                                       FontSize="10"
                                                                       Opacity="0.58"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding ParentDirectory}"/>
                                                            <TextBlock x:Name="MissingState"
                                                                       Margin="0,3,0,0"
                                                                       Text="{Binding [PinnedDocuments.MissingState], Source={StaticResource Res}}"
                                                                       Foreground="{DynamicResource CurrentDisabledForeground}"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Visibility="Collapsed"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="StateGlyph"
                                                               Grid.Column="2"
                                                               Margin="6,0,0,0"
                                                               Foreground="{DynamicResource CurrentAccent}"
                                                               FontSize="16"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Button>
                                            <Button Grid.Column="2"
                                                    Margin="2,0,0,0"
                                                    Padding="0"
                                                    Style="{StaticResource NavigationButtonStyle}"
                                                    Command="{Binding DataContext.PinnedDocuments.UnpinCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding [PinnedDocuments.Unpin], Source={StaticResource Res}}">
                                                <TextBlock Text="&#xE77A;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="13"
                                                           HorizontalAlignment="Center"/>
                                            </Button>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter TargetName="CurrentMarker"
                                                        Property="Background"
                                                        Value="{DynamicResource CurrentAccent}"/>
                                                <Setter TargetName="PinnedItemRoot"
                                                        Property="Background"
                                                        Value="{DynamicResource CurrentSelectionBackground}"/>
                                                <Setter TargetName="OpenPinnedButton"
                                                        Property="Foreground"
                                                        Value="{DynamicResource CurrentSelectionForeground}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                <Setter TargetName="StateGlyph" Property="Text" Value="•"/>
                                                <Setter TargetName="StateGlyph"
                                                        Property="ToolTip"
                                                        Value="{Binding [PinnedDocuments.UnsavedChanges], Source={StaticResource Res}}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsOpening}" Value="True">
                                                <Setter TargetName="StateGlyph" Property="Text" Value="…"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                <Setter TargetName="PinnedItemRoot"
                                                        Property="Background"
                                                        Value="{DynamicResource CurrentControlHoverBackground}"/>
                                                <Setter TargetName="OpenPinnedButton"
                                                        Property="Foreground"
                                                        Value="{DynamicResource CurrentDisabledForeground}"/>
                                                <Setter TargetName="MissingState"
                                                        Property="Visibility"
                                                        Value="Visible"/>
                                                <Setter TargetName="StateGlyph"
                                                        Property="Text"
                                                        Value="&#xE783;"/>
                                                <Setter TargetName="StateGlyph"
                                                        Property="Foreground"
                                                        Value="{DynamicResource CurrentDisabledForeground}"/>
                                                <Setter TargetName="StateGlyph"
                                                        Property="ToolTip"
                                                        Value="{Binding [PinnedDocuments.MissingState], Source={StaticResource Res}}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <ItemsControl Margin="12,0,12,12"
                                      ItemsSource="{Binding MenuItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Margin="9,0,9,5"
                                                   Text="{Binding Name}"
                                                   Foreground="{DynamicResource CurrentWindowForeground}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.58"/>
                                        <ItemsControl ItemsSource="{Binding Children}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource NavigationButtonStyle}"
                                                            Command="{Binding Command}"
                                                            IsEnabled="{Binding IsEnabled}"
                                                            ToolTip="{Binding Description}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Glyph}"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="17"
                                                                       VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="14"/>
                                                                <TextBlock Text="{Binding Description}"
                                                                           Margin="0,2,0,0"
                                                                           FontSize="11"
                                                                           Opacity="0.58"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="3"
                        Margin="18,10,18,16"
                        Padding="0,11,0,0"
                        BorderBrush="{DynamicResource CurrentBorderColor}"
                        BorderThickness="0,1,0,0"
                        Opacity="0.55">
                    <TextBlock Text="{Binding [SideMenu.MoreSections], Source={StaticResource Res}}"
                               Foreground="{DynamicResource CurrentWindowForeground}"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Loaded}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
</UserControl>
