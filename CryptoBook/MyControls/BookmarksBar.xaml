<UserControl x:Class="CryptoBook.MyControls.BookmarksBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:markup="clr-namespace:CryptoBook.Markup"
             xmlns:interfaces="clr-namespace:CryptoBook.Interfaces"
             mc:Ignorable="d"
             d:DataContext="{markup:ResolveViewModel ViewModelType={x:Type interfaces:IBookmarksViewModel}}">
    <UserControl.DataContext>
        <markup:ResolveViewModel ViewModelType="{x:Type interfaces:IBookmarksViewModel}"/>
    </UserControl.DataContext>

    <Grid>
        <ToggleButton x:Name="TogglePanelButton"
                      Style="{StaticResource EditorPanelToggleStyle}"
                      ToolTip="Закладки">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource Icon.Bookmark}"
                      Style="{StaticResource EditorToolbarIconStyle}"
                      Width="16" Height="16" Margin="0,0,6,0"/>
                <TextBlock Text="Закладки" VerticalAlignment="Center"/>
            </StackPanel>
        </ToggleButton>

        <Popup PlacementTarget="{Binding ElementName=TogglePanelButton}"
               Placement="Bottom"
               IsOpen="{Binding IsChecked, ElementName=TogglePanelButton}"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               StaysOpen="False">
            <Border Style="{StaticResource EditorToolbarPopupBorderStyle}">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource EditorToolButtonStyle}"
                            Command="{Binding AddAtCaret}"
                            ToolTip="Добавить закладку">
                        <Path Data="{StaticResource Icon.BookmarkAdd}"
                              Style="{StaticResource EditorToolbarIconStyle}"/>
                    </Button>
                    <Button Style="{StaticResource EditorToolButtonStyle}"
                            Command="{Binding PreviousBookmark}"
                            ToolTip="Предыдущая закладка">
                        <Path Data="{StaticResource Icon.BookmarkPrevious}"
                              Style="{StaticResource EditorToolbarIconStyle}"/>
                    </Button>
                    <Button Style="{StaticResource EditorToolButtonStyle}"
                            Command="{Binding NextBookmark}"
                            ToolTip="Следующая закладка">
                        <Path Data="{StaticResource Icon.BookmarkNext}"
                              Style="{StaticResource EditorToolbarIconStyle}"/>
                    </Button>
                    <Border Width="1" Height="22"
                            Margin="4,5"
                            Background="#557CA0CC"/>
                    <Button Style="{StaticResource EditorToolButtonStyle}"
                            Command="{Binding Remove}"
                            ToolTip="Удалить закладку">
                        <Path Data="{StaticResource Icon.BookmarkRemove}"
                              Style="{StaticResource EditorToolbarIconStyle}"/>
                    </Button>
                    <Button Style="{StaticResource EditorToolButtonStyle}"
                            Command="{Binding Rename}"
                            ToolTip="Переименовать закладку">
                        <Path Data="{StaticResource Icon.BookmarkRename}"
                              Style="{StaticResource EditorToolbarIconStyle}"/>
                    </Button>
                    <Button Style="{StaticResource EditorToolButtonStyle}"
                            Command="{Binding NavigateTo}"
                            ToolTip="Все закладки">
                        <Path Data="{StaticResource Icon.BookmarkAll}"
                              Style="{StaticResource EditorToolbarIconStyle}"/>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
