<UserControl x:Class="CryptoBook.MyControls.ImageViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:CryptoBook.Behaviors"
             xmlns:markup="clr-namespace:CryptoBook.Markup"
             xmlns:interfaces="clr-namespace:CryptoBook.Interfaces"
             xmlns:local="clr-namespace:CryptoBook.MyControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="{DynamicResource CurrentWindowBackground}">
        <!-- Контейнер для мышиных событий -->
        <Border Background="Transparent" ClipToBounds="True">
            <i:Interaction.Behaviors>
                <behaviors:ImageInteractionBehavior ImageService="{Binding ImageService}" />
            </i:Interaction.Behaviors>

            <Grid>
                <Grid.RenderTransform>
                    <MatrixTransform Matrix="{Binding ImageService.TransformMatrix}"/>
                </Grid.RenderTransform>
                <Image Source="{Binding ImageService.ImageSource}"
                       Stretch="Uniform"
                       RenderTransformOrigin="0.5,0.5"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.RenderTransform>
                        <RotateTransform Angle="{Binding ImageService.RotationAngle}"/>
                    </Image.RenderTransform>
                </Image>
            </Grid>
        </Border>

        <!-- Индикатор загрузки тяжелых фото -->
        <ProgressBar IsIndeterminate="True" Width="150" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="{Binding ImageService.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Панель инструментов фото -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
            <Button Content="{Binding [Media.Rotate], Source={StaticResource Res}}" Command="{Binding RotateImageCommand}" Margin="5" Padding="8,4"/>
            <Button Content="{Binding [Media.FitImage], Source={StaticResource Res}}" Command="{Binding ResetImageTransformCommand}" Margin="5" Padding="8,4"/>
        </StackPanel>
    </Grid>
</UserControl>
