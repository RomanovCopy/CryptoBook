<UserControl x:Class="CryptoBook.MyControls.ImageViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:CryptoBook.Behaviors"
             xmlns:markup="clr-namespace:CryptoBook.Markup"
             xmlns:interfaces="clr-namespace:CryptoBook.Interfaces"
             xmlns:local="clr-namespace:CryptoBook.MyControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#1A1A1A">
        <!-- Контейнер для мышиных событий -->
        <Border Background="Transparent" ClipToBounds="True">
            <i:Interaction.Behaviors>
                <behaviors:ImageInteractionBehavior ImageService = "{markup:ResolveService ServiceType={x:Type interfaces:IImageService}}" />
            </i:Interaction.Behaviors>

            <Image Source="{Binding {markup:ResolveService ServiceType={x:Type interfaces:IImageService.ImageSource}}}" 
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.RenderTransform>
                    <TransformGroup>
                        <RotateTransform Angle="{Binding ImageService.RotationAngle}"/>
                        <MatrixTransform Matrix="{Binding ImageService.TransformMatrix}"/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
        </Border>

        <!-- Индикатор загрузки тяжелых фото -->
        <ProgressBar IsIndeterminate="True" Width="150" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="{Binding ImageService.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Панель инструментов фото -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
            <Button Content="🔄 Повернуть" Command="{Binding RotateImageCommand}" Margin="5" Padding="8,4"/>
            <Button Content="🔍 Вписать" Command="{Binding ResetImageTransformCommand}" Margin="5" Padding="8,4"/>
        </StackPanel>
    </Grid>
</UserControl>
