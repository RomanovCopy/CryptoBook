<UserControl x:Class="CryptoBook.MyControls.AiAssistantPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ai="clr-namespace:CryptoBook.AI"
             xmlns:controls="clr-namespace:CryptoBook.MyControls"
             xmlns:markup="clr-namespace:CryptoBook.Markup"
             Foreground="{DynamicResource CurrentWindowForeground}" AllowDrop="True" PreviewDragOver="FilesDragOver" PreviewDrop="FilesDropped">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <DataTemplate x:Key="AttachmentCard">
            <Border Padding="8" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource CurrentBorderColor}" Background="{DynamicResource CurrentControlBackground}" ToolTip="{Binding Name}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="{DynamicResource CurrentAccent}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsImage}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <Image Source="{Binding Preview}" Width="44" Height="44" Stretch="Uniform" Visibility="{Binding IsImage, Converter={StaticResource BoolVisibility}}"/>
                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource CurrentMutedForeground}" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Width" Value="390"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <UserControl.RenderTransform><TranslateTransform/></UserControl.RenderTransform>
    <Grid>
    <Border Background="{DynamicResource CurrentWindowBackground}" BorderBrush="{DynamicResource CurrentBorderColor}" BorderThickness="1,0,0,0">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="ClosePanelButton" Grid.Column="1" Command="{Binding Toggle}" Content="&#x2715;" Padding="8,4" ToolTip="{Binding [Common.Close], Source={StaticResource Res}}" AutomationProperties.Name="{Binding [Common.Close], Source={StaticResource Res}}"/>
                <TextBlock Text="{Binding [AI.Assistant], Source={StaticResource Res}}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Grid>
            <StackPanel Grid.Row="1">
                <TextBlock Text="{Binding ModelName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ModelName}" Foreground="{DynamicResource CurrentMutedForeground}" Margin="0,0,0,8"/>
                <controls:AiRuntimeDetails DataContext="{Binding Runtime}"/>
                <WrapPanel Margin="0,0,0,8">
                    <Button Content="{Binding [AI.ModelSettings], Source={StaticResource Res}}" Command="{Binding OpenSettings}" Padding="9,5" Margin="0,0,6,6"/>
                    <Button Content="{Binding [AI.Unload], Source={StaticResource Res}}" Command="{Binding Unload}" Padding="9,5" Margin="0,0,6,6"/>
                    <Button Content="{Binding [AI.Clear], Source={StaticResource Res}}" Command="{Binding ClearChat}" Padding="9,5" Margin="0,0,0,6"/>
                </WrapPanel>
            </StackPanel>
            <ScrollViewer x:Name="ConversationScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="ConversationScrollChanged">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Padding="10" Margin="0,0,4,10" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CurrentBorderColor}" Background="{DynamicResource CurrentControlBackground}">
                            <StackPanel>
                                <TextBlock Text="{Binding RoleLabel}" Foreground="{DynamicResource CurrentMutedForeground}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <Border BorderThickness="1" BorderBrush="{DynamicResource CurrentBorderColor}" Background="{DynamicResource CurrentInputBackground}" CornerRadius="6" Padding="8" Margin="0,3,0,8" Visibility="{Binding HasReasoning, Converter={StaticResource BoolVisibility}}">
                                    <Expander x:Name="ReasoningExpander" Header="{Binding [AI.ReasoningDetails], Source={StaticResource Res}}" Foreground="{DynamicResource CurrentMutedForeground}" IsExpanded="False">
                                        <TextBox Text="{Binding Reasoning, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource CurrentMutedForeground}" Padding="0" Margin="0,8,0,0" MaxHeight="220" VerticalScrollBarVisibility="Auto"/>
                                    </Expander>
                                </Border>
                                <TextBox Text="{Binding Content, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" VerticalScrollBarVisibility="Disabled"/>
                                <ItemsControl ItemsSource="{Binding Attachments}" ItemTemplate="{StaticResource AttachmentCard}" Margin="0,8,0,0">
                                    <ItemsControl.Style><Style TargetType="ItemsControl"><Style.Triggers><Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></ItemsControl.Style>
                                    <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Margin" Value="0,0,0,6"/></Style></ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel Grid.Row="3" Margin="0,8,0,0">
                <WrapPanel>
                    <Button Content="{Binding [AI.Insert], Source={StaticResource Res}}" Command="{Binding Insert}" Padding="9,5" Margin="0,0,6,6"/>
                    <Button Content="{Binding [AI.Replace], Source={StaticResource Res}}" Command="{Binding Replace}" Padding="9,5" Margin="0,0,6,6"/>
                    <Button Content="{Binding [Common.Copy], Source={StaticResource Res}}" Command="{Binding Copy}" Padding="9,5" Margin="0,0,0,6"/>
                </WrapPanel>
                <ScrollViewer MaxHeight="156" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,8" Visibility="{Binding HasAttachments, Converter={StaticResource BoolVisibility}}">
                    <ItemsControl ItemsSource="{Binding Attachments}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AttachmentCard}"/>
                            <Button Grid.Column="1" Content="&#x2715;" Command="{Binding DataContext.RemoveAttachment, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="6,4" Margin="5,0,0,0" VerticalAlignment="Top" AutomationProperties.Name="{Binding [AI.RemoveAttachment], Source={StaticResource Res}}"/>
                        </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </ScrollViewer>
                <WrapPanel>
                    <Button Content="{Binding [AI.AttachFiles], Source={StaticResource Res}}" Command="{Binding AttachFiles}" Padding="8,5" Margin="0,0,6,6"/>
                    <Button Content="{Binding [AI.AttachDocument], Source={StaticResource Res}}" Command="{Binding AttachDocument}" Padding="8,5" Margin="0,0,0,6"/>
                </WrapPanel>
            </StackPanel>
            <TextBox x:Name="PromptBox" Grid.Row="4" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="74" MaxHeight="170" VerticalScrollBarVisibility="Auto" Padding="9" Margin="0,3,0,8" AutomationProperties.Name="{Binding [AI.Prompt], Source={StaticResource Res}}">
                <TextBox.InputBindings><KeyBinding Key="Enter" Modifiers="Control" Command="{Binding Send}"/></TextBox.InputBindings>
            </TextBox>
            <StackPanel Grid.Row="5">
                <TextBlock x:Name="SendAvailabilityHint" Text="{Binding SendUnavailableReason}" TextWrapping="Wrap" Foreground="{DynamicResource CurrentMutedForeground}" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                        <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                    </Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" TextWrapping="Wrap" MaxHeight="80" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding [AI.Stop], Source={StaticResource Res}}" Command="{Binding Stop}" Padding="10,7"/>
                    <Button x:Name="SendButton" Content="{Binding [AI.Send], Source={StaticResource Res}}" Command="{Binding Send}" ToolTip="{Binding SendUnavailableReason}" ToolTipService.ShowOnDisabled="True" Padding="15,7" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding [AI.ChatPrivacy], Source={StaticResource Res}}" Foreground="{DynamicResource CurrentMutedForeground}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
        <Thumb x:Name="ResizeHandle" Width="6" HorizontalAlignment="Left" Cursor="SizeWE"
               DragDelta="ResizePanel" ToolTip="{Binding [AI.ResizePanel], Source={StaticResource Res}}"
               AutomationProperties.Name="{Binding [AI.ResizePanel], Source={StaticResource Res}}">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent">
                        <Border x:Name="ResizeLine" Width="2" HorizontalAlignment="Left" Background="{DynamicResource CurrentBorderColor}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ResizeLine" Property="Background" Value="{DynamicResource CurrentAccent}"/></Trigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="ResizeLine" Property="Background" Value="{DynamicResource CurrentAccent}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</UserControl>
