<UserControl x:Class="CryptoBook.MyControls.AiAssistantPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:controls="clr-namespace:CryptoBook.MyControls"
             xmlns:behaviors="clr-namespace:CryptoBook.Behaviors"
             Foreground="{DynamicResource CurrentWindowForeground}" AllowDrop="True">
    <i:Interaction.Behaviors>
        <behaviors:PanelResizeBehavior/>
        <behaviors:SlideInBehavior/>
        <behaviors:FileDropCommandBehavior Command="{Binding AttachPaths}"/>
    </i:Interaction.Behaviors>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style x:Key="ChatIconButton" TargetType="Button" BasedOn="{StaticResource EditorToolButtonStyle}">
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        </Style>
        <Style x:Key="ChatToolbarIcon" TargetType="Path" BasedOn="{StaticResource EditorToolbarIconStyle}">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Style>
        <Style x:Key="ChatToolbarSeparator" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="{DynamicResource CurrentBorderColor}"/>
        </Style>
        <Style x:Key="ChatText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="{Binding DataContext.Appearance.FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Setter Property="FontSize" Value="{Binding DataContext.Appearance.FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Setter Property="Foreground" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=StackPanel}}"/>
        </Style>
        <DataTemplate x:Key="AttachmentCard">
            <Border Padding="8" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource CurrentBorderColor}" Background="{DynamicResource CurrentControlBackground}" ToolTip="{Binding Name}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="{DynamicResource CurrentAccent}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsImage}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <Image Source="{Binding Preview}" Width="44" Height="44" Stretch="Uniform" Visibility="{Binding IsImage, Converter={StaticResource BoolVisibility}}"/>
                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource CurrentMutedForeground}" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Width" Value="390"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <UserControl.RenderTransform><TranslateTransform/></UserControl.RenderTransform>
    <Grid>
    <Border Background="{DynamicResource CurrentWindowBackground}" BorderBrush="{DynamicResource CurrentBorderColor}" BorderThickness="1,0,0,0">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="ClosePanelButton" Grid.Column="1" Style="{StaticResource ChatIconButton}" Command="{Binding Toggle}"
                        ToolTip="{Binding [Common.Close], Source={StaticResource Res}}" AutomationProperties.Name="{Binding [Common.Close], Source={StaticResource Res}}">
                    <Path Data="{StaticResource Icon.Close}" Style="{StaticResource ChatToolbarIcon}"/>
                </Button>
                <TextBlock Text="{Binding [AI.Assistant], Source={StaticResource Res}}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Grid>
            <StackPanel Grid.Row="1">
                <TextBlock Text="{Binding ModelName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ModelName}" Foreground="{DynamicResource CurrentMutedForeground}" Margin="0,0,0,8"/>
                <TextBlock x:Name="ModelStatusText" TextWrapping="Wrap" Foreground="{DynamicResource CurrentMutedForeground}" Margin="0,0,0,8"
                           AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Text><MultiBinding StringFormat="{}{0}: {1}">
                        <Binding Path="[AI.ModelStatus]" Source="{StaticResource Res}"/>
                        <Binding Path="Runtime.ModelStatus"/>
                    </MultiBinding></TextBlock.Text>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button x:Name="NewChatButton" Style="{StaticResource ChatIconButton}" Command="{Binding NewChat}"
                            AutomationProperties.Name="{Binding [AI.NewChat], Source={StaticResource Res}}">
                        <Button.ToolTip><TextBlock><TextBlock.Text><MultiBinding StringFormat="{}{0} — {1}">
                            <Binding Path="[AI.NewChat]" Source="{StaticResource Res}"/>
                            <Binding Path="[AI.Clear]" Source="{StaticResource Res}"/>
                        </MultiBinding></TextBlock.Text></TextBlock></Button.ToolTip>
                        <Path Data="{StaticResource Icon.ChatNew}" Style="{StaticResource ChatToolbarIcon}"/>
                    </Button>
                    <Border Style="{StaticResource ChatToolbarSeparator}"/>
                    <Button x:Name="ModelSettingsButton" Style="{StaticResource ChatIconButton}" Command="{Binding OpenSettings}"
                            ToolTip="{Binding [AI.ModelSettings], Source={StaticResource Res}}" AutomationProperties.Name="{Binding [AI.ModelSettings], Source={StaticResource Res}}">
                        <Path Data="{StaticResource Icon.Settings}" Style="{StaticResource ChatToolbarIcon}"/>
                    </Button>
                    <Button x:Name="AppearanceButton" Style="{StaticResource ChatIconButton}" Command="{Binding OpenAppearance}"
                            ToolTip="{Binding [AI.Appearance], Source={StaticResource Res}}" AutomationProperties.Name="{Binding [AI.Appearance], Source={StaticResource Res}}">
                        <Path Data="{StaticResource Icon.FontColor}" Style="{StaticResource ChatToolbarIcon}"/>
                    </Button>
                    <Button x:Name="UnloadModelButton" Style="{StaticResource ChatIconButton}" Command="{Binding Unload}"
                            ToolTip="{Binding [AI.Unload], Source={StaticResource Res}}" AutomationProperties.Name="{Binding [AI.Unload], Source={StaticResource Res}}">
                        <Path Data="{StaticResource Icon.Unload}" Style="{StaticResource ChatToolbarIcon}"/>
                    </Button>
                </StackPanel>
                <Expander x:Name="RuntimeDetailsExpander" Header="{Binding [AI.RuntimeInfo], Source={StaticResource Res}}" IsExpanded="False"
                          ToolTip="{Binding [AI.AutoDetails], Source={StaticResource Res}}" Margin="0,0,0,6"
                          Visibility="{Binding Runtime.HasInfo, Converter={StaticResource BoolVisibility}}"
                          AutomationProperties.Name="{Binding [AI.RuntimeInfo], Source={StaticResource Res}}">
                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
                        <controls:AiRuntimeDetails DataContext="{Binding Runtime}"/>
                    </ScrollViewer>
                </Expander>
            </StackPanel>
            <ScrollViewer x:Name="ConversationScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <i:Interaction.Behaviors>
                    <behaviors:ScrollToEndBehavior/>
                </i:Interaction.Behaviors>
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Padding="6,8" Margin="0,0,4,10" CornerRadius="8" BorderBrush="{DynamicResource CurrentBorderColor}">
                            <Border.Style><Style TargetType="Border"><Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers><DataTrigger Binding="{Binding DataContext.Appearance.ShowMessageBorders, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Background" Value="{DynamicResource CurrentControlBackground}"/>
                                </DataTrigger></Style.Triggers>
                            </Style></Border.Style>
                            <StackPanel>
                                <StackPanel.Style><Style TargetType="StackPanel">
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource CurrentWindowForeground}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Role}" Value="user"><Setter Property="TextElement.Foreground" Value="{DynamicResource CurrentAccent}"/></DataTrigger>
                                        <MultiDataTrigger><MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Role}" Value="user"/>
                                            <Condition Binding="{Binding DataContext.Appearance.HasUserColor, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                        </MultiDataTrigger.Conditions><Setter Property="TextElement.Foreground" Value="{Binding DataContext.Appearance.UserColor, RelativeSource={RelativeSource AncestorType=UserControl}}"/></MultiDataTrigger>
                                        <MultiDataTrigger><MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Role}" Value="assistant"/>
                                            <Condition Binding="{Binding DataContext.Appearance.HasAssistantColor, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                        </MultiDataTrigger.Conditions><Setter Property="TextElement.Foreground" Value="{Binding DataContext.Appearance.AssistantColor, RelativeSource={RelativeSource AncestorType=UserControl}}"/></MultiDataTrigger>
                                    </Style.Triggers>
                                </Style></StackPanel.Style>
                                <CheckBox x:Name="SelectMessageCheckBox" Content="{Binding RoleLabel}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Foreground="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=StackPanel}}" FontWeight="SemiBold" Margin="0,0,0,5"
                                          ToolTip="{Binding [AI.SelectMessage], Source={StaticResource Res}}" AutomationProperties.HelpText="{Binding [AI.SelectMessage], Source={StaticResource Res}}">
                                    <CheckBox.Style><Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasContent}" Value="True"/>
                                            <Condition Binding="{Binding DataContext.CanSelectMessages, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                        </MultiDataTrigger.Conditions><Setter Property="IsEnabled" Value="True"/></MultiDataTrigger></Style.Triggers>
                                    </Style></CheckBox.Style>
                                </CheckBox>
                                <Border BorderThickness="1" BorderBrush="{DynamicResource CurrentBorderColor}" Background="{DynamicResource CurrentInputBackground}" CornerRadius="6" Padding="8" Margin="0,3,0,8" Visibility="{Binding HasReasoning, Converter={StaticResource BoolVisibility}}">
                                    <Expander x:Name="ReasoningExpander" Header="{Binding [AI.ReasoningDetails], Source={StaticResource Res}}" Foreground="{DynamicResource CurrentMutedForeground}" IsExpanded="False">
                                        <TextBox Style="{StaticResource ChatText}" Text="{Binding Reasoning, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource CurrentMutedForeground}" Padding="0" Margin="0,8,0,0" MaxHeight="220" VerticalScrollBarVisibility="Auto"/>
                                    </Expander>
                                </Border>
                                <RichTextBox x:Name="MessageContent" IsReadOnly="True" IsReadOnlyCaretVisible="True" IsUndoEnabled="False" IsDocumentEnabled="True"
                                             BorderThickness="0" Background="Transparent" Padding="0" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                             FontFamily="{Binding DataContext.Appearance.FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             FontSize="{Binding DataContext.Appearance.FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Foreground="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                             behaviors:AiChatMarkdownBehavior.Text="{Binding Content, Mode=OneWay}"
                                             behaviors:AiChatMarkdownBehavior.RenderMarkdown="{Binding DataContext.Appearance.RenderMarkdown, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             behaviors:AiChatMarkdownBehavior.CodeFontFamily="{Binding DataContext.Appearance.CodeFontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             behaviors:AiChatMarkdownBehavior.CodeColor="{Binding DataContext.Appearance.CodeColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             behaviors:HyperlinkCommandBehavior.Command="{Binding DataContext.OpenHyperlink, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                <ItemsControl ItemsSource="{Binding Attachments}" ItemTemplate="{StaticResource AttachmentCard}" Margin="0,8,0,0">
                                    <ItemsControl.Style><Style TargetType="ItemsControl"><Style.Triggers><Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></ItemsControl.Style>
                                    <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Margin" Value="0,0,0,6"/></Style></ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel Grid.Row="3" Margin="0,8,0,0">
                <WrapPanel Margin="0,0,0,4">
                    <TextBlock x:Name="MessageSelectionCounter" Text="{Binding MessageSelectionSummary}" ToolTip="{Binding MessageSelectionSummary}"
                               FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource CurrentMutedForeground}" Margin="2,0,8,0"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SelectAllMessagesButton" Style="{StaticResource ChatIconButton}" Command="{Binding SelectAllMessages}"
                                ToolTip="{Binding [AI.SelectAllMessages], Source={StaticResource Res}}" AutomationProperties.Name="{Binding [AI.SelectAllMessages], Source={StaticResource Res}}">
                            <Path Data="{StaticResource Icon.SelectAll}" Style="{StaticResource ChatToolbarIcon}"/>
                        </Button>
                        <Button x:Name="ClearMessageSelectionButton" Style="{StaticResource ChatIconButton}" Command="{Binding ClearMessageSelection}"
                                ToolTip="{Binding [AI.ClearMessageSelection], Source={StaticResource Res}}" AutomationProperties.Name="{Binding [AI.ClearMessageSelection], Source={StaticResource Res}}">
                            <Path Data="{StaticResource Icon.ClearSelection}" Style="{StaticResource ChatToolbarIcon}"/>
                        </Button>
                        <Border Style="{StaticResource ChatToolbarSeparator}"/>
                        <Button x:Name="InsertResponseButton" Command="{Binding Insert}" AutomationProperties.Name="{Binding [AI.Insert], Source={StaticResource Res}}">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ChatIconButton}">
                                <Setter Property="ToolTip" Value="{Binding InsertUnavailableReason}"/>
                                <Style.Triggers><DataTrigger Binding="{Binding InsertUnavailableReason}" Value="">
                                    <Setter Property="ToolTip" Value="{Binding [AI.Insert], Source={StaticResource Res}}"/>
                                </DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                            <Path Data="{StaticResource Icon.Insert}" Style="{StaticResource ChatToolbarIcon}"/>
                        </Button>
                        <Button x:Name="ReplaceSelectionButton" Command="{Binding Replace}" AutomationProperties.Name="{Binding [AI.Replace], Source={StaticResource Res}}">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ChatIconButton}">
                                <Setter Property="ToolTip" Value="{Binding ReplaceUnavailableReason}"/>
                                <Style.Triggers><DataTrigger Binding="{Binding ReplaceUnavailableReason}" Value="">
                                    <Setter Property="ToolTip" Value="{Binding [AI.Replace], Source={StaticResource Res}}"/>
                                </DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                            <Path Data="{StaticResource Icon.Replace}" Style="{StaticResource ChatToolbarIcon}"/>
                        </Button>
                        <Button x:Name="CopyMessagesButton" Style="{StaticResource ChatIconButton}" Command="{Binding Copy}"
                                ToolTip="{Binding [AI.CopySourceHint], Source={StaticResource Res}}" AutomationProperties.Name="{Binding [Common.Copy], Source={StaticResource Res}}">
                            <Path Data="{StaticResource Icon.Copy}" Style="{StaticResource ChatToolbarIcon}"/>
                        </Button>
                    </StackPanel>
                </WrapPanel>
                <ScrollViewer MaxHeight="156" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,8" Visibility="{Binding HasAttachments, Converter={StaticResource BoolVisibility}}">
                    <ItemsControl ItemsSource="{Binding Attachments}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AttachmentCard}"/>
                            <Button Grid.Column="1" Style="{StaticResource ChatIconButton}" Command="{Binding DataContext.RemoveAttachment, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" Margin="5,0,0,0" VerticalAlignment="Top"
                                    ToolTip="{Binding [AI.RemoveAttachment], Source={StaticResource Res}}" AutomationProperties.Name="{Binding [AI.RemoveAttachment], Source={StaticResource Res}}">
                                <Path Data="{StaticResource Icon.Close}" Style="{StaticResource ChatToolbarIcon}"/>
                            </Button>
                        </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </ScrollViewer>
            </StackPanel>
            <Border Grid.Row="4" Background="{DynamicResource CurrentInputBackground}" BorderThickness="1" CornerRadius="6" Margin="0,3,0,8">
                <Border.Style><Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource CurrentBorderColor}"/>
                    <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource CurrentAccent}"/>
                    </Trigger></Style.Triggers>
                </Style></Border.Style>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBox x:Name="PromptBox" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="74" MaxHeight="170" VerticalScrollBarVisibility="Auto"
                             BorderThickness="0" Background="Transparent" Padding="9" Margin="2,2,2,0" AutomationProperties.Name="{Binding [AI.Prompt], Source={StaticResource Res}}">
                        <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="FontFamily" Value="{Binding Appearance.FontFamily}"/>
                            <Setter Property="FontSize" Value="{Binding Appearance.FontSize}"/>
                            <Style.Triggers><DataTrigger Binding="{Binding Appearance.HasUserColor}" Value="True"><Setter Property="Foreground" Value="{Binding Appearance.UserColor}"/></DataTrigger></Style.Triggers>
                        </Style></TextBox.Style>
                        <TextBox.InputBindings><KeyBinding Key="Enter" Modifiers="Control" Command="{Binding Send}"/></TextBox.InputBindings>
                    </TextBox>
                    <Grid Grid.Row="1" Margin="4,0,4,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="AttachFilesButton" Style="{StaticResource ChatIconButton}" Command="{Binding AttachFiles}"
                                    ToolTip="{Binding [AI.AttachFiles], Source={StaticResource Res}}" AutomationProperties.Name="{Binding [AI.AttachFiles], Source={StaticResource Res}}">
                                <Path Data="{StaticResource Icon.Attach}" Style="{StaticResource ChatToolbarIcon}"/>
                            </Button>
                            <Button x:Name="AttachDocumentButton" Style="{StaticResource ChatIconButton}" Command="{Binding AttachDocument}"
                                    ToolTip="{Binding [AI.AttachDocument], Source={StaticResource Res}}" AutomationProperties.Name="{Binding [AI.AttachDocument], Source={StaticResource Res}}">
                                <Path Data="{StaticResource Icon.AttachDocument}" Style="{StaticResource ChatToolbarIcon}"/>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="StopButton" Style="{StaticResource ChatIconButton}" Command="{Binding Stop}"
                                    ToolTip="{Binding [AI.Stop], Source={StaticResource Res}}" AutomationProperties.Name="{Binding [AI.Stop], Source={StaticResource Res}}">
                                <Path Data="{StaticResource Icon.Stop}" Style="{StaticResource ChatToolbarIcon}"/>
                            </Button>
                            <Button x:Name="SendButton" Command="{Binding Send}" AutomationProperties.Name="{Binding [AI.Send], Source={StaticResource Res}}">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ChatIconButton}">
                                    <Setter Property="Foreground" Value="{DynamicResource CurrentAccent}"/>
                                    <Setter Property="ToolTip" Value="{Binding SendUnavailableReason}"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding SendUnavailableReason}" Value="">
                                        <Setter Property="ToolTip"><Setter.Value>
                                            <TextBlock><Run Text="{Binding [AI.Send], Source={StaticResource Res}, Mode=OneWay}"/><Run Text=" (Ctrl+Enter)"/></TextBlock>
                                        </Setter.Value></Setter>
                                    </DataTrigger></Style.Triggers>
                                </Style></Button.Style>
                                <Path Data="{StaticResource Icon.Send}" Style="{StaticResource ChatToolbarIcon}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <StackPanel Grid.Row="5">
                <StackPanel ToolTip="{Binding [AI.ContextHint], Source={StaticResource Res}}" Margin="0,0,0,8">
                    <TextBlock x:Name="ContextCounter" Text="{Binding ContextSummary}" TextWrapping="Wrap" Foreground="{DynamicResource CurrentMutedForeground}" FontSize="11"/>
                    <ProgressBar Value="{Binding ContextUsagePercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="3" Margin="0,5,0,0" AutomationProperties.Name="{Binding [AI.ContextCapacity], Source={StaticResource Res}}"/>
                    <TextBlock Text="{Binding [AI.ContextLow], Source={StaticResource Res}}" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource CurrentAccent}" FontSize="11" Visibility="{Binding IsContextLow, Converter={StaticResource BoolVisibility}}" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <TextBlock x:Name="SendAvailabilityHint" Text="{Binding SendUnavailableReason}" TextWrapping="Wrap" Foreground="{DynamicResource CurrentMutedForeground}" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                        <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                    </Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" TextWrapping="Wrap" MaxHeight="80" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Text="{Binding [AI.ChatPrivacy], Source={StaticResource Res}}" Foreground="{DynamicResource CurrentMutedForeground}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
        <Thumb x:Name="ResizeHandle" Width="6" HorizontalAlignment="Left" Cursor="SizeWE"
               behaviors:PanelResizeBehavior.IsResizeHandle="True"
               ToolTip="{Binding [AI.ResizePanel], Source={StaticResource Res}}"
               AutomationProperties.Name="{Binding [AI.ResizePanel], Source={StaticResource Res}}">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent">
                        <Border x:Name="ResizeLine" Width="2" HorizontalAlignment="Left" Background="{DynamicResource CurrentBorderColor}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ResizeLine" Property="Background" Value="{DynamicResource CurrentAccent}"/></Trigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="ResizeLine" Property="Background" Value="{DynamicResource CurrentAccent}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</UserControl>
