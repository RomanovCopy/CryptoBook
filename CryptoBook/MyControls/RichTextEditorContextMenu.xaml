<ContextMenu x:Class="CryptoBook.MyControls.RichTextEditorContextMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:markup="clr-namespace:CryptoBook.Markup"
             xmlns:interfaces="clr-namespace:CryptoBook.Interfaces"
             xmlns:behaviors="clr-namespace:CryptoBook.Behaviors"
             xmlns:dto="clr-namespace:CryptoBook.DTO"
             DataContext="{markup:ResolveViewModel ViewModelType={x:Type interfaces:IRichTextContextMenuViewModel}}"
             Background="{DynamicResource CurrentWindowBackground}"
             Foreground="{DynamicResource CurrentWindowForeground}"
             BorderBrush="#557CA0CC"
             BorderThickness="1"
             Padding="5"
             MinWidth="245"
             HasDropShadow="True">
    <ContextMenu.Resources>
        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="CommandTarget"
                    Value="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
        </Style>
        <Style TargetType="{x:Type Separator}">
            <Setter Property="Margin" Value="30,4,6,4"/>
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
    </ContextMenu.Resources>

    <MenuItem Header="_Отменить" Command="ApplicationCommands.Undo" InputGestureText="Ctrl+Z">
        <MenuItem.Icon>
            <Image Source="{DynamicResource editundoimage}" Width="16" Height="16"/>
        </MenuItem.Icon>
    </MenuItem>
    <MenuItem Header="_Повторить" Command="ApplicationCommands.Redo" InputGestureText="Ctrl+Y">
        <MenuItem.Icon>
            <Image Source="{DynamicResource editredoimage}" Width="16" Height="16"/>
        </MenuItem.Icon>
    </MenuItem>

    <Separator/>

    <MenuItem Header="В_ырезать" Command="ApplicationCommands.Cut" InputGestureText="Ctrl+X">
        <MenuItem.Icon>
            <Image Source="{DynamicResource editcutimage}" Width="16" Height="16"/>
        </MenuItem.Icon>
    </MenuItem>
    <MenuItem Header="_Копировать" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C">
        <MenuItem.Icon>
            <Image Source="{DynamicResource editcopyimage}" Width="16" Height="16"/>
        </MenuItem.Icon>
    </MenuItem>
    <MenuItem Header="В_ставить" Command="ApplicationCommands.Paste" InputGestureText="Ctrl+V">
        <MenuItem.Icon>
            <Image Source="{DynamicResource editpasteimage}" Width="16" Height="16"/>
        </MenuItem.Icon>
    </MenuItem>

    <Separator/>

    <MenuItem Header="Выделить _всё" Command="ApplicationCommands.SelectAll" InputGestureText="Ctrl+A"/>

    <Separator/>

    <MenuItem Header="О_чистить документ" Command="{Binding ClearDocument}">
        <MenuItem.Icon>
            <Image Source="{DynamicResource normaltextimage}" Width="16" Height="16"/>
        </MenuItem.Icon>
    </MenuItem>

    <Separator/>

    <MenuItem Header="_Форматирование">
        <MenuItem.Icon>
            <Image Source="{DynamicResource normaltextimage}" Width="16" Height="16"/>
        </MenuItem.Icon>
        <MenuItem Header="_Жирный"
                  Command="{Binding FontFormatting.SetFontWeightCommand}"
                  CommandParameter="{Binding Bold}"
                  InputGestureText="Ctrl+B">
            <MenuItem.Icon>
                <Image Source="{DynamicResource fontboldimage}" Width="16" Height="16"/>
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="_Курсив"
                  Command="{Binding FontFormatting.SetFontStyleCommand}"
                  CommandParameter="{Binding Italic}"
                  InputGestureText="Ctrl+I">
            <MenuItem.Icon>
                <Image Source="{DynamicResource fontitalicimage}" Width="16" Height="16"/>
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="_Подчёркивание"
                  Command="{Binding FontFormatting.SetTextDecorationCommand}"
                  CommandParameter="{Binding Underline}"
                  InputGestureText="Ctrl+U">
            <MenuItem.Icon>
                <Image Source="{DynamicResource fontunderlineimage}" Width="16" Height="16"/>
            </MenuItem.Icon>
        </MenuItem>
        <Separator/>
        <MenuItem Header="_Очистить форматирование"
                  Command="{Binding FontFormatting.ClearFormattingCommand}">
            <MenuItem.Icon>
                <Image Source="{DynamicResource normaltextimage}" Width="16" Height="16"/>
            </MenuItem.Icon>
        </MenuItem>
    </MenuItem>

    <MenuItem Header="_Выравнивание">
        <MenuItem Header="По _левому краю"
                  Command="{Binding TextFormatting.SetTextAlignment}"
                  CommandParameter="{x:Static TextAlignment.Left}">
            <MenuItem.Icon>
                <Image Source="{DynamicResource alignleftimage}" Width="16" Height="16"/>
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="По _центру"
                  Command="{Binding TextFormatting.SetTextAlignment}"
                  CommandParameter="{x:Static TextAlignment.Center}">
            <MenuItem.Icon>
                <Image Source="{DynamicResource aligncenterimage}" Width="16" Height="16"/>
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="По _правому краю"
                  Command="{Binding TextFormatting.SetTextAlignment}"
                  CommandParameter="{x:Static TextAlignment.Right}">
            <MenuItem.Icon>
                <Image Source="{DynamicResource alignrightimage}" Width="16" Height="16"/>
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="По _ширине"
                  Command="{Binding TextFormatting.SetTextAlignment}"
                  CommandParameter="{x:Static TextAlignment.Justify}">
            <MenuItem.Icon>
                <Image Source="{DynamicResource alignjustifyimage}" Width="16" Height="16"/>
            </MenuItem.Icon>
        </MenuItem>
    </MenuItem>

    <MenuItem Header="_Изображение">
        <MenuItem Header="В _строке"
                  Command="{x:Static behaviors:DocumentImageResizeBehavior.SetImageLayoutCommand}"
                  CommandParameter="{x:Static dto:ImageLayoutMode.Inline}"/>
        <MenuItem Header="_Отдельный блок по центру"
                  Command="{x:Static behaviors:DocumentImageResizeBehavior.SetImageLayoutCommand}"
                  CommandParameter="{x:Static dto:ImageLayoutMode.CenteredBlock}"/>
        <Separator/>
        <MenuItem Header="Обтекание: изображение _слева"
                  Command="{x:Static behaviors:DocumentImageResizeBehavior.SetImageLayoutCommand}"
                  CommandParameter="{x:Static dto:ImageLayoutMode.FloatLeft}"/>
        <MenuItem Header="Обтекание: изображение с_права"
                  Command="{x:Static behaviors:DocumentImageResizeBehavior.SetImageLayoutCommand}"
                  CommandParameter="{x:Static dto:ImageLayoutMode.FloatRight}"/>
    </MenuItem>

    <MenuItem Header="_Списки">
        <MenuItem.Icon>
            <Image Source="{DynamicResource listbulletsimage}" Width="16" Height="16"/>
        </MenuItem.Icon>
        <MenuItem Header="_Маркированный список"
                  Command="{Binding ListFormatting.ToggleBulleted}">
            <MenuItem.Icon>
                <Image Source="{DynamicResource listbulletsimage}" Width="16" Height="16"/>
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="_Нумерованный список"
                  Command="{Binding ListFormatting.ToggleNumbered}">
            <MenuItem.Icon>
                <Image Source="{DynamicResource listnumbersimage}" Width="16" Height="16"/>
            </MenuItem.Icon>
        </MenuItem>
        <Separator/>
        <MenuItem Header="_Убрать список"
                  Command="{Binding ListFormatting.ClearLists}">
            <MenuItem.Icon>
                <Image Source="{DynamicResource normaltextimage}" Width="16" Height="16"/>
            </MenuItem.Icon>
        </MenuItem>
    </MenuItem>
</ContextMenu>
