<ContextMenu x:Class="CryptoBook.MyControls.RichTextEditorContextMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:markup="clr-namespace:CryptoBook.Markup"
             xmlns:interfaces="clr-namespace:CryptoBook.Interfaces"
             xmlns:behaviors="clr-namespace:CryptoBook.Behaviors"
             xmlns:dto="clr-namespace:CryptoBook.DTO"
             DataContext="{markup:ResolveViewModel ViewModelType={x:Type interfaces:IRichTextContextMenuViewModel}}"
             Background="{DynamicResource CurrentControlBackground}"
             Foreground="{DynamicResource CurrentInputForeground}"
             BorderBrush="{DynamicResource CurrentBorderColor}"
             BorderThickness="1"
             Padding="4"
             MinWidth="245"
             HasDropShadow="False">
    <ContextMenu.Template>
        <ControlTemplate TargetType="{x:Type ContextMenu}">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
                <ScrollViewer CanContentScroll="True"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                </ScrollViewer>
            </Border>
        </ControlTemplate>
    </ContextMenu.Template>
    <ContextMenu.Resources>
        <ControlTemplate x:Key="RichTextMenuSeparatorTemplate"
                         TargetType="{x:Type MenuItem}">
            <Grid Height="9"
                  Background="{DynamicResource CurrentControlBackground}">
                <Border Height="1"
                        Background="{DynamicResource CurrentBorderColor}"
                        Opacity="0.4"
                        VerticalAlignment="Center"/>
            </Grid>
        </ControlTemplate>

        <Style x:Key="ThemedMenuGlyphStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource CurrentInputForeground}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="{x:Type MenuItem}"
               BasedOn="{StaticResource ThemedMenuItemStyle}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="CommandTarget"
                    Value="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="ItemBackground"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter x:Name="IconPresenter"
                                                  ContentSource="Icon"
                                                  Width="16"
                                                  Height="16"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                <Path x:Name="CheckMark"
                                      Data="M 1 5 L 4 8 L 10 1"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.5"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1"
                                                  Margin="8,0,12,0"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Margin="8,0"
                                           Text="{TemplateBinding InputGestureText}"
                                           Foreground="{TemplateBinding Foreground}"
                                           Opacity="0.72"
                                           VerticalAlignment="Center"/>
                                <Path x:Name="SubmenuArrow"
                                      Grid.Column="3"
                                      Data="M 0 0 L 4 4 L 0 8 Z"
                                      Fill="{TemplateBinding Foreground}"
                                      Width="4"
                                      Height="8"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>

                                <Popup x:Name="PART_Popup"
                                       Placement="Right"
                                       HorizontalOffset="-1"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Fade"
                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border MinWidth="210"
                                            Padding="4"
                                            Background="{DynamicResource CurrentControlBackground}"
                                            BorderBrush="{DynamicResource CurrentBorderColor}"
                                            BorderThickness="1"
                                            SnapsToDevicePixels="True">
                                        <ScrollViewer CanContentScroll="True"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="SubmenuItem">
                                <Setter TargetName="SubmenuArrow"
                                        Property="Visibility"
                                        Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="SubmenuArrow"
                                        Property="Visibility"
                                        Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="IconPresenter"
                                        Property="Visibility"
                                        Value="Collapsed"/>
                                <Setter TargetName="CheckMark"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ContextMenu.Resources>

    <MenuItem Header="{Binding [Common.Undo], Source={StaticResource Res}}" Command="ApplicationCommands.Undo" InputGestureText="Ctrl+Z">
        <MenuItem.Icon>
            <Rectangle Width="16" Height="16"
                       Fill="{DynamicResource CurrentInputForeground}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{DynamicResource editundoimage}"
                                Stretch="Uniform"/>
                </Rectangle.OpacityMask>
            </Rectangle>
        </MenuItem.Icon>
    </MenuItem>
    <MenuItem Header="{Binding [Common.Redo], Source={StaticResource Res}}" Command="ApplicationCommands.Redo" InputGestureText="Ctrl+Y">
        <MenuItem.Icon>
            <Rectangle Width="16" Height="16"
                       Fill="{DynamicResource CurrentInputForeground}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{DynamicResource editredoimage}"
                                Stretch="Uniform"/>
                </Rectangle.OpacityMask>
            </Rectangle>
        </MenuItem.Icon>
    </MenuItem>

    <MenuItem Height="9" MinHeight="0" Padding="0" Focusable="False"
              IsEnabled="False"
              Template="{StaticResource RichTextMenuSeparatorTemplate}"/>

    <MenuItem Header="{Binding [Common.Cut], Source={StaticResource Res}}" Command="ApplicationCommands.Cut" InputGestureText="Ctrl+X">
        <MenuItem.Icon>
            <Rectangle Width="16" Height="16"
                       Fill="{DynamicResource CurrentInputForeground}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{DynamicResource editcutimage}"
                                Stretch="Uniform"/>
                </Rectangle.OpacityMask>
            </Rectangle>
        </MenuItem.Icon>
    </MenuItem>
    <MenuItem Header="{Binding [Common.Copy], Source={StaticResource Res}}" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C">
        <MenuItem.Icon>
            <Rectangle Width="16" Height="16"
                       Fill="{DynamicResource CurrentInputForeground}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{DynamicResource editcopyimage}"
                                Stretch="Uniform"/>
                </Rectangle.OpacityMask>
            </Rectangle>
        </MenuItem.Icon>
    </MenuItem>
    <MenuItem Header="{Binding [Common.Paste], Source={StaticResource Res}}" Command="ApplicationCommands.Paste" InputGestureText="Ctrl+V">
        <MenuItem.Icon>
            <Rectangle Width="16" Height="16"
                       Fill="{DynamicResource CurrentInputForeground}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{DynamicResource editpasteimage}"
                                Stretch="Uniform"/>
                </Rectangle.OpacityMask>
            </Rectangle>
        </MenuItem.Icon>
    </MenuItem>

    <MenuItem Height="9" MinHeight="0" Padding="0" Focusable="False"
              IsEnabled="False"
              Template="{StaticResource RichTextMenuSeparatorTemplate}"/>

    <MenuItem Header="{Binding [Common.SelectAll], Source={StaticResource Res}}" Command="ApplicationCommands.SelectAll" InputGestureText="Ctrl+A">
        <MenuItem.Icon>
            <Viewbox Width="16" Height="16">
                <Path Data="M 5,1 L 1,1 L 1,5 M 9,1 L 13,1 L 13,5 M 1,9 L 1,13 L 5,13 M 13,9 L 13,13 L 9,13 M 4,4 L 10,4 L 10,10 L 4,10 Z"
                      Stroke="{DynamicResource CurrentInputForeground}"
                      StrokeThickness="1.2"/>
            </Viewbox>
        </MenuItem.Icon>
    </MenuItem>

    <MenuItem Height="9" MinHeight="0" Padding="0" Focusable="False"
              IsEnabled="False"
              Template="{StaticResource RichTextMenuSeparatorTemplate}"/>

    <MenuItem Header="{Binding [Editor.ClearDocument], Source={StaticResource Res}}" Command="{Binding ClearDocument}">
        <MenuItem.Icon>
            <TextBlock Text="A×"
                       FontSize="11"
                       Style="{StaticResource ThemedMenuGlyphStyle}"/>
        </MenuItem.Icon>
    </MenuItem>
    <MenuItem Header="{Binding [Editor.RemoveEmptyParagraphs], Source={StaticResource Res}}"
              Command="{Binding RemoveEmptyParagraphs}">
        <MenuItem.Icon>
            <TextBlock Text="¶×"
                       FontSize="11"
                       Style="{StaticResource ThemedMenuGlyphStyle}"/>
        </MenuItem.Icon>
    </MenuItem>

    <MenuItem Height="9" MinHeight="0" Padding="0" Focusable="False"
              IsEnabled="False"
              Template="{StaticResource RichTextMenuSeparatorTemplate}"/>

    <MenuItem Header="{Binding [Editor.Formatting], Source={StaticResource Res}}">
        <MenuItem.Icon>
            <TextBlock Text="A"
                       FontWeight="SemiBold"
                       Style="{StaticResource ThemedMenuGlyphStyle}"/>
        </MenuItem.Icon>
        <MenuItem Header="{Binding [Editor.Bold], Source={StaticResource Res}}"
                  Command="{Binding FontFormatting.SetFontWeightCommand}"
                  CommandParameter="{Binding Bold}"
                  InputGestureText="Ctrl+B">
            <MenuItem.Icon>
                <TextBlock Text="B"
                           FontWeight="Bold"
                           Style="{StaticResource ThemedMenuGlyphStyle}"/>
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{Binding [Editor.Italic], Source={StaticResource Res}}"
                  Command="{Binding FontFormatting.SetFontStyleCommand}"
                  CommandParameter="{Binding Italic}"
                  InputGestureText="Ctrl+I">
            <MenuItem.Icon>
                <TextBlock Text="I"
                           FontStyle="Italic"
                           Style="{StaticResource ThemedMenuGlyphStyle}"/>
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{Binding [Editor.Underline], Source={StaticResource Res}}"
                  Command="{Binding FontFormatting.SetTextDecorationCommand}"
                  CommandParameter="{Binding Underline}"
                  InputGestureText="Ctrl+U">
            <MenuItem.Icon>
                <TextBlock Text="U"
                           TextDecorations="Underline"
                           Style="{StaticResource ThemedMenuGlyphStyle}"/>
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Height="9" MinHeight="0" Padding="0" Focusable="False"
                  IsEnabled="False"
                  Template="{StaticResource RichTextMenuSeparatorTemplate}"/>
        <MenuItem Header="{Binding [Editor.ClearFormatting], Source={StaticResource Res}}"
                  Command="{Binding FontFormatting.ClearFormattingCommand}">
            <MenuItem.Icon>
                <TextBlock Text="A×"
                           FontSize="11"
                           Style="{StaticResource ThemedMenuGlyphStyle}"/>
            </MenuItem.Icon>
        </MenuItem>
    </MenuItem>

    <MenuItem Header="{Binding [Editor.Alignment], Source={StaticResource Res}}">
        <MenuItem.Icon>
            <Viewbox Width="16" Height="16">
                <Path Data="M 1,1 L 13,1 M 1,4.5 L 9,4.5 M 1,8 L 13,8 M 1,11.5 L 9,11.5"
                      Stroke="{DynamicResource CurrentInputForeground}"
                      StrokeThickness="1.4"/>
            </Viewbox>
        </MenuItem.Icon>
        <MenuItem Header="{Binding [Editor.AlignLeft], Source={StaticResource Res}}"
                  Command="{Binding TextFormatting.SetTextAlignment}"
                  CommandParameter="{x:Static TextAlignment.Left}">
            <MenuItem.Icon>
                <Viewbox Width="16" Height="16">
                    <Path Data="M 1,1 L 13,1 M 1,4.5 L 9,4.5 M 1,8 L 13,8 M 1,11.5 L 9,11.5"
                          Stroke="{DynamicResource CurrentInputForeground}"
                          StrokeThickness="1.4"/>
                </Viewbox>
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{Binding [Editor.AlignCenter], Source={StaticResource Res}}"
                  Command="{Binding TextFormatting.SetTextAlignment}"
                  CommandParameter="{x:Static TextAlignment.Center}">
            <MenuItem.Icon>
                <Viewbox Width="16" Height="16">
                    <Path Data="M 1,1 L 13,1 M 3,4.5 L 11,4.5 M 1,8 L 13,8 M 3,11.5 L 11,11.5"
                          Stroke="{DynamicResource CurrentInputForeground}"
                          StrokeThickness="1.4"/>
                </Viewbox>
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{Binding [Editor.AlignRight], Source={StaticResource Res}}"
                  Command="{Binding TextFormatting.SetTextAlignment}"
                  CommandParameter="{x:Static TextAlignment.Right}">
            <MenuItem.Icon>
                <Viewbox Width="16" Height="16">
                    <Path Data="M 1,1 L 13,1 M 5,4.5 L 13,4.5 M 1,8 L 13,8 M 5,11.5 L 13,11.5"
                          Stroke="{DynamicResource CurrentInputForeground}"
                          StrokeThickness="1.4"/>
                </Viewbox>
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{Binding [Editor.Justify], Source={StaticResource Res}}"
                  Command="{Binding TextFormatting.SetTextAlignment}"
                  CommandParameter="{x:Static TextAlignment.Justify}">
            <MenuItem.Icon>
                <Viewbox Width="16" Height="16">
                    <Path Data="M 1,1 L 13,1 M 1,4.5 L 13,4.5 M 1,8 L 13,8 M 1,11.5 L 13,11.5"
                          Stroke="{DynamicResource CurrentInputForeground}"
                          StrokeThickness="1.4"/>
                </Viewbox>
            </MenuItem.Icon>
        </MenuItem>
    </MenuItem>

    <MenuItem Header="{Binding [Editor.Image], Source={StaticResource Res}}">
        <MenuItem.Icon>
            <Viewbox Width="16" Height="16">
                <Path Data="M 1,2 L 13,2 L 13,12 L 1,12 Z M 2,10 L 5,7 L 7,9 L 10,5 L 13,9 M 4,5 A 1,1 0 1 1 4,4.9"
                      Stroke="{DynamicResource CurrentInputForeground}"
                      StrokeThickness="1.2"
                      StrokeLineJoin="Round"/>
            </Viewbox>
        </MenuItem.Icon>
        <MenuItem Header="{Binding [Editor.ImageInline], Source={StaticResource Res}}"
                  Command="{x:Static behaviors:DocumentImageResizeBehavior.SetImageLayoutCommand}"
                  CommandParameter="{x:Static dto:ImageLayoutMode.Inline}"/>
        <MenuItem Header="{Binding [Editor.ImageCenteredBlock], Source={StaticResource Res}}"
                  Command="{x:Static behaviors:DocumentImageResizeBehavior.SetImageLayoutCommand}"
                  CommandParameter="{x:Static dto:ImageLayoutMode.CenteredBlock}"/>
        <MenuItem Height="9" MinHeight="0" Padding="0" Focusable="False"
                  IsEnabled="False"
                  Template="{StaticResource RichTextMenuSeparatorTemplate}"/>
        <MenuItem Header="{Binding [Editor.ImageFloatLeft], Source={StaticResource Res}}"
                  Command="{x:Static behaviors:DocumentImageResizeBehavior.SetImageLayoutCommand}"
                  CommandParameter="{x:Static dto:ImageLayoutMode.FloatLeft}"/>
        <MenuItem Header="{Binding [Editor.ImageFloatRight], Source={StaticResource Res}}"
                  Command="{x:Static behaviors:DocumentImageResizeBehavior.SetImageLayoutCommand}"
                  CommandParameter="{x:Static dto:ImageLayoutMode.FloatRight}"/>
    </MenuItem>

    <MenuItem Header="{Binding [Editor.Lists], Source={StaticResource Res}}">
        <MenuItem.Icon>
            <Viewbox Width="16" Height="16">
                <Path Data="M 1,2 A 0.8,0.8 0 1 1 1,1.9 M 4,2 L 13,2 M 1,6 A 0.8,0.8 0 1 1 1,5.9 M 4,6 L 13,6 M 1,10 A 0.8,0.8 0 1 1 1,9.9 M 4,10 L 13,10"
                      Stroke="{DynamicResource CurrentInputForeground}"
                      StrokeThickness="1.2"/>
            </Viewbox>
        </MenuItem.Icon>
        <MenuItem Header="{Binding [Editor.BulletedList], Source={StaticResource Res}}"
                  Command="{Binding ListFormatting.ToggleBulleted}">
            <MenuItem.Icon>
                <TextBlock Text="•"
                           FontSize="18"
                           Style="{StaticResource ThemedMenuGlyphStyle}"/>
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{Binding [Editor.NumberedList], Source={StaticResource Res}}"
                  Command="{Binding ListFormatting.ToggleNumbered}">
            <MenuItem.Icon>
                <TextBlock Text="1."
                           FontSize="12"
                           Style="{StaticResource ThemedMenuGlyphStyle}"/>
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Height="9" MinHeight="0" Padding="0" Focusable="False"
                  IsEnabled="False"
                  Template="{StaticResource RichTextMenuSeparatorTemplate}"/>
        <MenuItem Header="{Binding [Editor.RemoveList], Source={StaticResource Res}}"
                  Command="{Binding ListFormatting.ClearLists}">
            <MenuItem.Icon>
                <TextBlock Text="×"
                           FontSize="16"
                           Style="{StaticResource ThemedMenuGlyphStyle}"/>
            </MenuItem.Icon>
        </MenuItem>
    </MenuItem>
</ContextMenu>
