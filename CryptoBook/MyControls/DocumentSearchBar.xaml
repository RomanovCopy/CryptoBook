<UserControl x:Class="CryptoBook.MyControls.DocumentSearchBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <Border Background="{DynamicResource CurrentControlBackground}"
            BorderBrush="{DynamicResource CurrentBorderColor}"
            BorderThickness="0,0,0,1" Padding="8">
        <WrapPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding [DocumentSearch.Find], Source={StaticResource Res}}"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="QueryInput" Width="220" MinHeight="28"
                     VerticalContentAlignment="Center"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{Binding [DocumentSearch.Find], Source={StaticResource Res}}"/>
            <CheckBox Content="Aa" IsChecked="{Binding MatchCase}"
                      ToolTip="{Binding [DocumentSearch.MatchCase], Source={StaticResource Res}}"
                      AutomationProperties.Name="{Binding [DocumentSearch.MatchCase], Source={StaticResource Res}}"
                      VerticalAlignment="Center" Margin="10,0"/>
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Content="↑" Command="{Binding Previous}" Padding="8,3" Margin="2,0"
                    ToolTip="{Binding [DocumentSearch.Previous], Source={StaticResource Res}}"
                    AutomationProperties.Name="{Binding [DocumentSearch.Previous], Source={StaticResource Res}}"/>
            <Button Content="↓" Command="{Binding Next}" Padding="8,3" Margin="2,0"
                    ToolTip="{Binding [DocumentSearch.Next], Source={StaticResource Res}}"
                    AutomationProperties.Name="{Binding [DocumentSearch.Next], Source={StaticResource Res}}"/>
            <Button Content="×" Command="{Binding Close}" Padding="8,3" Margin="8,0,0,0"
                    ToolTip="{Binding [DocumentSearch.Close], Source={StaticResource Res}}"
                    AutomationProperties.Name="{Binding [DocumentSearch.Close], Source={StaticResource Res}}"/>
        </WrapPanel>
    </Border>
</UserControl>
