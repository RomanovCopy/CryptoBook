<UserControl x:Class="CryptoBook.MyControls.AiRuntimeDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding HasInfo}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>
    </UserControl.Style>
    <Border BorderBrush="{DynamicResource CurrentBorderColor}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
        <StackPanel>
            <TextBlock Text="{Binding ModelName}" ToolTip="{Binding ModelPath}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding Stage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{DynamicResource CurrentMutedForeground}" FontSize="11" Margin="0,6,0,0"/>
            <TextBlock Text="{Binding Warnings}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11"/>
            <Expander Header="{Binding [AI.AutoDetails], Source={StaticResource Res}}" Margin="0,8,0,0">
                <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         MinHeight="80" MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         Background="{DynamicResource CurrentInputBackground}" Foreground="{DynamicResource CurrentInputForeground}"
                         AutomationProperties.Name="{Binding [AI.AutoDetails], Source={StaticResource Res}}"/>
            </Expander>
        </StackPanel>
    </Border>
</UserControl>
