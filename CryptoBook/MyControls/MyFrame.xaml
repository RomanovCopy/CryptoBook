<UserControl x:Class="CryptoBook.MyControls.MyFrame"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:interfaces="clr-namespace:CryptoBook.Interfaces"
             xmlns:pages="clr-namespace:CryptoBook.MyPages"
             xmlns:markup="clr-namespace:CryptoBook.Markup"
             xmlns:local="clr-namespace:CryptoBook.MyControls"
             mc:Ignorable="d"
             d:DataContext="{x:Type interfaces:IMyFrameViewModel}">
    <UserControl.DataContext>
        <markup:ResolveViewModel ViewModelType="{x:Type interfaces:IMyFrameViewModel}"/>
    </UserControl.DataContext>
    <Grid Background="{DynamicResource CurrentWindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- WPF Page requires Window or Frame as its visual parent. Page
             lifetime itself remains owned by PageNavigationService. -->
        <Frame Content="{Binding CurrentPage}"
               NavigationUIVisibility="Hidden"/>
        <!-- The rich-text editor has its own footer, with AI between search and zoom. -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentPage.DataContext}">
            <ContentControl.Resources>
                <DataTemplate x:Key="AssistantFooter">
                    <ToggleButton Style="{StaticResource AiAssistantToggleStyle}"
                                  DataContext="{Binding DataContext.Ai, RelativeSource={RelativeSource AncestorType=Window}}"
                                  AutomationProperties.Name="{Binding [AI.Assistant], Source={StaticResource Res}}"
                                  ToolTip="{Binding [AI.Assistant], Source={StaticResource Res}}"
                                  HorizontalAlignment="Right" Margin="24,4,24,4"/>
                </DataTemplate>
                <DataTemplate x:Key="HomeAssistantFooter">
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowEditor}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ToggleButton Style="{StaticResource AiAssistantToggleStyle}"
                                      DataContext="{Binding DataContext.Ai, RelativeSource={RelativeSource AncestorType=Window}}"
                                      HorizontalAlignment="Right" Margin="24,4,24,4"
                                      AutomationProperties.Name="{Binding [AI.Assistant], Source={StaticResource Res}}"
                                      ToolTip="{Binding [AI.Assistant], Source={StaticResource Res}}"/>
                    </Grid>
                </DataTemplate>
            </ContentControl.Resources>
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate" Value="{StaticResource AssistantFooter}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentPageKey}" Value="Home">
                            <Setter Property="ContentTemplate" Value="{StaticResource HomeAssistantFooter}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </Grid>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Loaded,UpdateSourceTrigger=PropertyChanged}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
</UserControl>
