<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../CryptoBook/CryptoBook.csproj"/></ItemGroup>
  <!-- Root-relative legacy icon URIs resolve against the hosting executable. Link the same source assets. -->
  <ItemGroup>
    <Resource Include="../../CryptoBook/Resources/Images/*.png">
      <Link>Resources/Images/%(Filename)%(Extension)</Link>
    </Resource>
  </ItemGroup>
</Project>
